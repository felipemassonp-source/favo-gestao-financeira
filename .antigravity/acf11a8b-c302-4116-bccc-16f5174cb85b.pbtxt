sName=\"security-item p-6 border border-[#472f5b]/10 bg-[#fffff0] hover:border-[#D8B36B]/50 transition-colors\">              <div className=\"w-10 h-10 mb-4 rounded-full bg-[#D8B36B]/10 flex items-center justify-center\">                <FileText className=\"w-5 h-5 text-[#D8B36B]\" />              </div>              <h4 className=\"text-sm font-serif uppercase tracking-widest text-[#472f5b] mb-2\">Garantia Contratual</h4>              <p className=\"text-xs text-[#4e653d] font-light leading-relaxed\">                Nossa atua\303\247\303\243o \303\251 formalizada juridicamente com cl\303\241usulas estritas de confidencialidade (NDA), assegurando que seus dados nunca sejam expostos.              </p>            </div>            <div className=\"security-item p-6 border border-[#472f5b]/10 bg-[#fffff0] hover:border-[#D8B36B]/50 transition-colors\">              <div className=\"w-10 h-10 mb-4 rounded-full bg-[#D8B36B]/10 flex items-center justify-center\">                <Lock className=\"w-5 h-5 text-[#D8B36B]\" />              </div>              <h4 className=\"text-sm font-serif uppercase tracking-widest text-[#472f5b] mb-2\">Acesso Restrito</h4>              <p className=\"text-xs text-[#4e653d] font-light leading-relaxed\">                Adotamos pol\303\255ticas de acesso com permiss\303\265es controladas. Apenas analistas dedicados ao seu projeto ter\303\243o vis\303\243o \303\240s suas movimenta\303\247\303\265es.              </p>            </div>          </div>        </div>      </div>    </section>  );}"
