        }
        lines {
          text: "          if (!isAnimating && currentIndex < totalPanels - 1) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            gotoPanel(currentIndex + 1, 1);"
