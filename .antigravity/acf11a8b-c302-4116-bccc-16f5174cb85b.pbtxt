  file_change {
    absolute_path_uri: "file:///src/components/FAQ.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useRef } from \"react\";\nimport { motion, AnimatePresence } from \"motion/react\";\nimport { ChevronDown } from \"lucide-react\";\nimport gsap from \"gsap\";\nimport { ScrollTrigger } from \"gsap/ScrollTrigger\";\nimport { useGSAP } from \"@gsap/react\";\n\ngsap.registerPlugin(ScrollTrigger);\n\nconst faqs = [\n  {\n    question: \"Como a Favo garante a seguran\303\247a e o sigilo das minhas informa\303\247\303\265es financeiras?\",\n    answer: \"A confidencialidade \303\251 a base do nosso neg\303\263cio. Trabalhamos com rigorosos Contratos de Confidencialidade (NDA) assinados antes de qualquer troca de dados. Toda a comunica\303\247\303\243o e acesso aos sistemas ocorrem em ambiente seguro, com permiss\303\265es restritas exclusivamente aos analistas seniores dedicados \303\240 sua conta.\"\n  },\n  {\n    question: \"Como funciona o processo de transi\303\247\303\243o do meu financeiro para a Favo?\",\n    answer: \"O processo \303\251 estruturado, guiado e sem interrup\303\247\303\265es (onboarding white-glove). Realizamos um diagn\303\263stico inicial, mapeamos seus fluxos atuais, configuramos os sistemas e assumimos a opera\303\247\303\243o de forma gradativa. Voc\303\252 n\303\243o sentir\303\241 nenhum impacto negativo no dia a dia, apenas o al\303\255vio imediato da carga burocr\303\241tica.\"\n  },\n  {\n    question: \"O que exatamente \303\251 o BPO Financeiro e como difere do meu contador?\",\n    answer: \"O BPO (Business Process Outsourcing) atua na execu\303\247\303\243o di\303\241ria do seu neg\303\263cio: emiss\303\243o de notas, concilia\303\247\303\243o banc\303\241ria, agendamentos no banco e cobran\303\247as. O contador, por outro lado, foca nas obriga\303\247\303\265es fiscais, impostos e folha de pagamento. N\303\263s organizamos a casa e entregamos tudo mastigado para a sua contabilidade, trabalhando em total sinergia.\"\n  },\n  {\n    question: \"Vou perder o controle do meu dinheiro ao terceirizar a gest\303\243o?\",\n    answer: \"Pelo contr\303\241rio, voc\303\252 ganhar\303\241 mais controle e visibilidade. A aprova\303\247\303\243o final e a autoriza\303\247\303\243o de qualquer pagamento continuam sendo exclusivamente suas (atrav\303\251s de tokens ou aprova\303\247\303\243o no seu app banc\303\241rio). N\303\263s apenas preparamos, agendamos e fornecemos os relat\303\263rios precisos para a sua tomada de decis\303\243o.\"\n  },\n  {\n    question: \"A consultoria estrat\303\251gica j\303\241 est\303\241 inclusa no servi\303\247o de BPO?\",\n    answer: \"O BPO foca na organiza\303\247\303\243o e execu\303\247\303\243o da rotina. No entanto, nossos planos podem ser formatados de maneira modular. Caso opte por incluir a Consultoria, atuamos tamb\303\251m como seu CFO virtual, analisando os dados gerados pelo BPO para otimizar custos, projetar cen\303\241rios e tra\303\247ar estrat\303\251gias de alto crescimento.\"\n  }\n];\n\nexport default function FAQ() {\n  const [openIndex, setOpenIndex] = useState<number | null>(null);\n  const containerRef = useRef<HTMLDivElement>(null);\n\n  useGSAP(() => {\n    gsap.from(\".faq-header\", {\n      scrollTrigger: {\n        trigger: containerRef.current,\n        start: \"top 85%\",\n      },\n      opacity: 0,\n      y: 20,\n      duration: 1,\n      ease: \"power3.out\"\n    });\n\n    gsap.from(\".faq-item\", {\n      scrollTrigger: {\n        trigger: containerRef.current,\n        start: \"top 80%\",\n      },\n      opacity: 0,\n      y: 20,\n      duration: 0.8,\n      stagger: 0.15,\n      ease: \"power3.out\"\n    });\n  }, { scope: containerRef });\n\n  const toggleQuestion = (index: number) => {\n    setOpenIndex(openIndex === index ? null : index);\n  };\n\n  return (\n    <section ref={containerRef} className=\"py-24 border-t border-[#472f5b]/10 bg-[#fffff0]\">\n      <div className=\"max-w-7xl mx-auto px-6 flex flex-col lg:flex-row gap-16\">\n        \n        {/* FAQ Header */}\n        <div className=\"lg:w-1/3 faq-header\">\n          <div className=\"flex items-center gap-4 mb-6\">\n            <span className=\"h-[1px] w-12 bg-[#D8B36B]\"></span>\n            <span className=\"text-[10px] uppercase tracking-[0.3em] font-light text-[#D8B36B]\">Esclarecimentos</span>\n          </div>\n          <h2 className=\"text-4xl md:text-5xl font-serif font-light uppercase tracking-widest text-[#472f5b] mb-6\">\n            D\303\272vidas <br/><span className=\"italic lowercase text-[#D8B36B]\">Frequentes</span>\n          </h2>\n          <p className=\"text-[#4e653d] text-sm font-light leading-relaxed tracking-wide\">\n            Transpar\303\252ncia total desde o primeiro contato. Entenda os pilares da nossa opera\303\247\303\243o e como blindamos as suas finan\303\247as.\n          </p>\n        </div>\n\n        {/* FAQ Accordion */}\n        <div className=\"lg:w-2/3\">\n          <div className=\"border-t border-[#472f5b]/20\">\n            {faqs.map((faq, index) => {\n              const isOpen = openIndex === index;\n\n              return (\n                <div \n                  key={index} \n                  className=\"faq-item border-b border-[#472f5b]/10 overflow-hidden\"\n                >\n                  <button\n                    onClick={() => toggleQuestion(index)}\n                    className=\"w-full py-6 flex items-center justify-between text-left focus:outline-none group\"\n                  >\n                    <h3 className={`text-sm md:text-base font-serif uppercase tracking-widest pr-8 transition-colors duration-300 ${isOpen ? \'text-[#D8B36B]\' : \'text-[#472f5b] group-hover:text-[#D8B36B]\'}`}>\n                      {faq.question}\n                    </h3>\n                    <motion.div\n                      animate={{ rotate: isOpen ? 180 : 0 }}\n                      transition={{ duration: 0.3, ease: \"easeInOut\" }}\n                      className={`flex-shrink-0 w-8 h-8 rounded-full border flex items-center justify-center transition-colors duration-300 ${isOpen ? \'border-[#D8B36B] text-[#D8B36B]\' : \'border-[#472f5b]/20 text-[#472f5b] group-hover:border-[#D8B36B] group-hover:text-[#D8B36B]\'}`}\n                    >\n                      <ChevronDown className=\"w-4 h-4\" />\n                    </motion.div>\n                  </button>\n\n                  <AnimatePresence>\n                    {isOpen && (\n                      <motion.div\n                        initial={{ height: 0, opacity: 0 }}\n                        animate={{ height: \"auto\", opacity: 1 }}\n                        exit={{ height: 0, opacity: 0 }}\n                        transition={{ duration: 0.4, ease: [0.22, 1, 0.36, 1] }}\n                      >\n                        <div className=\"pb-8 pr-12 text-sm font-light text-[#4e653d] leading-relaxed tracking-wide\">\n                          {faq.answer}\n                        </div>\n                      </motion.div>\n                    )}\n                  </AnimatePresence>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n\n      </div>\n    </section>\n  );\n}\n"
    }
