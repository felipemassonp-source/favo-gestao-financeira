ap-4\">                <button                   type=\"button\"                  onClick={handlePrev}                  className=\"px-6 py-4 border border-[#472f5b]/20 text-[#472f5b] hover:bg-[#472f5b]/5 transition-colors flex items-center justify-center\"                >                  <ChevronLeft className=\"w-4 h-4\" />                </button>                <button                   type=\"submit\"                  disabled={!formData.dorPrincipal || !formData.volumeOuControle}                  className=\"flex-1 flex items-center justify-center gap-4 bg-[#D8B36B] text-[#472f5b] py-4 text-xs uppercase tracking-[0.2em] font-medium hover:bg-[#c2a160] transition-colors disabled:opacity-50 disabled:cursor-not-allowed\"                >                  Enviar Avalia\303\247\303\243o                </button>              </div>            </form>          )}          {step === 3 && (            <div className=\"h-full flex flex-col items-center justify-center text-center space-y-6 animate-in zoom-in-95 duration-500 py-10\">              <div className=\"w-20 h-20 bg-[#D8B36B]/10 rounded-full flex items-center justify-center mb-4\">                <CheckCircle2 className=\"w-10 h-10 text-[#D8B36B]\" />              </div>              <h4 className=\"text-3xl font-serif font-light text-[#472f5b]\">An\303\241lise Recebida!</h4>                            {type === \"consultoria\" && getClassification() && (                <div className=\"bg-[#472f5b]/5 border border-[#472f5b]/10 p-6 w-full max-w-md my-4\">                   <span className=\"text-[#D8B36B] text-[10px] uppercase tracking-[0.2em] font-medium block mb-3\">                     Diagn\303\263stico Preliminar                   </span>                   <h5 className=\"text-lg font-serif text-[#472f5b] mb-2 uppercase tracking-widest\">{getClassification()?.tag}</h5>                   <p className=\"text-xs font-normal text-[#2a3a1e] leading-relaxed\">                     {getClassification()?.desc}     