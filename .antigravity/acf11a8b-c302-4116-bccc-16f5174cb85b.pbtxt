      replacement_content: "import { useRef } from \"react\";\nimport gsap from \"gsap\";\nimport { ScrollTrigger } from \"gsap/ScrollTrigger\";\nimport { Observer } from \"gsap/Observer\";\nimport { useGSAP } from \"@gsap/react\";\nimport SplitType from \"split-type\";\nimport { ArrowRight, TrendingUp, ShieldCheck, Target } from \"lucide-react\";\nimport { Link } from \"react-router-dom\";\n\ngsap.registerPlugin(ScrollTrigger, Observer);\n\nexport default function Home() {\n  const container = useRef<HTMLDivElement>(null);\n  const heroTextRef = useRef<HTMLHeadingElement>(null);\n  const observerSectionRef = useRef<HTMLDivElement>(null);\n  \n  useGSAP(() => {\n    // 1. Split Text Animation (replaces GSAP SplitText)\n    if (heroTextRef.current) {\n      const text = new SplitType(heroTextRef.current, { types: \'lines,words,chars\' });\n      \n      gsap.from(text.chars, {\n        opacity: 0,\n        y: 50,\n        rotateX: -90,\n        stagger: 0.02,\n        duration: 1,\n        ease: \"back.out(1.7)\",\n        delay: 0.5,\n      });\n\n      gsap.from(\".hero-sub\", {\n        opacity: 0,\n        y: 20,\n        duration: 1,\n        delay: 1.2,\n      });\n      \n      gsap.from(\".hero-cta\", {\n        opacity: 0,\n        scale: 0.9,\n        duration: 1,\n        delay: 1.5,\n        ease: \"expo.out\"\n      });\n    }\n\n    // 2. ScrollTrigger for services section\n    const serviceCards = gsap.utils.toArray(\'.service-card\');\n    serviceCards.forEach((card: any, i) => {\n      gsap.from(card, {\n        scrollTrigger: {\n          trigger: card,\n          start: \"top 85%\",\n          toggleActions: \"play none none reverse\",\n        },\n        opacity: 0,\n        y: 50,\n        duration: 0.8,\n        delay: i * 0.2,\n      });\n    });\n\n    // 3. Observer API Interactive Data Section\n    // Instead of normal scroll, we listen to swipe/wheel events to toggle data panels\n    let currentIndex = 0;\n    const panels = gsap.utils.toArray(\'.data-panel\');\n    const totalPanels = panels.length;\n    let isAnimating = false;\n\n    // Set initial state\n    gsap.set(panels, { zIndex: (i) => totalPanels - i });\n    \n    function gotoPanel(index: number, direction: number) {\n      if (isAnimating) return;\n      isAnimating = true;\n\n      const currentPanel = panels[currentIndex] as HTMLElement;\n      const nextPanel = panels[index] as HTMLElement;\n\n      gsap.to(currentPanel, {\n        yPercent: direction === 1 ? -100 : 100,\n        opacity: 0,\n        duration: 0.8,\n        ease: \"power2.inOut\",\n      });\n\n      gsap.fromTo(nextPanel, \n        { yPercent: direction === 1 ? 100 : -100, opacity: 0 },\n        {\n          yPercent: 0,\n          opacity: 1,\n          duration: 0.8,\n          ease: \"power2.inOut\",\n          onComplete: () => {\n            isAnimating = false;\n          }\n        }\n      );\n      \n      currentIndex = index;\n    }\n\n    if (observerSectionRef.current) {\n      Observer.create({\n        target: observerSectionRef.current,\n        type: \"wheel,touch,pointer\",\n        wheelSpeed: -1,\n        onDown: () => {\n          if (!isAnimating && currentIndex > 0) {\n            gotoPanel(currentIndex - 1, -1);\n          }\n        },\n        onUp: () => {\n          if (!isAnimating && currentIndex < totalPanels - 1) {\n            gotoPanel(currentIndex + 1, 1);\n          }\n        },\n        tolerance: 10,\n        preventDefault: true\n      });\n    }\n\n  }, { scope: container });\n\n  return (\n    <div ref={container} className=\"w-full\">\n      {/* Hero Section */}\n      <section className=\"relative h-screen flex flex-col justify-center px-6 max-w-7xl mx-auto\">\n        <div className=\"absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-amber-900/20 via-slate-950 to-slate-950\"></div>\n        <h1 \n          ref={heroTextRef} \n          className=\"text-5xl md:text-7xl lg:text-8xl font-bold tracking-tighter leading-[1.1] max-w-4xl\"\n          style={{ perspective: \"1000px\" }}\n        >\n          Intelig\303\252ncia Financeira para <span className=\"text-amber-500\">Resultados Exatos.</span>\n        </h1>\n        <p className=\"hero-sub mt-8 text-xl text-slate-400 max-w-2xl leading-relaxed\">\n          Transformamos dados complexos em estrat\303\251gias claras. Consultoria especializada para empresas que buscam crescimento sustent\303\241vel e m\303\241xima rentabilidade.\n        </p>\n        <div className=\"hero-cta mt-12 flex gap-4\">\n          <Link to=\"/consultoria\" className=\"px-8 py-4 rounded-full bg-amber-500 text-slate-950 font-bold hover:bg-amber-400 transition-colors flex items-center gap-2 group\">\n            Conhe\303\247a a Consultoria\n            <ArrowRight className=\"w-5 h-5 group-hover:translate-x-1 transition-transform\" />\n          </Link>\n        </div>\n      </section>\n\n      {/* Interactive Observer Data Section */}\n      <section className=\"h-screen w-full relative bg-slate-900 overflow-hidden flex items-center justify-center\">\n        <div className=\"absolute top-12 text-center w-full z-10 text-slate-400 uppercase tracking-widest text-sm font-semibold\">\n          Deslize para Analisar (Observer API)\n        </div>\n        \n        <div ref={observerSectionRef} className=\"relative w-full max-w-5xl h-[60vh] mx-auto cursor-ns-resize\">\n          {/* Panel 1 */}\n          <div className=\"data-panel absolute inset-0 bg-slate-800 rounded-3xl p-12 border border-slate-700 shadow-2xl flex flex-col justify-center opacity-100\">\n            <TrendingUp className=\"w-16 h-16 text-amber-500 mb-6\" />\n            <h2 className=\"text-4xl font-bold mb-4\">An\303\241lise de Performance</h2>\n            <p className=\"text-xl text-slate-400\">Identificamos gargalos e oportunidades invis\303\255veis nos seus relat\303\263rios financeiros para maximizar a sua margem de lucro.</p>\n          </div>\n          {/* Panel 2 */}\n          <div className=\"data-panel absolute inset-0 bg-slate-800 rounded-3xl p-12 border border-slate-700 shadow-2xl flex flex-col justify-center opacity-0\">\n            <ShieldCheck className=\"w-16 h-16 text-emerald-500 mb-6\" />\n            <h2 className=\"text-4xl font-bold mb-4\">Gest\303\243o de Riscos</h2>\n            <p className=\"text-xl text-slate-400\">Proteja o caixa da sua empresa com estrat\303\251gias preditivas e modelagem financeira de alta precis\303\243o contra oscila\303\247\303\265es do mercado.</p>\n          </div>\n          {/* Panel 3 */}\n          <div className=\"data-panel absolute inset-0 bg-slate-800 rounded-3xl p-12 border border-slate-700 shadow-2xl flex flex-col justify-center opacity-0\">\n            <Target className=\"w-16 h-16 text-blue-500 mb-6\" />\n            <h2 className=\"text-4xl font-bold mb-4\">Planejamento Estrat\303\251gico</h2>\n            <p className=\"text-xl text-slate-400\">Tra\303\247amos metas financeiras claras e vi\303\241veis, com acompanhamento de KPIs em tempo real para garantir o alcance dos seus objetivos.</p>\n          </div>\n        </div>\n      </section>\n\n      {/* Services Section with ScrollTrigger */}\n      <section className=\"py-32 px-6 max-w-7xl mx-auto\">\n        <div className=\"mb-20\">\n          <h2 className=\"text-sm text-amber-500 font-bold tracking-widest uppercase mb-4\">Nossa Expertise</h2>\n          <h3 className=\"text-4xl md:text-5xl font-bold tracking-tighter\">Solu\303\247\303\265es Corporativas</h3>\n        </div>\n        \n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n          <div className=\"service-card p-10 bg-slate-900/50 rounded-2xl border border-slate-800 hover:border-amber-500/50 transition-colors\">\n            <h4 className=\"text-2xl font-bold mb-4 text-white\">BPO Financeiro</h4>\n            <p className=\"text-slate-400 leading-relaxed\">\n              Terceiriza\303\247\303\243o completa da gest\303\243o financeira. Foque no core business enquanto cuidamos do contas a pagar, receber, fluxo de caixa e concilia\303\247\303\243o banc\303\241ria.\n            </p>\n          </div>\n          <div className=\"service-card p-10 bg-slate-900/50 rounded-2xl border border-slate-800 hover:border-amber-500/50 transition-colors\">\n            <h4 className=\"text-2xl font-bold mb-4 text-white\">Valuation</h4>\n            <p className=\"text-slate-400 leading-relaxed\">\n              Avalia\303\247\303\243o precisa do valor de mercado da sua empresa para fus\303\265es, aquisi\303\247\303\265es, capta\303\247\303\243o de recursos ou planejamento sucess\303\263rio.\n            </p>\n          </div>\n          <div className=\"service-card p-10 bg-slate-900/50 rounded-2xl border border-slate-800 hover:border-amber-500/50 transition-colors\">\n            <h4 className=\"text-2xl font-bold mb-4 text-white\">Reestrutura\303\247\303\243o</h4>\n            <p className=\"text-slate-400 leading-relaxed\">\n              Planos de recupera\303\247\303\243o financeira e renegocia\303\247\303\243o de passivos. Trazemos f\303\264lego para empresas em momentos de transi\303\247\303\243o ou crise.\n            </p>\n          </div>\n          <div className=\"service-card p-10 bg-slate-900/50 rounded-2xl border border-slate-800 hover:border-amber-500/50 transition-colors\">\n            <h4 className=\"text-2xl font-bold mb-4 text-white\">M&A (Fus\303\265es e Aquisi\303\247\303\265es)</h4>\n            <p className=\"text-slate-400 leading-relaxed\">\n              Assessoria ponta a ponta na compra e venda de empresas. Do mapeamento de mercado ao fechamento estrat\303\251gico da opera\303\247\303\243o.\n            </p>\n          </div>\n        </div>\n      </section>\n    </div>\n  );\n}"
    }
