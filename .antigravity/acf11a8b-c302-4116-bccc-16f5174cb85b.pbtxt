    instruction: "Refactor the GSAP ScrollTrigger for the Problem panels. Put the ref directly on the section, use a timeline to animate yPercent from 100 to 0, and ensure pinSpacing works correctly."
    replacement_infos {
      original_chunk {
        target_content: "    // 3. Scroll-Driven Interactive Data Section (Pain Points)\n    const panels = gsap.utils.toArray(\'.data-panel\');\n    \n    // Ensure correct z-index stacking so newer panels slide OVER older ones\n    gsap.set(panels, { zIndex: (i) => i });\n    \n    if (observerSectionRef.current) {\n      const sectionElement = observerSectionRef.current.parentElement;\n      \n      const tl = gsap.timeline({\n        scrollTrigger: {\n          trigger: sectionElement,\n          start: \"top top\",\n          end: \"+=200%\", // 2x height of the section for scrolling through 3 panels\n          pin: true,\n          scrub: 1,\n        }\n      });\n\n      panels.forEach((panel, i) => {\n        if (i === 0) return; // Skip first panel\n        \n        tl.fromTo(panel, \n          { yPercent: 100, opacity: 1 }, // ensure opacity is 1 so it\'s visible when sliding up\n          { yPercent: 0, opacity: 1, ease: \"none\", duration: 1 }\n        );\n      });\n    }"
        replacement_content: "    // 3. Scroll-Driven Interactive Data Section (Pain Points)\n    if (observerSectionRef.current) {\n      const sectionElement = observerSectionRef.current;\n      const panels = gsap.utils.toArray(\'.data-panel\', sectionElement) as HTMLElement[];\n      \n      // Ensure correct z-index stacking so newer panels slide OVER older ones\n      gsap.set(panels, { zIndex: (i) => i });\n      \n      const tl = gsap.timeline({\n        scrollTrigger: {\n          trigger: sectionElement,\n          start: \"top top\",\n          end: \"+=200%\", // Scroll distance equivalent to 2 screen heights\n          pin: true,\n          scrub: 1,\n          pinSpacing: true, // Ensure it pushes the rest of the content down\n        }\n      });\n\n      panels.forEach((panel, i) => {\n        if (i === 0) return; // Skip first panel, it stays in place\n        \n        // Start panel pushed down\n        gsap.set(panel, { yPercent: 100 });\n        \n        // Animate up to 0%\n        tl.to(panel, {\n          yPercent: 0,\n          ease: \"none\",\n          duration: 1\n        });\n      });\n    }"
      }
      num_matches: 1
    }
  }
