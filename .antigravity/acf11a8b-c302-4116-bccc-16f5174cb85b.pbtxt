      replacement_content: "  useGSAP(() => {\n    // Split Text animation for title\n    if (titleRef.current) {\n      const text = new SplitType(titleRef.current, { types: \'lines,words,chars\' });\n      \n      text.lines?.forEach((line) => {\n        const wrapper = document.createElement(\'div\');\n        wrapper.style.overflow = \'hidden\';\n        line.parentNode?.insertBefore(wrapper, line);\n        wrapper.appendChild(line);\n      });\n\n      gsap.fromTo(\".subtitle\", \n        { opacity: 0, y: 30 },\n        { opacity: 1, y: 0, duration: 1.5, ease: \"power3.out\", delay: 1.2 }\n      );\n\n      gsap.from(text.chars, {\n        opacity: 0,\n        y: \"100%\",\n        rotationZ: 2,\n        stagger: 0.02,\n        duration: 1.4,\n        ease: \"power4.out\",\n        delay: 0.2\n      });\n    }\n\n    // High-end section title animations\n    const sectionTitles = gsap.utils.toArray(\'.section-title\');\n    sectionTitles.forEach((title: any) => {\n      const splitTitle = new SplitType(title, { types: \'lines,words\' });\n      \n      splitTitle.lines?.forEach((line) => {\n        const wrapper = document.createElement(\'div\');\n        wrapper.style.overflow = \'hidden\';\n        line.parentNode?.insertBefore(wrapper, line);\n        wrapper.appendChild(line);\n      });\n\n      gsap.from(splitTitle.words, {\n        scrollTrigger: {\n          trigger: title,\n          start: \"top 85%\",\n        },\n        y: \"100%\",\n        opacity: 0,\n        duration: 1.2,\n        stagger: 0.05,\n        ease: \"power4.out\"\n      });\n    });\n\n    // Pinned section animation\n    ScrollTrigger.create({\n      trigger: \".pin-section\",\n      start: \"top top\",\n      end: \"+=100%\",\n      pin: true,\n      pinSpacing: true,\n    });\n\n    const items = gsap.utils.toArray(\'.process-item\');\n    items.forEach((item: any, i) => {\n      gsap.from(item, {\n        scrollTrigger: {\n          trigger: item,\n          start: \"top 80%\",\n        },\n        opacity: 0,\n        y: 30,\n        duration: 1,\n        ease: \"power3.out\",\n        delay: i * 0.1,\n      });\n    });\n\n  }, { scope: container });"
