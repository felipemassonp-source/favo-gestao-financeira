          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    question: \"O que exatamente \303\251 o BPO Financeiro e como difere do meu contador?\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    answer: \"O BPO (Business Process Outsourcing) atua na execu\303\247\303\243o di\303\241ria do seu neg\303\263cio: emiss\303\243o de notas, concilia\303\247\303\243o banc\303\241ria, agendamentos no banco e cobran\303\247as. O contador, por outro lado, foca nas obriga\303\247\303\265es fiscais, impostos e folha de pagamento. N\303\263s organizamos a casa e entregamos tudo mastigado para a sua contabilidade, trabalhando em total sinergia.\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
