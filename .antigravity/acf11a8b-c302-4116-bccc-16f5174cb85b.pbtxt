        target_content: "const steps = [\n  {\n    title: \"O Raio-X Simples\",\n    description: \"Em uma conversa amig\303\241vel e sem jarg\303\265es, entendemos de onde o dinheiro da sua empresa vem e para onde vai. Nada de planilhas chatas, n\303\263s fazemos o levantamento inicial.\"\n  },\n  {\n    title: \"A Regra de Ouro\",\n    description: \"Organizamos a casa separando o que \303\251 seu e o que \303\251 da empresa. Definimos o seu pr\303\263-labore (seu sal\303\241rio) de forma segura, com base no que o neg\303\263cio realmente pode pagar.\"\n  },\n  {\n    title: \"Ferramentas & Automa\303\247\303\243o\",\n    description: \"Implementamos sistemas visuais e f\303\241ceis de usar. O b\303\241sico bem feito com a tecnologia certa. Aquela burocracia que levava horas, agora toma apenas alguns minutos.\"\n  },\n  {\n    title: \"Lucro Claro e Estrat\303\251gia\",\n    description: \"Pronto! Voc\303\252 ganha tempo para focar em atender seus clientes, enquanto mostramos o seu lucro crescendo atrav\303\251s de an\303\241lises did\303\241ticas e super f\303\241ceis de entender.\"\n  }\n];"
        replacement_content: "const steps = [\n  {\n    title: \"1\302\272 Encontro\",\n    description: \"Identifica\303\247\303\243o de gargalos e melhorias a serem aplicadas. Vamos entender a fundo o seu cen\303\241rio atual.\"\n  },\n  {\n    title: \"2\302\272 Encontro\",\n    description: \"Apontamento de estrat\303\251gias e mapeamento de processos. Estruturamos o plano de a\303\247\303\243o ideal para voc\303\252.\"\n  },\n  {\n    title: \"3\302\272 Encontro\",\n    description: \"Aplica\303\247\303\243o das estrat\303\251gias e ferramentas que podem auxiliar na sua rotina para ganhar produtividade.\"\n  },\n  {\n    title: \"4\302\272 Encontro\",\n    description: \"Revis\303\243o do que j\303\241 foi aplicado e aux\303\255lio direto nos pontos que ainda s\303\243o travas no seu dia a dia.\"\n  }\n];"
      }
