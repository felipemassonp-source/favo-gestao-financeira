  file_change {
    absolute_path_uri: "file:///src/components/LeadCaptureForm.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useState } from \"react\";\nimport { ArrowRight, CheckCircle2, ChevronLeft } from \"lucide-react\";\nimport { cn } from \"../lib/utils\";\n\ntype FormType = \"bpo\" | \"consultoria\";\n\ninterface LeadCaptureFormProps {\n  type: FormType;\n}\n\nexport default function LeadCaptureForm({ type }: LeadCaptureFormProps) {\n  const [step, setStep] = useState(1);\n  const [formData, setFormData] = useState({\n    nome: \"\",\n    whatsapp: \"\",\n    email: \"\",\n    empresa: \"\",\n    dorPrincipal: \"\",\n    volumeOuControle: \"\",\n  });\n\n  const handleNext = () => setStep(2);\n  const handlePrev = () => setStep(1);\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    // Aqui seria a integra\303\247\303\243o real (Webhook, RD Station, ActiveCampaign, etc)\n    setStep(3);\n  };\n\n  const bpoQuestions = {\n    q1: {\n      label: \"Qual a sua maior dificuldade com o financeiro hoje?\",\n      options: [\n        \"Falta de tempo para a rotina di\303\241ria\",\n        \"Mistura de contas Pessoais e da Empresa\",\n        \"Alto \303\255ndice de Inadimpl\303\252ncia\",\n        \"N\303\243o consigo visualizar meu lucro\",\n      ],\n      field: \"dorPrincipal\"\n    },\n    q2: {\n      label: \"Qual o volume m\303\251dio de movimenta\303\247\303\265es mensais?\",\n      options: [\n        \"At\303\251 50 movimenta\303\247\303\265es\",\n        \"De 51 a 150 movimenta\303\247\303\265es\",\n        \"Mais de 150 movimenta\303\247\303\265es\",\n        \"Ainda n\303\243o sei estimar\",\n      ],\n      field: \"volumeOuControle\"\n    }\n  };\n\n  const consultoriaQuestions = {\n    q1: {\n      label: \"Qual o seu principal objetivo com a consultoria?\",\n      options: [\n        \"Organizar as finan\303\247as do zero\",\n        \"Melhorar minha precifica\303\247\303\243o\",\n        \"Planejar o crescimento da empresa\",\n        \"Socorro financeiro (Sair do vermelho)\",\n      ],\n      field: \"dorPrincipal\"\n    },\n    q2: {\n      label: \"Como voc\303\252 controla o financeiro atualmente?\",\n      options: [\n        \"Planilhas (Excel/Google Sheets)\",\n        \"Caderno de anota\303\247\303\265es\",\n        \"Sistema financeiro / ERP\",\n        \"Ainda n\303\243o controlo\",\n      ],\n      field: \"volumeOuControle\"\n    }\n  };\n\n  const questions = type === \"bpo\" ? bpoQuestions : consultoriaQuestions;\n\n  return (\n    <div className=\"w-full max-w-4xl mx-auto bg-[#FFFFFF] border border-[#472f5b]/10 shadow-2xl relative overflow-hidden\" id=\"formulario\">\n      <div className=\"flex flex-col md:flex-row h-full\">\n        \n        {/* Left Side - Context */}\n        <div className=\"w-full md:w-5/12 bg-[#472f5b] p-10 md:p-12 flex flex-col justify-between text-[#fffff0] relative overflow-hidden\">\n          <div className=\"relative z-10\">\n            <span className=\"text-[#D8B36B] text-[10px] uppercase tracking-[0.3em] mb-6 block\">\n              Passo {step} de 2\n            </span>\n            <h3 className=\"text-3xl font-serif font-light leading-tight mb-4\">\n              {step === 1 ? \"Vamos iniciar o seu diagn\303\263stico.\" : step === 2 ? \"Entendendo o seu cen\303\241rio.\" : \"Tudo certo!\"}\n            </h3>\n            <p className=\"text-sm font-light text-[#fffff0]/80 leading-relaxed tracking-wide\">\n              {type === \"bpo\" \n                ? \"Queremos entender exatamente como a Favo pode assumir sua rotina financeira e devolver o seu tempo.\"\n                : \"Para desenharmos o melhor plano de a\303\247\303\243o, precisamos entender o momento atual da sua empresa.\"}\n            </p>\n          </div>\n          \n          {/* Decorative Pattern */}\n          <div className=\"absolute -bottom-24 -left-24 w-64 h-64 border border-[#D8B36B]/20 rounded-full opacity-50\"></div>\n          <div className=\"absolute -bottom-12 -left-12 w-48 h-48 border border-[#D8B36B]/20 rounded-full opacity-50\"></div>\n        </div>\n\n        {/* Right Side - Form */}\n        <div className=\"w-full md:w-7/12 p-10 md:p-12 bg-[#FFFFFF]\">\n          {step === 1 && (\n            <form onSubmit={(e) => { e.preventDefault(); handleNext(); }} className=\"space-y-6 animate-in fade-in slide-in-from-right-4 duration-500\">\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n                <div className=\"space-y-2\">\n                  <label className=\"text-xs uppercase tracking-widest font-light text-[#472f5b]\">Nome Completo</label>\n                  <input \n                    required\n                    type=\"text\"\n                    value={formData.nome}\n                    onChange={(e) => setFormData({...formData, nome: e.target.value})}\n                    className=\"w-full bg-transparent border-b border-[#472f5b]/20 py-3 text-sm text-[#472f5b] focus:outline-none focus:border-[#D8B36B] transition-colors\"\n                    placeholder=\"Seu nome\"\n                  />\n                </div>\n                <div className=\"space-y-2\">\n                  <label className=\"text-xs uppercase tracking-widest font-light text-[#472f5b]\">WhatsApp</label>\n                  <input \n                    required\n                    type=\"tel\"\n                    value={formData.whatsapp}\n                    onChange={(e) => setFormData({...formData, whatsapp: e.target.value})}\n                    className=\"w-full bg-transparent border-b border-[#472f5b]/20 py-3 text-sm text-[#472f5b] focus:outline-none focus:border-[#D8B36B] transition-colors\"\n                    placeholder=\"(00) 00000-0000\"\n                  />\n                </div>\n              </div>\n\n              <div className=\"space-y-2\">\n                <label className=\"text-xs uppercase tracking-widest font-light text-[#472f5b]\">E-mail Profissional</label>\n                <input \n                  required\n                  type=\"email\"\n                  value={formData.email}\n                  onChange={(e) => setFormData({...formData, email: e.target.value})}\n                  className=\"w-full bg-transparent border-b border-[#472f5b]/20 py-3 text-sm text-[#472f5b] focus:outline-none focus:border-[#D8B36B] transition-colors\"\n                  placeholder=\"seu@email.com.br\"\n                />\n              </div>\n\n              <div className=\"space-y-2\">\n                <label className=\"text-xs uppercase tracking-widest font-light text-[#472f5b]\">Nome da Empresa</label>\n                <input \n                  required\n                  type=\"text\"\n                  value={formData.empresa}\n                  onChange={(e) => setFormData({...formData, empresa: e.target.value})}\n                  className=\"w-full bg-transparent border-b border-[#472f5b]/20 py-3 text-sm text-[#472f5b] focus:outline-none focus:border-[#D8B36B] transition-colors\"\n                  placeholder=\"Sua marca\"\n                />\n              </div>\n\n              <div className=\"pt-6\">\n                <button \n                  type=\"submit\"\n                  className=\"w-full flex items-center justify-center gap-4 bg-[#472f5b] text-[#fffff0] py-4 text-xs uppercase tracking-[0.2em] font-light hover:bg-[#4e653d] transition-colors\"\n                >\n                  Pr\303\263ximo Passo <ArrowRight className=\"w-4 h-4\" />\n                </button>\n              </div>\n            </form>\n          )}\n\n          {step === 2 && (\n            <form onSubmit={handleSubmit} className=\"space-y-8 animate-in fade-in slide-in-from-right-4 duration-500\">\n              \n              {/* Question 1 */}\n              <div className=\"space-y-4\">\n                <label className=\"text-sm font-serif tracking-wide text-[#472f5b] block\">\n                  1. {questions.q1.label}\n                </label>\n                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3\">\n                  {questions.q1.options.map((opt) => (\n                    <button\n                      type=\"button\"\n                      key={opt}\n                      onClick={() => setFormData({...formData, dorPrincipal: opt})}\n                      className={cn(\n                        \"text-left p-4 text-xs font-light tracking-wide border transition-all duration-300\",\n                        formData.dorPrincipal === opt \n                          ? \"border-[#D8B36B] bg-[#D8B36B]/5 text-[#472f5b]\" \n                          : \"border-[#472f5b]/10 text-[#4e653d] hover:border-[#472f5b]/30\"\n                      )}\n                    >\n                      {opt}\n                    </button>\n                  ))}\n                </div>\n              </div>\n\n              {/* Question 2 */}\n              <div className=\"space-y-4\">\n                <label className=\"text-sm font-serif tracking-wide text-[#472f5b] block\">\n                  2. {questions.q2.label}\n                </label>\n                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3\">\n                  {questions.q2.options.map((opt) => (\n                    <button\n                      type=\"button\"\n                      key={opt}\n                      onClick={() => setFormData({...formData, volumeOuControle: opt})}\n                      className={cn(\n                        \"text-left p-4 text-xs font-light tracking-wide border transition-all duration-300\",\n                        formData.volumeOuControle === opt \n                          ? \"border-[#D8B36B] bg-[#D8B36B]/5 text-[#472f5b]\" \n                          : \"border-[#472f5b]/10 text-[#4e653d] hover:border-[#472f5b]/30\"\n                      )}\n                    >\n                      {opt}\n                    </button>\n                  ))}\n                </div>\n              </div>\n\n              <div className=\"pt-6 flex gap-4\">\n                <button \n                  type=\"button\"\n                  onClick={handlePrev}\n                  className=\"px-6 py-4 border border-[#472f5b]/20 text-[#472f5b] hover:bg-[#472f5b]/5 transition-colors flex items-center justify-center\"\n                >\n                  <ChevronLeft className=\"w-4 h-4\" />\n                </button>\n                <button \n                  type=\"submit\"\n                  disabled={!formData.dorPrincipal || !formData.volumeOuControle}\n                  className=\"flex-1 flex items-center justify-center gap-4 bg-[#D8B36B] text-[#472f5b] py-4 text-xs uppercase tracking-[0.2em] font-medium hover:bg-[#c2a160] transition-colors disabled:opacity-50 disabled:cursor-not-allowed\"\n                >\n                  Enviar Avalia\303\247\303\243o\n                </button>\n              </div>\n            </form>\n          )}\n\n          {step === 3 && (\n            <div className=\"h-full flex flex-col items-center justify-center text-center space-y-6 animate-in zoom-in-95 duration-500 py-10\">\n              <div className=\"w-20 h-20 bg-[#D8B36B]/10 rounded-full flex items-center justify-center mb-4\">\n                <CheckCircle2 className=\"w-10 h-10 text-[#D8B36B]\" />\n              </div>\n              <h4 className=\"text-3xl font-serif font-light text-[#472f5b]\">An\303\241lise Recebida!</h4>\n              <p className=\"text-sm font-light text-[#4e653d] tracking-wide leading-relaxed max-w-sm\">\n                Nossa equipe especialista analisar\303\241 seu perfil e entrar\303\241 em contato via WhatsApp em breve.\n              </p>\n            </div>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n}\n"
    }
    diff {
