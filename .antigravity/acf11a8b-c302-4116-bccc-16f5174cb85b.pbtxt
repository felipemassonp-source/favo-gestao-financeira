    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "      {/* About Andryelle Section */}\n      <section className=\"py-40 px-6 max-w-7xl mx-auto border-t border-[#472f5b]/10 flex flex-col md:flex-row gap-16 items-center\">\n        <div className=\"flex-1\">\n          <div className=\"flex items-center gap-4 mb-6\">\n            <span className=\"h-[1px] w-12 bg-[#D8B36B]\"></span>\n            <span className=\"text-[10px] uppercase tracking-[0.3em] font-medium text-[#D8B36B]\">Quem sou eu</span>\n          </div>\n          <h3 className=\"section-title text-5xl md:text-6xl font-serif font-light tracking-widest uppercase mb-8\">\n            Andryelle<br/><span className=\"italic lowercase text-[#D8B36B]\">Niederauer</span>\n          </h3>\n          <div className=\"space-y-6 text-[#2a3a1e] font-normal text-sm tracking-wide leading-relaxed max-w-lg\">\n            <p>\n              Ol\303\241! Tudo bem? Sou a Andryelle Niederauer e trago uma bagagem s\303\263lida do mundo das finan\303\247as h\303\241 mais de 15 anos. Com forma\303\247\303\243o t\303\251cnica em administra\303\247\303\243o, experi\303\252ncia como gestora de projetos e atualmente graduanda em Gest\303\243o Financeira, sou apaixonada pelo mundo dos n\303\272meros.\n            </p>\n            <p>\n              Depois de uma jornada que inclui experi\303\252ncias em regime CLT e empreendedorismo em diferentes \303\241reas, decidi direcionar minha paix\303\243o e conhecimento para ajudar mulheres empreendedoras a crescerem seus neg\303\263cios de forma saud\303\241vel e sustent\303\241vel.\n            </p>\n            <p>\n              Acredito no poder das finan\303\247as bem geridas como pilar fundamental para o sucesso de qualquer empreendimento. Minha miss\303\243o \303\251 n\303\243o apenas oferecer servi\303\247os financeiros, mas tamb\303\251m fornecer orienta\303\247\303\243o e suporte personalizado para que cada mulher possa alcan\303\247ar seus objetivos empresariais com confian\303\247a e seguran\303\247a.\n            </p>\n          </div>\n        </div>\n        <div className=\"flex-1 w-full relative\">\n           <div className=\"aspect-[4/5] bg-[#FFFFFF] border border-[#472f5b]/10 p-4 shadow-xl relative z-10\">\n             <div className=\"w-full h-full bg-[#fffff0] flex items-center justify-center\">\n               <span className=\"font-serif italic text-3xl text-[#D8B36B]\">A.N.</span>\n             </div>\n           </div>\n           <div className=\"absolute top-8 -right-8 w-full h-full border border-[#D8B36B] -z-10\"></div>\n        </div>\n      </section>"
      replacement_content: "      {/* About Andryelle Section */}\n      <section className=\"py-40 px-6 max-w-7xl mx-auto border-t border-[#472f5b]/10\">\n        <FadeInUp className=\"flex flex-col md:flex-row gap-16 items-center\">\n          <div className=\"flex-1\">\n            <div className=\"flex items-center gap-4 mb-6\">\n              <span className=\"h-[1px] w-12 bg-[#D8B36B]\"></span>\n              <span className=\"text-[10px] uppercase tracking-[0.3em] font-medium text-[#D8B36B]\">Quem sou eu</span>\n            </div>\n            <h3 className=\"section-title text-5xl md:text-6xl font-serif font-light tracking-widest uppercase mb-8\">\n              Andryelle<br/><span className=\"italic lowercase text-[#D8B36B]\">Niederauer</span>\n            </h3>\n            <div className=\"space-y-6 text-[#2a3a1e] font-normal text-sm tracking-wide leading-relaxed max-w-lg\">\n              <p>\n                Ol\303\241! Tudo bem? Sou a Andryelle Niederauer e trago uma bagagem s\303\263lida do mundo das finan\303\247as h\303\241 mais de 15 anos. Com forma\303\247\303\243o t\303\251cnica em administra\303\247\303\243o, experi\303\252ncia como gestora de projetos e atualmente graduanda em Gest\303\243o Financeira, sou apaixonada pelo mundo dos n\303\272meros.\n              </p>\n              <p>\n                Depois de uma jornada que inclui experi\303\252ncias em regime CLT e empreendedorismo em diferentes \303\241reas, decidi direcionar minha paix\303\243o e conhecimento para ajudar mulheres empreendedoras a crescerem seus neg\303\263cios de forma saud\303\241vel e sustent\303\241vel.\n              </p>\n              <p>\n                Acredito no poder das finan\303\247as bem geridas como pilar fundamental para o sucesso de qualquer empreendimento. Minha miss\303\243o \303\251 n\303\243o apenas oferecer servi\303\247os financeiros, mas tamb\303\251m fornecer orienta\303\247\303\243o e suporte personalizado para que cada mulher possa alcan\303\247ar seus objetivos empresariais com confian\303\247a e seguran\303\247a.\n              </p>\n            </div>\n          </div>\n          <div className=\"flex-1 w-full relative\">\n             <div className=\"aspect-[4/5] bg-[#FFFFFF] border border-[#472f5b]/10 p-4 shadow-xl relative z-10\">\n               <div className=\"w-full h-full bg-[#fffff0] flex items-center justify-center\">\n                 <span className=\"font-serif italic text-3xl text-[#D8B36B]\">A.N.</span>\n               </div>\n             </div>\n             <div className=\"absolute top-8 -right-8 w-full h-full border border-[#D8B36B] -z-10\"></div>\n          </div>\n        </FadeInUp>\n      </section>"
    }
    instruction: "Add FadeInUp wrapper around About Andryelle section"
  }
}
