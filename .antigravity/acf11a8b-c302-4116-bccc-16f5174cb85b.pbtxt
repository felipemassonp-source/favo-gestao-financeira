        }
        lines {
          text: "        <div className=\"absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-[#FFFFFF] via-[#F7F6EE] to-[#F7F6EE] -z-10\"></div>"
