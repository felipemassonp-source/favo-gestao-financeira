  file_change {
    absolute_path_uri: "file:///src/components/OnboardingJourney.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useRef } from \"react\";\nimport gsap from \"gsap\";\nimport { ScrollTrigger } from \"gsap/ScrollTrigger\";\nimport { useGSAP } from \"@gsap/react\";\nimport { Calendar, ShieldCheck, Settings2, Rocket } from \"lucide-react\";\nimport { cn } from \"../lib/utils\";\n\ngsap.registerPlugin(ScrollTrigger);\n\nconst steps = [\n  {\n    icon: Calendar,\n    title: \"Alinhamento\",\n    desc: \"Reuni\303\243o de 30 minutos para entendermos seu fluxo de caixa e rotinas.\"\n  },\n  {\n    icon: ShieldCheck,\n    title: \"Acessos Seguros\",\n    desc: \"Coleta organizada de senhas secund\303\241rias e documentos banc\303\241rios.\"\n  },\n  {\n    icon: Settings2,\n    title: \"Setup do Sistema\",\n    desc: \"Nossa equipe parametriza tudo. Voc\303\252 n\303\243o precisa configurar nada.\"\n  },\n  {\n    icon: Rocket,\n    title: \"Piloto Autom\303\241tico\",\n    desc: \"Sua gest\303\243o financeira rodando sem tomar o seu tempo.\"\n  }\n];\n\nexport default function OnboardingJourney() {\n  const containerRef = useRef<HTMLDivElement>(null);\n  const lineRef = useRef<HTMLDivElement>(null);\n\n  useGSAP(() => {\n    const tl = gsap.timeline({\n      scrollTrigger: {\n        trigger: containerRef.current,\n        start: \"top 75%\",\n      }\n    });\n\n    // Animate connecting line\n    tl.fromTo(lineRef.current, \n      { scaleX: 0, transformOrigin: \"left center\" },\n      { scaleX: 1, duration: 1.5, ease: \"power3.inOut\" }\n    );\n\n    // Animate steps stagger\n    const stepElements = gsap.utils.toArray(\'.journey-step\');\n    tl.fromTo(stepElements, \n      { opacity: 0, y: 30, scale: 0.9 },\n      { opacity: 1, y: 0, scale: 1, duration: 0.8, stagger: 0.2, ease: \"back.out(1.2)\" },\n      \"-=1.0\" // start before line finishes\n    );\n\n  }, { scope: containerRef });\n\n  return (\n    <section ref={containerRef} className=\"py-24 border-t border-[#232A1B]/10 overflow-hidden\">\n      <div className=\"text-center mb-24\">\n        <div className=\"flex items-center justify-center gap-4 mb-6\">\n          <span className=\"h-[1px] w-8 bg-[#D8B36B]\"></span>\n          <span className=\"text-[10px] uppercase tracking-[0.3em] font-light text-[#D8B36B]\">Transi\303\247\303\243o R\303\241pida</span>\n          <span className=\"h-[1px] w-8 bg-[#D8B36B]\"></span>\n        </div>\n        <h2 className=\"text-3xl md:text-5xl font-serif font-light uppercase tracking-widest text-[#232A1B] mb-6\">\n          Onboarding <span className=\"italic lowercase text-[#D8B36B]\">Descomplicado</span>\n        </h2>\n        <p className=\"text-[#535458] text-sm font-light leading-relaxed tracking-wide max-w-lg mx-auto\">\n          Mudar de gest\303\243o n\303\243o precisa ser um trauma. Nosso processo de transi\303\247\303\243o foi desenhado para ser invis\303\255vel e ultra-r\303\241pido, exigindo quase nada do seu tempo.\n        </p>\n      </div>\n\n      <div className=\"relative max-w-5xl mx-auto px-4\">\n        {/* Background line for desktop */}\n        <div className=\"hidden md:block absolute top-[44px] left-8 right-8 h-[1px] bg-[#232A1B]/10\"></div>\n        {/* Animated active line */}\n        <div ref={lineRef} className=\"hidden md:block absolute top-[44px] left-8 right-8 h-[1px] bg-[#D8B36B] origin-left\"></div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-4 gap-12 md:gap-4 relative z-10\">\n          {steps.map((step, idx) => (\n            <div key={idx} className=\"journey-step flex flex-col items-center md:items-start relative group\">\n              \n              {/* Mobile connecting line */}\n              {idx !== steps.length - 1 && (\n                <div className=\"md:hidden absolute top-[88px] bottom-[-48px] left-1/2 -translate-x-1/2 w-[1px] bg-[#D8B36B]/30\"></div>\n              )}\n\n              {/* Icon Container */}\n              <div className=\"w-24 h-24 rounded-full bg-[#F7F6EE] border border-[#232A1B]/10 flex items-center justify-center mb-8 relative z-10 group-hover:border-[#D8B36B] transition-colors shadow-sm bg-clip-padding backdrop-filter backdrop-blur-sm\">\n                <span className=\"absolute -top-2 -right-2 w-6 h-6 rounded-full bg-[#D8B36B] text-[#FFFFFF] text-[10px] flex items-center justify-center font-light tracking-widest\">\n                  {idx + 1}\n                </span>\n                <step.icon strokeWidth={1} className=\"w-10 h-10 text-[#D8B36B] group-hover:scale-110 transition-transform duration-500 ease-out\" />\n              </div>\n\n              {/* Text Content */}\n              <div className=\"text-center md:text-left px-4 md:px-0\">\n                <h3 className=\"text-lg font-serif uppercase tracking-widest font-light text-[#232A1B] mb-3\">\n                  {step.title}\n                </h3>\n                <p className=\"text-xs text-[#535458] font-light leading-relaxed tracking-wide\">\n                  {step.desc}\n                </p>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n    </section>\n  );\n}"
    }
