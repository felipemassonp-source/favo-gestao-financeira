fian\303\247a e seguran\303\247a.243-            </p>244-          </div>245-        </div>246-        <FadeInUp className=\"flex-1 w-full relative\" delay={0.2}>247-           <div className=\"aspect-[4/5] bg-[#FFFFFF] border border-[#472f5b]/10 p-4 shadow-xl relative z-10\">248-             <div className=\"w-full h-full bg-[#fffff0] flex items-center justify-center\">249-               <span className=\"font-serif italic text-3xl text-[#b2893d]\">A.N.</span>250-             </div>251-           </div>252-           <div className=\"absolute top-8 -right-8 w-full h-full border border-[#D8B36B] -z-10\"></div>253-        </div>254-      </section>255-256-      {/* Trust Indicators Section */}257-      <FadeInUp>258-      <TrustIndicators />259-      </FadeInUp>260-261-      {/* Comparison Grid Section */}262-      <FadeInUp>263-      <ComparisonGrid />264-      </FadeInUp>"
