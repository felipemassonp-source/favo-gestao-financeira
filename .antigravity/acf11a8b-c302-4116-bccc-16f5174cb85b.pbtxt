      original_chunk {
        target_content: "        <p className=\"subtitle text-sm md:text-base font-light text-[#535458] max-w-2xl leading-relaxed mb-32 opacity-0 tracking-wide\">\n          Estrat\303\251gias simples, ferramentas certas e o b\303\241sico bem feito. Ajudamos voc\303\252 a organizar sua casa financeira e ver o lucro real do seu trabalho, sem jarg\303\265es ou planilhas que d\303\243o dor de cabe\303\247a.\n        </p>\n\n        {/* Gamified Journey Section */}\n        <div className=\"py-20 border-t border-[#232A1B]/10\">\n          <div className=\"flex flex-col md:flex-row md:items-end justify-between gap-8 mb-16\">\n            <div>\n              <span className=\"text-[#D8B36B] text-[10px] uppercase tracking-[0.3em] mb-6 block\">Como Funciona</span>\n              <h2 className=\"section-title text-4xl md:text-5xl font-serif font-light uppercase tracking-widest text-[#232A1B]\">\n                Desbloqueie<br/><span className=\"italic lowercase text-[#D8B36B]\">seu Lucro</span>\n              </h2>\n            </div>\n            <p className=\"text-[#535458] text-sm font-light leading-relaxed tracking-wide max-w-sm\">\n              Um m\303\251todo robusto disfar\303\247ado de simplicidade. Em 4 passos interativos, veja como transformamos a burocracia do seu dia a dia em uma rotina leve e lucrativa.\n            </p>\n          </div>\n          <InteractiveJourney />\n        </div>\n\n        {/* Benefits / Value Section */}\n        <div className=\"py-32 border-t border-[#232A1B]/10 mt-16\">\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-16\">\n            <div>\n              <span className=\"text-[#D8B36B] text-[10px] uppercase tracking-[0.2em] mb-4 block border-b border-[#D8B36B]/30 pb-4 w-12\"></span>\n              <h3 className=\"text-xl font-serif uppercase tracking-widest font-light text-[#232A1B] mb-4\">\n                O B\303\241sico que Funciona\n              </h3>\n              <p className=\"text-sm font-light text-[#535458] leading-relaxed tracking-wide\">\n                N\303\243o reinventamos a roda, n\303\263s fazemos ela girar. Focamos no feij\303\243o com arroz das finan\303\247as que a maioria n\303\243o faz: separar contas, precificar certo e controlar gastos.\n              </p>\n            </div>\n            <div>\n              <span className=\"text-[#D8B36B] text-[10px] uppercase tracking-[0.2em] mb-4 block border-b border-[#D8B36B]/30 pb-4 w-12\"></span>\n              <h3 className=\"text-xl font-serif uppercase tracking-widest font-light text-[#232A1B] mb-4\">\n                Ferramentas Certas\n              </h3>\n              <p className=\"text-sm font-light text-[#535458] leading-relaxed tracking-wide\">\n                Voc\303\252 n\303\243o precisa ser um mestre do Excel. N\303\263s implementamos sistemas simples e intuitivos que automatizam a burocracia, devolvendo horas preciosas para o seu dia.\n              </p>\n            </div>\n            <div>\n              <span className=\"text-[#D8B36B] text-[10px] uppercase tracking-[0.2em] mb-4 block border-b border-[#D8B36B]/30 pb-4 w-12\"></span>\n              <h3 className=\"text-xl font-serif uppercase tracking-widest font-light text-[#232A1B] mb-4\">\n                Retorno Absoluto\n              </h3>\n              <p className=\"text-sm font-light text-[#535458] leading-relaxed tracking-wide\">\n                A consultoria se paga rapidamente quando voc\303\252 descobre onde o dinheiro estava vazando e passa a precificar seus servi\303\247os com base na sua margem de lucro real.\n              </p>\n            </div>\n          </div>\n        </div>"
        replacement_content: "        <p className=\"subtitle text-sm md:text-base font-light text-[#535458] max-w-2xl leading-relaxed mb-32 opacity-0 tracking-wide\">\n          Nossa Consultoria ir\303\241 te guiar a encontrar os gargalos do seu financeiro, e trazer ferramentas que possam te auxiliar na constru\303\247\303\243o de um neg\303\263cio s\303\263lido.\n        </p>\n\n        {/* Gamified Journey Section */}\n        <div className=\"py-20 border-t border-[#232A1B]/10\">\n          <div className=\"flex flex-col md:flex-row md:items-end justify-between gap-8 mb-16\">\n            <div>\n              <span className=\"text-[#D8B36B] text-[10px] uppercase tracking-[0.3em] mb-6 block\">Como Funciona</span>\n              <h2 className=\"section-title text-4xl md:text-5xl font-serif font-light uppercase tracking-widest text-[#232A1B]\">\n                Nossos<br/><span className=\"italic lowercase text-[#D8B36B]\">Encontros</span>\n              </h2>\n            </div>\n            <p className=\"text-[#535458] text-sm font-light leading-relaxed tracking-wide max-w-sm\">\n              Um m\303\251todo robusto disfar\303\247ado de simplicidade. Em 4 encontros, veja como transformamos a burocracia do seu dia a dia em uma rotina leve e lucrativa.\n            </p>\n          </div>\n          <InteractiveJourney />\n        </div>\n\n        {/* Practical Details Section */}\n        <div className=\"py-32 border-t border-[#232A1B]/10 mt-16\">\n          <div className=\"flex items-center gap-4 mb-12\">\n            <span className=\"h-[1px] w-12 bg-[#D8B36B]\"></span>\n            <span className=\"text-[10px] uppercase tracking-[0.3em] font-light text-[#D8B36B]\">Na pr\303\241tica</span>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12\">\n            <div>\n              <span className=\"text-3xl font-serif font-light text-[#D8B36B] mb-4 block\">04</span>\n              <h3 className=\"text-sm font-serif uppercase tracking-widest font-light text-[#232A1B] mb-4\">\n                Encontros ao vivo\n              </h3>\n              <p className=\"text-xs font-light text-[#535458] leading-relaxed tracking-wide\">\n                Encontros online ao vivo e exclusivos para o seu neg\303\263cio, com dura\303\247\303\243o de at\303\251 1h30min cada.\n              </p>\n            </div>\n            \n            <div>\n              <span className=\"text-3xl font-serif font-light text-[#D8B36B] mb-4 block\">REC</span>\n              <h3 className=\"text-sm font-serif uppercase tracking-widest font-light text-[#232A1B] mb-4\">\n                Grava\303\247\303\265es\n              </h3>\n              <p className=\"text-xs font-light text-[#535458] leading-relaxed tracking-wide\">\n                Nossos encontros ser\303\243o gravados e disponibilizados para voc\303\252 rever quando e onde quiser.\n              </p>\n            </div>\n\n            <div>\n              <span className=\"text-3xl font-serif font-light text-[#D8B36B] mb-4 block\">06</span>\n              <h3 className=\"text-sm font-serif uppercase tracking-widest font-light text-[#232A1B] mb-4\">\n                Semanas\n              </h3>\n              <p className=\"text-xs font-light text-[#535458] leading-relaxed tracking-wide\">\n                Dura\303\247\303\243o total de 6 semanas de consultoria lado a lado com voc\303\252.\n              </p>\n            </div>\n\n            <div>\n              <span className=\"text-3xl font-serif font-light text-[#D8B36B] mb-4 block\">90</span>\n              <h3 className=\"text-sm font-serif uppercase tracking-widest font-light text-[#232A1B] mb-4\">\n                Dias de Suporte\n              </h3>\n              <p className=\"text-xs font-light text-[#535458] leading-relaxed tracking-wide\">\n                Suporte premium durante 90 dias via WhatsApp para tirar d\303\272vidas e destravar processos.\n              </p>\n            </div>\n          </div>\n        </div>"
      }
      fuzzy_match: "        <p className=\"subtitle text-sm md:text-base font-light text-[#535458] max-w-2xl leading-relaxed mb-32 opacity-0 tracking-wide\">\n          Estrat\303\251gias simples, ferramentas certas e o b\303\241sico bem feito. Ajudamos voc\303\252 a organizar sua casa financeira e ver o lucro real do seu trabalho, sem jarg\303\265es ou planilhas que d\303\243o dor de cabe\303\247a.\n        </p>\n\n        {/* Gamified Journey Section */}\n        <div className=\"py-20 border-t border-[#232A1B]/10\">\n          <div className=\"flex flex-col md:flex-row md:items-end justify-between gap-8 mb-16\">\n            <div>\n              <span className=\"text-[#D8B36B] text-[10px] uppercase tracking-[0.3em] mb-6 block\">Como Funciona</span>\n              <h2 className=\"section-title text-4xl md:text-5xl font-serif font-light uppercase tracking-widest text-[#232A1B]\">\n                Desbloqueie<br/><span className=\"italic lowercase text-[#D8B36B]\">seu Lucro</span>\n              </h2>\n            </div>\n            <p className=\"text-[#535458] text-sm font-light leading-relaxed tracking-wide max-w-sm\">\n              Um m\303\251todo robusto disfar\303\247ado de simplicidade. Em 4 passos interativos, veja como transformamos a burocracia do seu dia a dia em uma rotina leve e lucrativa.\n            </p>\n          </div>\n\n          <InteractiveJourney />\n        </div>\n\n        {/* Benefits / Value Section */}\n        <div className=\"py-32 border-t border-[#232A1B]/10 mt-16\">\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-16\">\n            <div>\n              <span className=\"text-[#D8B36B] text-[10px] uppercase tracking-[0.2em] mb-4 block border-b border-[#D8B36B]/30 pb-4 w-12\"></span>\n              <h3 className=\"text-xl font-serif uppercase tracking-widest font-light text-[#232A1B] mb-4\">\n                O B\303\241sico que Funciona\n              </h3>\n              <p className=\"text-sm font-light text-[#5