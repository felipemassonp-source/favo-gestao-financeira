    command_line: "cat << \'EOF\' > src/components/OrganicJourney.tsx\nimport React, { useRef } from \'react\';\nimport { useGSAP } from \'@gsap/react\';\nimport gsap from \'gsap\';\nimport { ScrollTrigger } from \'gsap/ScrollTrigger\';\nimport { FileSpreadsheet, AlertTriangle, Lightbulb, TrendingUp } from \'lucide-react\';\n\ngsap.registerPlugin(ScrollTrigger);\n\nexport default function OrganicJourney() {\n  const containerRef = useRef<HTMLDivElement>(null);\n  const pathRef = useRef<SVGPathElement>(null);\n\n  useGSAP(() => {\n    if (!pathRef.current || !containerRef.current) return;\n\n    const path = pathRef.current;\n    const length = path.getTotalLength();\n\n    // Set initial state for drawing the line\n    gsap.set(path, { strokeDasharray: length, strokeDashoffset: length });\n\n    // Animate the line drawing based on scroll\n    gsap.to(path, {\n      strokeDashoffset: 0,\n      ease: \"none\",\n      scrollTrigger: {\n        trigger: containerRef.current,\n        start: \"top 60%\", // Starts drawing when section is 60% down the viewport\n        end: \"bottom 80%\", // Finishes drawing near the bottom\n        scrub: 1.5, // Buttery smooth scrubbing\n      }\n    });\n\n    // Reveal the cards organically\n    gsap.utils.toArray(\'.journey-card\').forEach((card: any, i) => {\n      gsap.from(card, {\n        y: 60,\n        opacity: 0,\n        rotation: i % 2 === 0 ? -2 : 2,\n        duration: 1.2,\n        ease: \"power3.out\",\n        scrollTrigger: {\n          trigger: card,\n          start: \"top 85%\",\n          toggleActions: \"play none none reverse\"\n        }\n      });\n    });\n\n    // Animate glowing nodes on the path\n    gsap.utils.toArray(\'.journey-dot\').forEach((dot: any) => {\n      gsap.from(dot, {\n        scale: 0,\n        opacity: 0,\n        duration: 0.8,\n        ease: \"back.out(2)\",\n        scrollTrigger: {\n          trigger: dot,\n          start: \"top 70%\",\n          toggleActions: \"play none none reverse\"\n        }\n      });\n    });\n  }, { scope: containerRef });\n\n  const steps = [\n    {\n      id: 1,\n      type: \"pain\",\n      title: \"O Caos Di\303\241rio\",\n      desc: \"Contas f\303\255sicas misturadas com as da empresa, planilhas quebradas e o sentimento constante de que o dinheiro \'sumiu\' no fim do m\303\252s.\",\n      icon: FileSpreadsheet,\n      align: \"left\"\n    },\n    {\n      id: 2,\n      type: \"pain\",\n      title: \"A Sobrecarga\",\n      desc: \"Voc\303\252 passa o fim de semana lan\303\247ando notas, apagando inc\303\252ndios com bancos e perdendo dinheiro por esquecer prazos de boletos.\",\n      icon: AlertTriangle,\n      align: \"right\"\n    },\n    {\n      id: 3,\n      type: \"solution\",\n      title: \"A Interven\303\247\303\243o Favo\",\n      desc: \"N\303\263s assumimos a trincheira. Mapeamos seu financeiro, limpamos os processos manuais e assumimos 100% da burocracia banc\303\241ria.\",\n      icon: Lightbulb,\n      align: \"left\"\n    },\n    {\n      id: 4,\n      type: \"solution\",\n      title: \"Paz e Lucratividade\",\n      desc: \"Dashboard visual e preciso na sua m\303\243o. Voc\303\252 volta a dormir em paz e recupera o seu tempo para focar naquilo que traz dinheiro: vendas.\",\n      icon: TrendingUp,\n      align: \"right\"\n    }\n  ];\n\n  return (\n    <section ref={containerRef} className=\"py-32 bg-[#fffff0] relative overflow-hidden border-t border-[#472f5b]/10\">\n      <div className=\"max-w-7xl mx-auto px-6 relative z-10\">\n\n        <div className=\"text-center max-w-3xl mx-auto mb-20 md:mb-32\">\n          <span className=\"text-[#866428] text-[10px] uppercase tracking-[0.3em] mb-6 block font-medium\">A Jornada</span>\n          <h2 className=\"text-3xl md:text-5xl font-serif font-light text-[#472f5b] mb-6 tracking-wide\">\n            Como conectamos o seu caos <br className=\"hidden md:block\"/>\n            \303\240 <span className=\"italic text-[#866428]\">nossa clareza.</span>\n          </h2>\n        </div>\n\n        <div className=\"relative max-w-5xl mx-auto\">\n          \n          {/* Central Organic SVG Line */}\n          <div className=\"absolute inset-0 flex justify-center pointer-events-none\">\n            <svg\n              viewBox=\"0 0 100 100\"\n              preserveAspectRatio=\"none\"\n              className=\"w-full md:w-[200px] h-full overflow-visible\"\n            >\n              {/* Faded Background Trace */}\n              <path\n                d=\"M 50 0 Q 75 12.5, 50 25 T 50 50 T 50 75 T 50 100\"\n                stroke=\"#866428\"\n                strokeOpacity=\"0.1\"\n                strokeWidth=\"1\"\n                fill=\"none\"\n                vectorEffect=\"non-scaling-stroke\"\n                strokeLinecap=\"round\"\n              />\n              {/* Animated Golden Thread */}\n              <path\n                ref={pathRef}\n                d=\"M 50 0 Q 75 12.5, 50 25 T 50 50 T 50 75 T 50 100\"\n                stroke=\"#D8B36B\"\n                strokeWidth=\"3\"\n                fill=\"none\"\n                vectorEffect=\"non-scaling-stroke\"\n                strokeLinecap=\"round\"\n                className=\"drop-shadow-[0_0_12px_rgba(216,179,107,0.7)]\"\n              />\n            </svg>\n          </div>\n\n          {/* Steps Layout */}\n          <div className=\"flex flex-col justify-between relative z-10\" style={{ minHeight: \'800px\' }}>\n            {steps.map((step, index) => {\n              const isLeft = step.align === \'left\';\n              const isPain = step.type === \'pain\';\n\n              return (\n                <div\n                  key={step.id}\n                  className={`flex items-center w-full my-12 md:my-0 ${\n                    isLeft ? \'justify-start\' : \'justify-end\'\n                  }`}\n                >\n                  <div className={`w-full md:w-5/12 relative ${isLeft ? \'pr-8 md:pr-16\' : \'pl-8 md:pl-16\'}`}>\n                    \n                    {/* The Card */}\n                    <div className={`journey-card relative bg-[#FFFFFF] p-8 md:p-10 shadow-[0_10px_40px_-15px_rgba(0,0,0,0.1)] border-l-4 ${isPain ? \'border-[#472f5b]/40\' : \'border-[#866428]\'}`}>\n                      \n                      <div className={`w-12 h-12 rounded-full flex items-center justify-center mb-6 shadow-md ${isPain ? \'bg-[#fffff0] border border-[#472f5b]/10 text-[#472f5b]/60\' : \'bg-[#472f5b] text-[#D8B36B]\'}`}>\n                        <step.icon className=\"w-5 h-5\" />\n                      </div>\n                      \n                      <h3 className=\"text-xl md:text-2xl font-serif text-[#472f5b] mb-4 leading-tight\">{step.title}</h3>\n                      <p className=\"text-sm font-light text-[#2a3a1e] leading-relaxed tracking-wide\">\n                        {step.desc}\n                      </p>\n                    </div>\n\n                    {/* Connecting Dot (Mobile positioned left/right, Desktop centered) */}\n                    <div className={`absolute top-1/2 -translate-y-1/2 w-10 h-10 flex items-center justify-center ${isLeft ? \'-right-5 md:-right-16 md:translate-x-1/2\' : \'-left-5 md:-left-16 md:-translate-x-1/2\'}`}>\n                      <div className={`journey-dot relative z-20 w-4 h-4 rounded-full shadow-[0_0_20px_rgba(216,179,107,0.9)] ${isPain ? \'bg-[#472f5b]/50\' : \'bg-[#D8B36B]\'}`}></div>\n                      {/* Pulse Ring */}\n                      <div className={`absolute z-10 w-10 h-10 rounded-full border border-dashed animate-[spin_5s_linear_infinite] ${isPain ? \'border-[#472f5b]/20\' : \'border-[#D8B36B]/60\'}`}></div>\n                    </div>\n\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n\n        </div>\n      </div>\n    </section>\n  );\n}\nEOF"
    proposed_command_line: "cat << \'EOF\' > src/components/OrganicJourney.tsx\nimport React, { useRef } from \'react\';\nimport { useGSAP } from \'@gsap/react\';\nimport gsap from \'gsap\';\nimport { ScrollTrigger } from \'gsap/ScrollTrigger\';\nimport { FileSpreadsheet, AlertTriangle, Lightbulb, TrendingUp } from \'lucide-react\';\n\ngsap.registerPlugin(ScrollTrigger);\n\nexport default function OrganicJourney() {\n  const containerRef = useRef<HTMLDivElement>(null);\n  const pathRef = useRef<SVGPathElement>(null);\n\n  useGSAP(() => {\n    if (!pathRef.current || !containerRef.current) return;\n\n    const path = pathRef.current;\n    const length = path.getTotalLength();\n\n    // Set initial state for drawing the line\n    gsap.set(path, { strokeDasharray: length, strokeDashoffset: length });\n\n    // Animate the line drawing based on scroll\n    gsap.to(path, {\n      strokeDashoffset: 0,\n      ease: \"none\",\n      scrollTrigger: {\n        trigger: containerRef.current,\n        start: \"top 60%\", // Starts drawing when section is 60% down the viewport\n        end: \"bottom 80%\", // Finishes drawing near the bottom\n        scrub: 1.5, // Buttery smooth scrubbing\n      }\n    });\n\n    // Reveal the cards organically\n    gsap.utils.toArray(\'.journey-card\').forEach((card: any, i) => {\n      gsap.from(card, {\n        y: 60,\n        opacity: 0,\n        rotation: i % 2 === 0 ? -2 : 2,\n        duration: 1.2,\n        ease: \"power3.out\",\n        scrollTrigger: {\n          trigger: card,\n          start: \"top 85%\",\n          toggleActions: \"play none none reverse\"\n        }\n      });\n    });\n\n    // Animate glowing nodes on the path\n    gsap.utils.toArray(\'.journey-dot\').forEach((dot: any) => {\n      gsap.from(dot, {\n        scale: 0,\n        opacity: 0,\n        duration: 0.8,\n        ease: \"back.out(2)\",\n        scrollTrigger: {\n          trigger: dot,\n          start: \"top 70%\",\n          toggleActions: \"play none none reverse\"\n        }\n      });\n    });\n  }, { scope: containerRef });\n\n  const steps = [\n    {\n      id: 1,\n      type: \"pain\",\n      title: \"O Caos Di\303\241rio\",\n      desc: \"Contas f\303\255sicas misturadas com as da empresa, planilhas quebradas e o sentimento constante de que o dinheiro \'sumiu\' no fim do m\303\252s.\",\n      icon: FileSpreadsheet,\n      align: \"left\"\n    },\n    {\n      id: 2,\n      type: \"pain\",\n      title: \"A Sobrecarga\",\n      desc: \"Voc\303\252 passa o fim de semana lan\303\247ando notas, apagando inc\303\252ndios com bancos e perdendo dinheiro por esquecer prazos de boletos.\",\n      icon: AlertTriangle,\n      align: \"right\"\n    },\n    {\n      id: 3,\n      type: \"solution\",\n      title: \"A Interven\303\247\303\243o Favo\",\n      desc: \"N\303\263s assumimos a trincheira. Mapeamos seu financeiro, limpamos os processos manuais e assumimos 100% da burocracia banc\303\241ria.\",\n      icon: Lightbulb,\n      align: \"left\"\n    },\n    {\n      id: 4,\n      type: \"solution\",\n      title: \"Paz e Lucratividade\",\n      desc: \"Dashboard visual e preciso na sua m\303\243o. Voc\303\252 volta a dormir em paz e recupera o seu tempo para focar naquilo que traz dinheiro: vendas.\",\n      icon: TrendingUp,\n      align: \"right\"\n    }\n  ];\n\n  return (\n    <section ref={containerRef} className=\"py-32 bg-[#fffff0] relative overflow-hidden border-t border-[#472f5b]/10\">\n      <div className=\"max-w-7xl mx-auto px-6 relative z-10\">\n\n        <div className=\"text-center max-w-3xl mx-auto mb-20 md:mb-32\">\n          <span className=\"text-[#866428] text-[10px] uppercase tracking-[0.3em] mb-6 block font-medium\">A Jornada</span>\n          <h2 className=\"text-3xl md:text-5xl font-serif font-light text-[#472f5b] mb-6 tracking-wide\">\n            Como conectamos o seu caos <br className=\"hidden md:block\"/>\n            \303\240 <span className=\"italic text-[#866428]\">nossa clareza.</span>\n          </h2>\n        </div>\n\n        <div className=\"relative max-w-5xl mx-auto\">\n          \n          {/* Central Organic SVG Line */}\n          <div className=\"absolute inset-0 flex justify-center pointer-events-none\">\n            <svg\n              viewBox=\"0 0 100 100\"\n              preserveAspectRatio=\"none\"\n              className=\"w-full md:w-[200px] h-full overflow-visible\"\n            >\n              {/* Faded Background Trace */}\n              <path\n                d=\"M 50 0 Q 75 12.5, 50 25 T 50 50 T 50 75 T 50 100\"\n                stroke=\"#866428\"\n                strokeOpacity=\"0.1\"\n                strokeWidth=\"1\"\n                fill=\"none\"\n                vectorEffect=\"non-scaling-stroke\"\n                strokeLinecap=\"round\"\n              />\n              {/* Animated Golden Thread */}\n              <path\n                ref={pathRef}\n                d=\"M 50 0 Q 75 12.5, 50 25 T 50 50 T 50 75 T 50 100\"\n                stroke=\"#D8B36B\"\n                strokeWidth=\"3\"\n                fill=\"none\"\n                vectorEffect=\"non-scaling-stroke\"\n                strokeLinecap=\"round\"\n                className=\"drop-shadow-[0_0_12px_rgba(216,179,107,0.7)]\"\n              />\n            </svg>\n          </div>\n\n          {/* Steps Layout */}\n          <div className=\"flex flex-col justify-between relative z-10\" style={{ minHeight: \'800px\' }}>\n            {steps.map((step, index) => {\n              const isLeft = step.align === \'left\';\n              const isPain = step.type === \'pain\';\n\n              return (\n                <div\n                  key={step.id}\n                  className={`flex items-center w-full my-12 md:my-0 ${\n                    isLeft ? \'justify-start\' : \'justify-end\'\n                  }`}\n                >\n                  <div className={`w-full md:w-5/12 relative ${isLeft ? \'pr-8 md:pr-16\' : \'pl-8 md:pl-16\'}`}>\n                    \n                    {/* The Card */}\n                    <div className={`journey-card relative bg-[#FFFFFF] p-8 md:p-10 shadow-[0_10px_40px_-15px_rgba(0,0,0,0.1)] border-l-4 ${isPain ? \'border-[#472f5b]/40\' : \'border-[#866428]\'}`}>\n                      \n                      <div className={`w-12 h-12 rounded-full flex items-center justify-center mb-6 shadow-md ${isPain ? \'bg-[#fffff0] border border-[#472f5b]/10 text-[#472f5b]/60\' : \'bg-[#472f5b] text-[#D8B36B]\'}`}>\n                        <step.icon className=\"w-5 h-5\" />\n                      </div>\n                      \n                      <h3 className=\"text-xl md:text-2xl font-serif text-[#472f5b] mb-4 leading-tight\">{step.title}</h3>\n                      <p className=\"text-sm font-light text-[#2a3a1e] leading-relaxed tracking-wide\">\n                        {step.desc}\n                      </p>\n                    </div>\n\n                    {/* Connecting Dot (Mobile positioned left/right, Desktop centered) */}\n                    <div className={`absolute top-1/2 -translate-y-1/2 w-10 h-10 flex items-center justify-center ${isLeft ? \'-right-5 md:-right-16 md:translate-x-1/2\' : \'-left-5 md:-left-16 md:-translate-x-1/2\'}`}>\n                      <div className={`journey-dot relative z-20 w-4 h-4 rounded-full shadow-[0_0_20px_rgba(216,179,107,0.9)] ${isPain ? \'bg-[#472f5b]/50\' : \'bg-[#D8B36B]\'}`}></div>\n                      {/* Pulse Ring */}\n                      <div className={`absolute z-10 w-10 h-10 rounded-full border border-dashed animate-[spin_5s_linear_infinite] ${isPain ? \'border-[#472f5b]/20\' : \'border-[#D8B36B]/60\'}`}></div>\n                    </div>\n\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n\n        </div>\n      </div>\n    </section>\n  );\n}\nEOF"
    shell_name: "bash"
  }
}
