          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            <span className=\"text-[#D8B36B] text-[10px] uppercase tracking-[0.3em] mb-4\">Problema 01</span>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            <h2 className=\"text-4xl md:text-5xl font-serif font-light mb-6 uppercase tracking-widest text-[#232A1B]\">Falta de Tempo</h2>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            <p className=\"text-sm text-[#535458] font-light leading-relaxed max-w-lg tracking-wide\">Voc\303\252 passa o dia inteiro atendendo clientes e n\303\243o tem tempo (nem energia) para olhar as contas. N\303\263s assumimos a rotina financeira para que voc\303\252 foque no que faz de melhor.</p>"
