  file_change {
    absolute_path_uri: "file:///src/components/Preloader.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useEffect, useState } from \"react\";\nimport { motion, AnimatePresence } from \"motion/react\";\n\nexport default function Preloader() {\n  const [isLoading, setIsLoading] = useState(true);\n  const [shouldRender, setShouldRender] = useState(true);\n\n  useEffect(() => {\n    const hasVisited = sessionStorage.getItem(\'favo_visited\');\n    if (hasVisited) {\n      setIsLoading(false);\n      setShouldRender(false);\n      return;\n    }\n    \n    // Bloqueia a rolagem durante o loading\n    document.body.style.overflow = \"hidden\";\n    \n    const timer = setTimeout(() => {\n      setIsLoading(false);\n      sessionStorage.setItem(\'favo_visited\', \'true\');\n      document.body.style.overflow = \"\";\n    }, 2000);\n\n    return () => {\n      clearTimeout(timer);\n      document.body.style.overflow = \"\";\n    };\n  }, []);\n\n  if (!shouldRender) return null;\n\n  return (\n    <AnimatePresence>\n      {isLoading && (\n        <motion.div\n          key=\"preloader\"\n          initial={{ opacity: 1 }}\n          exit={{ y: \"-100%\" }}\n          transition={{ duration: 0.8, ease: [0.76, 0, 0.24, 1] }}\n          className=\"fixed inset-0 z-[9999] flex items-center justify-center bg-[#F7F6EE] text-[#232A1B]\"\n        >\n          <div className=\"flex flex-col items-center gap-8\">\n            <motion.div\n              initial={{ scale: 0.8, opacity: 0 }}\n              animate={{ scale: 1, opacity: 1 }}\n              transition={{ duration: 0.8, ease: \"easeOut\" }}\n              className=\"w-16 h-16 border border-[#D8B36B] flex items-center justify-center rounded-full\"\n            >\n              <motion.div \n                animate={{ scale: [1, 1.5, 1], opacity: [1, 0.5, 1] }}\n                transition={{ repeat: Infinity, duration: 1.5, ease: \"easeInOut\" }}\n                className=\"w-2 h-2 bg-[#D8B36B] rounded-full\"\n              ></motion.div>\n            </motion.div>\n            \n            <div className=\"overflow-hidden\">\n              <motion.span \n                initial={{ y: \"100%\" }}\n                animate={{ y: 0 }}\n                transition={{ duration: 0.6, delay: 0.2, ease: [0.76, 0, 0.24, 1] }}\n                className=\"block font-serif text-3xl tracking-[0.4em] uppercase font-light text-[#232A1B]\"\n              >\n                Favo\n              </motion.span>\n            </div>\n            \n            <motion.div \n              initial={{ width: 0, opacity: 0 }}\n              animate={{ width: \"120px\", opacity: 1 }}\n              transition={{ duration: 1, delay: 0.4, ease: \"easeInOut\" }}\n              className=\"h-[1px] bg-[#232A1B]/10 relative overflow-hidden mt-4\"\n            >\n              <motion.div \n                initial={{ x: \"-100%\" }}\n                animate={{ x: \"100%\" }}\n                transition={{ repeat: Infinity, duration: 1.2, ease: \"linear\" }}\n                className=\"absolute inset-0 w-1/3 bg-[#D8B36B]\"\n              ></motion.div>\n            </motion.div>\n          </div>\n        </motion.div>\n      )}\n    </AnimatePresence>\n  );\n}\n"
    }
