    instruction: "Update the observer logic to standard pinned scroll trigger"
    replacement_infos {
      original_chunk {
        target_content: "    // 3. Observer API Interactive Data Section\n    // Instead of normal scroll, we listen to swipe/wheel events to toggle data panels\n    let currentIndex = 0;\n    const panels = gsap.utils.toArray(\'.data-panel\');\n    const totalPanels = panels.length;\n    let isAnimating = false;\n\n    // Set initial state\n    gsap.set(panels, { zIndex: (i) => totalPanels - i });\n    \n    function gotoPanel(index: number, direction: number) {\n      if (isAnimating) return;\n      isAnimating = true;\n\n      const currentPanel = panels[currentIndex] as HTMLElement;\n      const nextPanel = panels[index] as HTMLElement;\n\n      gsap.to(currentPanel, {\n        yPercent: direction === 1 ? -100 : 100,\n        opacity: 0,\n        duration: 0.8,\n        ease: \"power2.inOut\",\n      });\n\n      gsap.fromTo(nextPanel, \n        { yPercent: direction === 1 ? 100 : -100, opacity: 0 },\n        {\n          yPercent: 0,\n          opacity: 1,\n          duration: 0.8,\n          ease: \"power2.inOut\",\n          onComplete: () => {\n            isAnimating = false;\n          }\n        }\n      );\n      \n      currentIndex = index;\n    }\n\n    if (observerSectionRef.current) {\n      Observer.create({\n        target: observerSectionRef.current,\n        type: \"wheel,touch,pointer\",\n        wheelSpeed: -1,\n        onDown: () => {\n          if (!isAnimating && currentIndex > 0) {\n            gotoPanel(currentIndex - 1, -1);\n          }\n        },\n        onUp: () => {\n          if (!isAnimating && currentIndex < totalPanels - 1) {\n            gotoPanel(currentIndex + 1, 1);\n          }\n        },\n        tolerance: 10,\n        preventDefault: true\n      });\n    }"
        replacement_content: "    // 3. Scroll-Driven Interactive Data Section (Pain Points)\n    const panels = gsap.utils.toArray(\'.data-panel\');\n    \n    // Set initial state\n    gsap.set(panels, { zIndex: (i) => panels.length - i });\n    \n    if (observerSectionRef.current) {\n      const sectionElement = observerSectionRef.current.parentElement;\n      \n      const tl = gsap.timeline({\n        scrollTrigger: {\n          trigger: sectionElement,\n          start: \"top top\",\n          end: \"+=200%\", // 2x height of the section for scrolling through 3 panels\n          pin: true,\n          scrub: 0.5,\n        }\n      });\n\n      panels.forEach((panel, i) => {\n        if (i === 0) return; // Skip first panel\n        \n        tl.fromTo(panel, \n          { yPercent: 100, opacity: 0 },\n          { yPercent: 0, opacity: 1, ease: \"none\", duration: 1 }\n        );\n      });\n    }"
      }
      num_matches: 1
    }
  }
