      replacement_content: "import { useRef } from \"react\";\nimport gsap from \"gsap\";\nimport { ScrollTrigger } from \"gsap/ScrollTrigger\";\nimport { useGSAP } from \"@gsap/react\";\nimport { Star } from \"lucide-react\";\n\ngsap.registerPlugin(ScrollTrigger);\n\nconst testimonials = [\n  {\n    author: \"B. Dias\",\n    text: \"O suporte de voc\303\252s tem sido fundamental pra mim meninas, voc\303\252s n\303\243o fazem ideia \360\237\244\215\",\n    stars: 5\n  },\n  {\n    author: \"alicebrabello\",\n    text: \"Recomendo, ela \303\251 muito top. Voc\303\252s n\303\243o v\303\243o se arrepender \360\237\231\214\",\n    stars: 5\n  },\n  {\n    author: \"Brunella Freitas da Rosa\",\n    text: \"A Andry \303\251 muito mais do que uma interface de comunica\303\247\303\243o. Cada palavra, cada resposta cuidadosa e cada solu\303\247\303\243o oferecida reflete o cuidado e a aten\303\247\303\243o que ela dedica. Ela n\303\243o apenas entende nossas necessidades, mas tamb\303\251m encontra maneira de nos ajudar e incentivar a superar os desafios. Ela \303\251 um verdadeiro presente encontrado em uma live, onde indicaram ela ! Pessoa de confian\303\247a, compet\303\252ncia e cora\303\247\303\243o!\",\n    stars: 5\n  },\n  {\n    author: \"B. Dias\",\n    text: \"Bom dia meninas! \342\234\250 Sou muito grata pelo apoio e trabalho que fizemos juntas ! Foi uma alegria esse tempo que tive o apoio de voc\303\252s e espero t\303\243o logo, conseguir voltar! Beijo grande no cora\303\247\303\243o de voc\303\252s \342\235\244\357\270\217\",\n    stars: 5\n  },\n  {\n    author: \"L. Martini\",\n    text: \"Muito obrigada Andry, n\303\243o sei se j\303\241 falei isso mas eu to muito feliz que tu t\303\241 aqui com a gente\",\n    stars: 5\n  },\n  {\n    author: \"G. Soares\",\n    text: \"N\303\243o sei o que seria dessa empresa sem voc\303\252 \342\235\244\357\270\217\",\n    stars: 5\n  },\n  {\n    author: \"Cliente Favo\",\n    text: \"Gente que demais!!! Acho o m\303\241ximo tbm que tu consegue nos dar essa visibilidade \360\237\245\263\360\237\245\263\360\237\245\263\360\237\231\217\360\237\231\217\360\237\231\217\360\237\231\217\360\237\231\217\360\237\231\217 obrigada por comunicar e olhar pro todo\",\n    stars: 5\n  },\n  {\n    author: \"J. Librelon\",\n    text: \"Andry, eu quero te abra\303\247ar / Obrigada por existir / Eu n\303\243o t\303\264 acreditando que t\303\264 tirando essas f\303\251rias / J\303\241 t\303\264 at\303\251 programando f\303\251rias com as crian\303\247as \342\235\244\357\270\217\",\n    stars: 5\n  },\n  {\n    author: \"graziele.cardosoadv\",\n    text: \"Eu s\303\263 sei as respostas porque tenho a melhor Assistente Financeiro cuidando disso para mim \342\235\244\357\270\217\",\n    stars: 5\n  }\n];\n\nexport default function Testimonials({ showPricing = false }: { showPricing?: boolean }) {\n  const containerRef = useRef<HTMLDivElement>(null);\n\n  useGSAP(() => {\n    const cards = gsap.utils.toArray(\'.testimonial-card\');\n    \n    gsap.from(cards, {\n      scrollTrigger: {\n        trigger: containerRef.current,\n        start: \"top 80%\",\n      },\n      opacity: 0,\n      y: 40,\n      duration: 1,\n      stagger: 0.1,\n      ease: \"power3.out\"\n    });\n  }, { scope: containerRef });\n\n  return (\n    <section ref={containerRef} className=\"py-32 border-t border-[#232A1B]/10 overflow-hidden bg-[#F7F6EE]\">\n      <div className=\"max-w-7xl mx-auto px-6\">\n        <div className=\"flex flex-col items-center text-center mb-16\">\n          <span className=\"text-[#D8B36B] text-[10px] uppercase tracking-[0.3em] mb-6 block\">Depoimentos</span>\n          <h2 className=\"text-4xl md:text-5xl font-serif font-light uppercase tracking-widest text-[#232A1B]\">\n            O que os <span className=\"italic lowercase text-[#D8B36B]\">clientes</span><br/> dizem sobre a Favo?\n          </h2>\n        </div>\n\n        {/* Masonry Grid */}\n        <div className=\"columns-1 md:columns-2 lg:columns-3 gap-6 space-y-6\">\n          {testimonials.map((item, idx) => (\n            <div key={idx} className=\"testimonial-card break-inside-avoid bg-[#FFFFFF] border border-[#232A1B]/10 p-8 shadow-md transition-shadow\">\n              <p className=\"text-sm text-[#535458] font-light leading-relaxed tracking-wide mb-6\">\n                \"{item.text}\"\n              </p>\n              \n              <div className=\"flex flex-col gap-2 mt-auto pt-4 border-t border-[#232A1B]/5\">\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"text-xs uppercase tracking-widest font-serif text-[#232A1B] truncate pr-4\">{item.author}</span>\n                  <div className=\"flex gap-1 shrink-0\">\n                    {[...Array(item.stars)].map((_, i) => (\n                      <Star key={i} className=\"w-3.5 h-3.5 text-[#D8B36B] fill-[#D8B36B]\" />\n                    ))}\n                  </div>\n                </div>\n              </div>\n            </div>\n          ))}\n        </div>\n\n        {showPricing && (\n          <div className=\"mt-20 flex justify-center\">\n            <div className=\"inline-block bg-[#D8B36B]/20 border border-[#D8B36B]/50 px-10 py-5 rounded-sm shadow-sm\">\n              <span className=\"font-serif text-[#232A1B] text-lg md:text-xl tracking-wider uppercase font-light\">\n                Planos a partir de <strong className=\"font-medium\">R$990,00</strong> por m\303\252s\n              </span>\n            </div>\n          </div>\n        )}\n      </div>\n    </section>\n  );\n}\n"
    }
