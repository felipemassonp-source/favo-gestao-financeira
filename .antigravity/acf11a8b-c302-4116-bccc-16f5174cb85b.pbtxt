    replacement_infos {
      original_chunk {
        target_content: "        <div className=\"flex items-center gap-4 mb-8 relative z-10\">\n          <span className=\"h-[1px] w-12 bg-[#D8B36B]\"></span>\n          <span className=\"text-[10px] uppercase tracking-[0.3em] font-light text-[#D8B36B]\">Vis\303\243o & Patrim\303\264nio</span>\n        </div>\n\n        <h1 \n          ref={heroTextRef} \n          className=\"text-6xl md:text-8xl lg:text-9xl font-light tracking-tight leading-[0.85] max-w-5xl font-serif relative z-10 uppercase\"\n          style={{ perspective: \"1000px\" }}\n        >\n          <span className=\"block opacity-100\">Intelig\303\252ncia</span>\n          <span className=\"block text-[#D8B36B] italic lowercase font-serif mt-2 mb-2\">financeira</span>\n          <span className=\"block\">Sob Medida.</span>\n        </h1>\n        <p className=\"hero-sub mt-12 text-sm md:text-base text-[#535458] max-w-xl leading-relaxed relative z-10 font-light tracking-wide\">\n          Transformamos dados complexos em decis\303\265es estrat\303\251gicas para impulsionar a sa\303\272de financeira do seu neg\303\263cio com precis\303\243o e transpar\303\252ncia absoluta.\n        </p>\n        <div className=\"hero-cta mt-16 flex gap-4 relative z-10\">\n          <Link to=\"/consultoria\" className=\"border border-[#232A1B]/20 px-10 py-4 text-[10px] uppercase tracking-[0.2em] hover:border-[#D8B36B] hover:text-[#D8B36B] transition-colors font-light rounded-full backdrop-blur-sm\">\n            Descubra a Consultoria\n          </Link>\n        </div>"
        replacement_content: "        <div className=\"flex items-center gap-4 mb-8 relative z-10\">\n          <span className=\"h-[1px] w-12 bg-[#D8B36B]\"></span>\n          <span className=\"text-[10px] uppercase tracking-[0.3em] font-light text-[#D8B36B]\">Gest\303\243o para Prestadores de Servi\303\247o</span>\n        </div>\n\n        <h1 \n          ref={heroTextRef} \n          className=\"text-6xl md:text-8xl lg:text-9xl font-light tracking-tight leading-[0.85] max-w-5xl font-serif relative z-10 uppercase\"\n          style={{ perspective: \"1000px\" }}\n        >\n          <span className=\"block opacity-100\">Finan\303\247as</span>\n          <span className=\"block text-[#D8B36B] italic lowercase font-serif mt-2 mb-2\">descomplicadas</span>\n          <span className=\"block\">e Lucrativas.</span>\n        </h1>\n        <p className=\"hero-sub mt-12 text-sm md:text-base text-[#535458] max-w-xl leading-relaxed relative z-10 font-light tracking-wide\">\n          Trabalhe com tranquilidade enquanto cuidamos dos n\303\272meros. Traduzo a gest\303\243o financeira da sua empresa de forma simples, amig\303\241vel e focada no seu crescimento, para voc\303\252 ter paz de esp\303\255rito.\n        </p>\n        <div className=\"hero-cta mt-16 flex gap-4 relative z-10\">\n          <Link to=\"/consultoria\" className=\"border border-[#232A1B]/20 px-10 py-4 text-[10px] uppercase tracking-[0.2em] hover:border-[#D8B36B] hover:text-[#D8B36B] transition-colors font-light rounded-full backdrop-blur-sm\">\n            Agendar Diagn\303\263stico\n          </Link>\n        </div>"
      }
      num_matches: 1
    }
    replacement_infos {
      original_chunk {
        target_content: "      {/* Interactive Observer Data Section */}\n      <section className=\"h-screen w-full relative overflow-hidden flex items-center justify-center bg-[#F7F6EE] border-t border-[#232A1B]/10\">\n        <div className=\"absolute top-12 text-center w-full z-10 text-[#535458]/70 uppercase tracking-[0.3em] text-[10px] font-light\">\n          Deslize para Analisar\n        </div>\n        \n        <div ref={observerSectionRef} className=\"relative w-full max-w-5xl h-[60vh] mx-auto cursor-ns-resize\">\n          {/* Panel 1 */}\n          <div className=\"data-panel absolute inset-0 bg-[#FFFFFF] p-16 border border-[#232A1B]/10 flex flex-col justify-center opacity-100 shadow-xl\">\n            <span className=\"text-[#D8B36B] text-[10px] uppercase tracking-[0.3em] mb-4\">01. Avalia\303\247\303\243o</span>\n            <h2 className=\"text-4xl md:text-5xl font-serif font-light mb-6 uppercase tracking-widest text-[#232A1B]\">Performance</h2>\n            <p className=\"text-sm text-[#535458] font-light leading-relaxed max-w-lg tracking-wide\">Identificamos gargalos e oportunidades invis\303\255veis nos seus relat\303\263rios financeiros para maximizar a sua margem de lucro com exatid\303\243o.</p>\n          </div>\n          {/* Panel 2 */}\n          <div className=\"data-panel absolute inset-0 bg-[#FFFFFF] p-16 border border-[#232A1B]/10 flex flex-col justify-center opacity-0 shadow-xl\">\n            <span className=\"text-[#D8B36B] text-[10px] uppercase tracking-[0.3em] mb-4\">02. Prote\303\247\303\243o</span>\n            <h2 className=\"text-4xl md:text-5xl font-serif font-light mb-6 uppercase tracking-widest text-[#232A1B]\">Riscos</h2>\n            <p className=\"text-sm text-[#535458] font-light leading-relaxed max-w-lg tracking-wide\">Proteja o caixa da sua empresa com estrat\303\251gias preditivas e modelagem financeira de alta precis\303\243o contra oscila\303\247\303\265es de mercado.</p>\n          </div>\n          {/* Panel 3 */}\n          <div className=\"data-panel absolute inset-0 bg-[#FFFFFF] p-16 border border-[#232A1B]/10 flex flex-col justify-center opacity-0 shadow-xl\">\n            <span className=\"text-[#D8B36B] text-[10px] uppercase tracking-[0.3em] mb-4\">03. Expans\303\243o</span>\n            <h2 className=\"text-4xl md:text-5xl font-serif font-light mb-6 uppercase tracking-widest text-[#232A1B]\">Estrat\303\251gia</h2>\n            <p className=\"text-sm text-[#535458] font-light leading-relaxed max-w-lg tracking-wide\">Tra\303\247amos metas financeiras claras e vi\303\241veis, com acompanhamento de KPIs em tempo real para garantir o alcance do seu legado.</p>\n          </div>\n        </div>\n      </section>\n\n      {/* Services Section with ScrollTrigger */}\n      <section className=\"py-40 px-6 max-w-7xl mx-auto border-t border-[#232A1B]/10\">\n        <div className=\"mb-24 flex flex-col md:flex-row md:items-end justify-between gap-8\">\n          <div>\n            <div className=\"flex items-center gap-4 mb-6\">\n              <span className=\"h-[1px] w-12 bg-[#D8B36B]\"></span>\n              <span className=\"text-[10px] uppercase tracking-[0.3em] font-light text-[#D8B36B]\">Nossa Expertise</span>\n            </div>\n            <h3 className=\"section-title text-5xl md:text-7xl font-serif font-light tracking-widest uppercase\">Solu\303\247\303\265es<br/><span className=\"italic lowercase text-[#D8B36B]\">Corporativas</span></h3>\n          </div>\n          <p className=\"text-[#535458] font-light text-sm max-w-xs tracking-wide leading-relaxed\">\n            Metodologias de alto padr\303\243o desenhadas para preservar e multiplicar capital institucional.\n          </p>\n        </div>\n        \n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-px bg-[#232A1B]/10 border border-[#232A1B]/10\">\n          <div className=\"service-card p-16 bg-[#FFFFFF] hover:bg-[#FDFCFB] transition-colors group relative\">\n            <div className=\"flex justify-between items-start mb-8\">\n              <span className=\"text-[#D8B36B] text-[10px] uppercase tracking-[0.2em] block\">/ BPO</span>\n              <Calculator strokeWidth={1} className=\"w-6 h-6 text-[#D8B36B] opacity-70 group-hover:opacity-100 transition-opacity duration-500\" />\n            </div>\n            <h4 className=\"service-title text-2xl font-serif uppercase tracking-widest font-light mb-6 group-hover:text-[#D8B36B] transition-colors text-[#232A1B]\">BPO Financeiro</h4>\n            <p className=\"text-xs text-[#535458] leading-relaxed font-light tracking-wide\">\n              Terceiriza\303\247\303\243o completa da gest\303\243o financeira. Foque no core business enquanto cuidamos do contas a pagar, receber, fluxo de caixa e concilia\303\247\303\243o banc\303\241ria.\n            </p>\n          </div>\n          <div className=\"service-card p-16 bg-[#FFFFFF] hover:bg-[#FDFCFB] transition-colors group relative\">\n            <div className=\"flex justify-between items-start mb-8\">\n              <span className=\"text-[#D8B36B] text-[10px] uppercase tracking-[0.2em] block\">/ Value</span>\n              <Gem strokeWidth={1} className=\"w-6 h-6 text-[#D8B36B] opacity-70 group-hover:opacity-100 transition-opacity duration-500\" />\n            </div>\n            <h4 className=\"service-title text-2xl font-serif uppercase tracking-widest font-light mb-6 group-hover:text-[#D8B36B] transition-colors text-[#232A1B]\">Valuation</h4>\n            <p className=\"text-xs text-[#535458] leading-relaxed font-light tracking-wide\">\n              Avalia\303\247\303\243o precisa do valor de mercado da sua empresa para fus\303\265es, aquisi\303\247\303\265es, capta\303\247\303\243o de recursos ou planejamento sucess\303\263rio.\n            </p>\n          </div>\n          <div className=\"service-card p-16 bg-[#FFFFFF] hover:bg-[#FDFCFB] transition-colors group relative\">\n            <div className=\"flex justify-between items-start mb-8\">\n              <span className=\"text-[#D8B36B] text-[10px] uppercase tracking-[0.2em] block\">/ Restructure</span>\n              <Activity strokeWidth={1} className=\"w-6 h-6 text-[#D8B36B] opacity-70 group-hover:opacity-100 transition-opacity duration-500\" />\n            </div>\n            <h4 className=\"service-title text-2xl font-serif uppercase tracking-widest font-light mb-6 group-hover:text-[#D8B36B] transition-colors text-[#232A1B]\">Reestrutura\303\247\303\243o</h4>\n            <p className=\"text-xs text-[#535458] leading-relaxed font-light tracking-wide\">\n              Planos de recupera\303\247\303\243o financeira e renegocia\303\247\303\243o de passivos. Trazemos f\303\264lego para empresas em momentos de transi\303\247\303\243o ou crise.\n            </p>\n          </div>\n          <div className=\"service-card p-16 bg-[#FFFFFF] hover:bg-[#FDFCFB] transition-colors group relative\">\n            <div className=\"flex justify-between items-start mb-8\">\n              <span className=\"text-[#D8B36B] text-[10px] uppercase tracking-[0.2em] block\">/ M&A</span>\n              <Handshake strokeWidth={1} className=\"w-6 h-6 text-[#D8B36B] opacity-70 group-hover:opacity-100 transition-opacity duration-500\" />\n            </div>\n            <h4 className=\"service-title text-2xl font-serif uppercase tracking-widest font-light mb-6 group-hover:text-[#D8B36B] transition-colors text-[#232A1B]\">M&A (Fus\303\265es)</h4>\n            <p className=\"text-xs text-[#535458] leading-relaxed font-light tracking-wide\">\n              Assessoria ponta a ponta na compra e venda de empresas. Do mapeamento de mercado ao fechamento estrat\303\251gico da opera\303\247\303\243o.\n            </p>\n          </div>\n        </div>\n      </section>"
        replacement_content: "      {/* Interactive Observer Data Section - Pain Points */}\n      <section className=\"h-screen w-full relative overflow-hidden flex items-center justify-center bg-[#F7F6EE] border-t border-[#232A1B]/10\">\n        <div className=\"absolute top-12 text-center w-full z-10 text-[#535458]/70 uppercase tracking-[0.3em] text-[10px] font-light\">\n          Deslize para ver como resolvemos\n        </div>\n        \n        <div ref={observerSectionRef} className=\"relative w-full max-w-5xl h-[60vh] mx-auto cursor-ns-resize\">\n          {/* Panel 1 */}\n          <div className=\"data-panel absolute inset-0 bg-[#FFFFFF] p-16 border border-[#232A1B]/10 flex flex-col justify-center opacity-100 shadow-xl\">\n            <span className=\"text-[#D8B36B] text-[10px] uppercase tracking-[0.3em] mb-4\">Problema 01</span>\n            <h2 className=\"text-4xl md:text-5xl font-serif font-light mb-6 uppercase tracking-widest text-[#232A1B]\">Falta de Tempo</h2>\n            <p className=\"text-sm text-[#535458] font-light leading-relaxed max-w-lg tracking-wide\">Voc\303\252 passa o dia inteiro atendendo clientes e n\303\243o tem tempo (nem energia) para olhar as contas. N\303\263s assumimos a rotina financeira para que voc\303\252 foque no que faz de melhor.</p>\n          </div>\n          {/* Panel 2 */}\n          <div className=\"data-panel absolute inset-0 bg-[#FFFFFF] p-16 border border-[#232A1B]/10 flex flex-col justify-center opacity-0 shadow-xl\">\n            <span className=\"text-[#D8B36B] text-[10px] uppercase tracking-[0.3em] mb-4\">Problema 02</span>\n            <h2 className=\"text-4xl md:text-5xl font-serif font-light mb-6 uppercase tracking-widest text-[#232A1B]\">Mistura de Contas</h2>\n            <p className=\"text-sm text-[#535458] font-light leading-relaxed max-w-lg tracking-wide\">Paga a escola do filho com a conta da empresa e compra material com o cart\303\243o pessoal? Organizamos tudo para voc\303\252 finalmente ter clareza sobre o seu pr\303\263-labore e o lucro real do neg\303\263cio.</p>\n          </div>\n          {/* Panel 3 */}\n          <div className=\"data-panel absolute inset-0 bg-[#FFFFFF] p-16 border border-[#232A1B]/10 flex flex-col justify-center opacity-0 shadow-xl\">\n            <span className=\"text-[#D8B36B] text-[10px] uppercase tracking-[0.3em] mb-4\">Problema 03</span>\n            <h2 className=\"text-4xl md:text-5xl font-serif font-light mb-6 uppercase tracking-widest text-[#232A1B]\">Medo dos N\303\272meros</h2>\n            <p className=\"text-sm text-[#535458] font-light leading-relaxed max-w-lg tracking-wide\">Planilhas complexas e termos dif\303\255ceis te assustam? Sem problemas. Traduzo seus resultados de forma simples, amig\303\241vel e did\303\241tica, para voc\303\252 ter seguran\303\247a em cada decis\303\243o.</p>\n          </div>\n        </div>\n      </section>\n\n      {/* About Andryelle Section */}\n      <section className=\"py-40 px-6 max-w-7xl mx-auto border-t border-[#232A1B]/10 flex flex-col md:flex-row gap-16 items-center\">\n        <div className=\"flex-1\">\n          <div className=\"flex items-center gap-4 mb-6\">\n            <span className=\"h-[1px] w-12 bg-[#D8B36B]\"></span>\n            <span className=\"text-[10px] uppercase tracking-[0.3em] font-light text-[#D8B36B]\">Quem sou eu</span>\n          </div>\n          <h3 className=\"section-title text-5xl md:text-6xl font-serif font-light tracking-widest uppercase mb-8\">\n            Andryelle<br/><span className=\"italic lowercase text-[#D8B36B]\">Niederauer</span>\n          </h3>\n          <div className=\"space-y-6 text-[#535458] font-light text-sm tracking-wide leading-relaxed max-w-lg\">\n            <p>\n              Ol\303\241! Com s\303\263lida bagagem no mundo das finan\303\247as, fundei a Favo com um prop\303\263sito muito claro: mostrar que a gest\303\243o financeira n\303\243o precisa ser um bicho de sete cabe\303\247as.\n            </p>\n            <p>\n              Eu acredito na simplicidade. Sei que como prestador de servi\303\247os, seu tempo \303\251 precioso e o jarg\303\243o financeiro n\303\243o ajuda. Por isso, minha comunica\303\247\303\243o \303\251 sempre did\303\241tica e amig\303\241vel.\n            </p>\n            <p>\n              Estou aqui para traduzir seus n\303\272meros, organizar a casa e te dar a clareza e a paz de esp\303\255rito necess\303\241rias para voc\303\252 ver seu neg\303\263cio (e o seu dinheiro) crescerem de verdade.\n            </p>\n          </div>\n        </div>\n        <div className=\"flex-1 w-full relative\">\n           <div className=\"aspect-[4/5] bg-[#FFFFFF] border border-[#232A1B]/10 p-4 shadow-xl relative z-10\">\n             <div className=\"w-full h-full bg-[#F7F6EE] flex items-center justify-center\">\n               <span className=\"font-serif italic text-3xl text-[#D8B36B]\">A.N.</span>\n             </div>\n           </div>\n           <div className=\"absolute top-8 -right-8 w-full h-full border border-[#D8B36B] -z-10\"></div>\n        </div>\n      </section>\n\n      {/* Services Section with ScrollTrigger */}\n      <section className=\"py-40 px-6 max-w-7xl mx-auto border-t border-[#232A1B]/10\">\n        <div className=\"mb-24 flex flex-col md:flex-row md:items-end justify-between gap-8\">\n          <div>\n            <div className=\"flex items-center gap-4 mb-6\">\n              <span className=\"h-[1px] w-12 bg-[#D8B36B]\"></span>\n              <span className=\"text-[10px] uppercase tracking-[0.3em] font-light text-[#D8B36B]\">Nossa Expertise</span>\n            </div>\n            <h3 className=\"section-title text-5xl md:text-7xl font-serif font-light tracking-widest uppercase\">Como Posso<br/><span className=\"italic lowercase text-[#D8B36B]\">Ajudar</span></h3>\n          </div>\n          <p className=\"text-[#535458] font-light text-sm max-w-xs tracking-wide leading-relaxed\">\n            Solu\303\247\303\265es desenhadas para tirar o peso das suas costas e trazer organiza\303\247\303\243o real para o seu dia a dia.\n          </p>\n        </div>\n        \n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-px bg-[#232A1B]/10 border border-[#232A1B]/10\">\n          <div className=\"service-card p-16 bg-[#FFFFFF] hover:bg-[#FDFCFB] transition-colors group relative\">\n            <div className=\"flex justify-between items-start mb-8\">\n              <span className=\"text-[#D8B36B] text-[10px] uppercase tracking-[0.2em] block\">/ Terceiriza\303\247\303\243o</span>\n              <Calculator strokeWidth={1} className=\"w-6 h-6 text-[#D8B36B] opacity-70 group-hover:opacity-100 transition-opacity duration-500\" />\n            </div>\n            <h4 className=\"service-title text-2xl font-serif uppercase tracking-widest font-light mb-6 group-hover:text-[#D8B36B] transition-colors text-[#232A1B]\">BPO Financeiro</h4>\n            <p className=\"text-xs text-[#535458] leading-relaxed font-light tracking-wide\">\n              Delegue a rotina. Cuidamos do seu contas a pagar, receber, fluxo de caixa e concilia\303\247\303\243o banc\303\241ria, enquanto voc\303\252 foca no atendimento aos seus clientes.\n            </p>\n          </div>\n          <div className=\"service-card p-16 bg-[#FFFFFF] hover:bg-[#FDFCFB] transition-colors group relative\">\n            <div className=\"flex justify-between items-start mb-8\">\n              <span className=\"text-[#D8B36B] text-[10px] uppercase tracking-[0.2em] block\">/ Planejamento</span>\n              <Map strokeWidth={1} className=\"w-6 h-6 text-[#D8B36B] opacity-70 group-hover:opacity-100 transition-opacity duration-500\" />\n            </div>\n            <h4 className=\"service-title text-2xl font-serif uppercase tracking-widest font-light mb-6 group-hover:text-[#D8B36B] transition-colors text-[#232A1B]\">Consultoria</h4>\n            <p className=\"text-xs text-[#535458] leading-relaxed font-light tracking-wide\">\n              M\303\243o na massa junto com voc\303\252. Estruturamos metas, planejamos o seu crescimento e organizamos suas finan\303\247as de forma simples e muito did\303\241tica.\n            </p>\n          </div>\n          <div className=\"service-card p-16 bg-[#FFFFFF] hover:bg-[#FDFCFB] transition-colors group relative\">\n            <div className=\"flex justify-between items-start mb-8\">\n              <span className=\"text-[#D8B36B] text-[10px] uppercase tracking-[0.2em] block\">/ Clareza</span>\n              <PieChart strokeWidth={1} className=\"w-6 h-6 text-[#D8B36B] opacity-70 group-hover:opacity-100 transition-opacity duration-500\" />\n            </div>\n            <h4 className=\"service-title text-2xl font-serif uppercase tracking-widest font-light mb-6 group-hover:text-[#D8B36B] transition-colors text-[#232A1B]\">Diagn\303\263stico</h4>\n            <p className=\"text-xs text-[#535458] leading-relaxed font-light tracking-wide\">\n              N\303\243o sabe por onde come\303\247ar? Fazemos um raio-x completo do seu cen\303\241rio atual e entregamos um plano de a\303\247\303\243o claro, sem jarg\303\265es complicados.\n            </p>\n          </div>\n          <div className=\"service-card p-16 bg-[#FFFFFF] hover:bg-[#FDFCFB] transition-colors group relative\">\n            <div className=\"flex justify-between items-start mb-8\">\n              <span className=\"text-[#D8B36B] text-[10px] uppercase tracking-[0.2em] block\">/ Crescimento</span>\n              <Lightbulb strokeWidth={1} className=\"w-6 h-6 text-[#D8B36B] opacity-70 group-hover:opacity-100 transition-opacity duration-500\" />\n            </div>\n            <h4 className=\"service-title text-2xl font-serif uppercase tracking-widest font-light mb-6 group-hover:text-[#D8B36B] transition-colors text-[#232A1B]\">Gest\303\243o Estrat\303\251gica</h4>\n            <p className=\"text-xs text-[#535458] leading-relaxed font-light tracking-wide\">\n              An\303\241lise dos seus resultados m\303\252s a m\303\252s. Mostramos onde est\303\243o os vazamentos de lucro e como melhorar seus pre\303\247os de forma amig\303\241vel e segura.\n            </p>\n          </div>\n        </div>\n      </section>"
      }
      num_matches: 1
    }
  }
}
