    instruction: "Update Footer component to include social icons, quick navigation links, structured solutions, contact with icons, and refined styling."
    replacement_infos {
      original_chunk {
        target_content: "import { Link } from \"react-router-dom\";\n\nexport default function Footer() {\n  return (\n    <footer id=\"contato\" className=\"bg-[#FFFFFF] border-t border-[#472f5b]/10 py-24 text-[#472f5b]\">\n      <div className=\"max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-3 gap-16\">\n        <div>\n          <Link to=\"/\" className=\"inline-block mb-6\">\n            <img \n              src=\"/logo-favo-completa.png\" \n              alt=\"Favo Gest\303\243o Financeira\" \n              className=\"h-16 w-auto object-contain\"\n            />\n          </Link>\n          <p className=\"text-[#4e653d] max-w-xs text-sm leading-relaxed font-light\">\n            Transformando dados financeiros em estrat\303\251gias de alto crescimento para a sua empresa.\n          </p>\n        </div>\n        <div>\n          <h4 className=\"font-light uppercase tracking-[0.2em] text-[10px] mb-6 text-[#D8B36B]\">Servi\303\247os</h4>\n          <ul className=\"space-y-4 text-[#4e653d] text-xs font-light tracking-wide\">\n            <li className=\"hover:text-[#472f5b] transition-colors cursor-pointer\">Consultoria Financeira</li>\n            <li className=\"hover:text-[#472f5b] transition-colors cursor-pointer\">An\303\241lise de Dados</li>\n            <li className=\"hover:text-[#472f5b] transition-colors cursor-pointer\">Gest\303\243o de Riscos</li>\n            <li className=\"hover:text-[#472f5b] transition-colors cursor-pointer\">Otimiza\303\247\303\243o de Custos</li>\n          </ul>\n        </div>\n        <div>\n          <h4 className=\"font-light uppercase tracking-[0.2em] text-[10px] mb-6 text-[#D8B36B]\">Contato</h4>\n          <ul className=\"space-y-4 text-[#4e653d] text-xs font-light tracking-wide\">\n            <li className=\"hover:text-[#472f5b] transition-colors cursor-pointer\">contato@favogestao.com.br</li>\n            <li className=\"hover:text-[#472f5b] transition-colors cursor-pointer\">+55 (11) 99999-9999</li>\n            <li className=\"hover:text-[#472f5b] transition-colors cursor-pointer\">Av. Paulista, 1000 - SP</li>\n          </ul>\n        </div>\n      </div>\n      <div className=\"max-w-7xl mx-auto px-6 mt-24 pt-8 border-t border-[#472f5b]/10 text-[10px] uppercase tracking-widest text-[#4e653d] flex justify-between items-center font-light\">\n        <p>&copy; {new Date().getFullYear()} Favo. Todos os direitos reservados.</p>\n      </div>\n    </footer>\n  );\n}"
        replacement_content: "import { Link } from \"react-router-dom\";\nimport { Instagram, Linkedin, MessageCircle, MapPin, Mail, Phone } from \"lucide-react\";\n\nexport default function Footer() {\n  return (\n    <footer id=\"contato\" className=\"bg-[#FFFFFF] border-t border-[#472f5b]/10 py-24 text-[#472f5b]\">\n      <div className=\"max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-16\">\n        \n        {/* Brand & Social */}\n        <div className=\"col-span-1 md:col-span-2 lg:col-span-1\">\n          <Link to=\"/\" className=\"inline-block mb-6\">\n            <img \n              src=\"/logo-favo-completa.png\" \n              alt=\"Favo Gest\303\243o Financeira\" \n              className=\"h-16 w-auto object-contain\"\n            />\n          </Link>\n          <p className=\"text-[#4e653d] text-sm leading-relaxed font-light mb-8 max-w-xs\">\n            Transformando dados financeiros em estrat\303\251gias de alto crescimento para a sua empresa.\n          </p>\n          <div className=\"flex items-center gap-4\">\n            <a href=\"https://instagram.com/favogestao\" target=\"_blank\" rel=\"noopener noreferrer\" className=\"w-10 h-10 rounded-full border border-[#472f5b]/20 flex items-center justify-center text-[#472f5b] hover:bg-[#D8B36B] hover:text-[#fffff0] hover:border-[#D8B36B] transition-all duration-300\">\n              <Instagram className=\"w-4 h-4\" />\n            </a>\n            <a href=\"https://linkedin.com\" target=\"_blank\" rel=\"noopener noreferrer\" className=\"w-10 h-10 rounded-full border border-[#472f5b]/20 flex items-center justify-center text-[#472f5b] hover:bg-[#D8B36B] hover:text-[#fffff0] hover:border-[#D8B36B] transition-all duration-300\">\n              <Linkedin className=\"w-4 h-4\" />\n            </a>\n            <a href=\"https://wa.me/5511999999999\" target=\"_blank\" rel=\"noopener noreferrer\" className=\"w-10 h-10 rounded-full border border-[#472f5b]/20 flex items-center justify-center text-[#472f5b] hover:bg-[#D8B36B] hover:text-[#fffff0] hover:border-[#D8B36B] transition-all duration-300\">\n              <MessageCircle className=\"w-4 h-4\" />\n            </a>\n          </div>\n        </div>\n\n        {/* Quick Links */}\n        <div>\n          <h4 className=\"font-light uppercase tracking-[0.2em] text-[10px] mb-6 text-[#D8B36B]\">Navega\303\247\303\243o</h4>\n          <ul className=\"space-y-4 text-[#4e653d] text-xs font-light tracking-wide\">\n            <li><Link to=\"/\" className=\"hover:text-[#472f5b] hover:pl-2 transition-all duration-300 block\">In\303\255cio</Link></li>\n            <li><Link to=\"/gestao-financeira\" className=\"hover:text-[#472f5b] hover:pl-2 transition-all duration-300 block\">Gest\303\243o Financeira</Link></li>\n            <li><Link to=\"/consultoria\" className=\"hover:text-[#472f5b] hover:pl-2 transition-all duration-300 block\">Consultoria</Link></li>\n            <li><a href=\"/#contato\" className=\"hover:text-[#472f5b] hover:pl-2 transition-all duration-300 block\">Fale Conosco</a></li>\n          </ul>\n        </div>\n\n        {/* Services */}\n        <div>\n          <h4 className=\"font-light uppercase tracking-[0.2em] text-[10px] mb-6 text-[#D8B36B]\">Solu\303\247\303\265es</h4>\n          <ul className=\"space-y-4 text-[#4e653d] text-xs font-light tracking-wide\">\n            <li><Link to=\"/gestao-financeira\" className=\"hover:text-[#472f5b] hover:pl-2 transition-all duration-300 block\">BPO Financeiro</Link></li>\n            <li><Link to=\"/consultoria\" className=\"hover:text-[#472f5b] hover:pl-2 transition-all duration-300 block\">Consultoria Estrat\303\251gica</Link></li>\n            <li><Link to=\"/consultoria\" className=\"hover:text-[#472f5b] hover:pl-2 transition-all duration-300 block\">Diagn\303\263stico Financeiro</Link></li>\n            <li><Link to=\"/gestao-financeira\" className=\"hover:text-[#472f5b] hover:pl-2 transition-all duration-300 block\">An\303\241lise de Dados</Link></li>\n          </ul>\n        </div>\n\n        {/* Contact */}\n        <div>\n          <h4 className=\"font-light uppercase tracking-[0.2em] text-[10px] mb-6 text-[#D8B36B]\">Contato</h4>\n          <ul className=\"space-y-4 text-[#4e653d] text-xs font-light tracking-wide\">\n            <li className=\"flex items-center gap-3\">\n              <Mail className=\"w-4 h-4 text-[#D8B36B] shrink-0\" />\n              <a href=\"mailto:contato@favogestao.com.br\" className=\"hover:text-[#472f5b] transition-colors\">contato@favogestao.com.br</a>\n            </li>\n            <li className=\"flex items-center gap-3\">\n              <Phone className=\"w-4 h-4 text-[#D8B36B] shrink-0\" />\n              <a href=\"tel:+5511999999999\" className=\"hover:text-[#472f5b] transition-colors\">+55 (11) 99999-9999</a>\n            </li>\n            <li className=\"flex items-center gap-3\">\n              <MapPin className=\"w-4 h-4 text-[#D8B36B] shrink-0\" />\n              <span>Av. Paulista, 1000 - SP</span>\n            </li>\n          </ul>\n        </div>\n\n      </div>\n\n      <div className=\"max-w-7xl mx-auto px-6 mt-24 pt-8 border-t border-[#472f5b]/10 text-[10px] uppercase tracking-widest text-[#4e653d] flex flex-col md:flex-row justify-between items-center gap-4 font-light\">\n        <p>&copy; {new Date().getFullYear()} Favo Gest\303\243o Financeira. Todos os direitos reservados.</p>\n        <p>CNPJ: 00.000.000/0001-00</p>\n      </div>\n    </footer>\n  );\n}"
      }
      num_matches: 1
    }
