  search_web {
    query: "\"noto emoji\" lottie json url format"
    web_documents {
      url: "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQEt5QmAsUfREK-mm4MdQEZvX5D7x5xC-4uEw7jISQSQv0j4po7a4ueAsfEWsio46hCvaoF5b8_259KV76OLwi-thT4f8dVPR-xRfj10ad1nFRXHpfZYurV2s_09XJpC7z4570TMNt7KNMAE4_TDiKiOwqW5nwLMfokFilRzKZCErm7xrN_9_xxZEX5PO6qGEYyPTHnsb--Gvn8U"
      title: "github.io"
    }
    web_documents {
      url: "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQHEuUIE1NZI8uVfXTh2d1zYJu97d-FKYyvuL_f4opsEmvbfzL_4G_Tgcylr4qxBLx5igquC7AZBP1WXo8eXYHFDSYABZ0AfL9-ZrZ7sf2fPxv9ChjSSrueyLSkftM9sM8G-pit26BnC3DY8hoNFm59-IaXPZEg-pRDtlaLurW3wlkYGMpMTjQEF-DuqEs92ewf8QaoSvFe7z2w5"
      title: "github.io"
    }
    web_documents {
      url: "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQF0GyUvPfoaM7a6cB6J77-MOD7LPhRasYWwbsdmIdk_1yv7tCs5wSxAHGEIJhkkN32j5Nw6ma887A3RL1AWdFkndfoTWQQV3MojkN1usZos_anB5BDz0im1uxl-Mb-GaAqiyaC8F2yvmCsqAXHg"
      title: "lottiefiles.com"
    }
    web_documents {
      url: "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQGgSCVCGdLWD66My9uZsfbtXgMI0soLfZAGZ-HNYJMVLjNiqBidLy6R4JFviDv04RqKtYbqcjO0pIuKS5aNBpO9GUMcrmSgOvcIZt9m3b11WOQ4SbIl4pOzaTytW-DHUngZwKTTs08pJ3c8aCACDAsuxhZ4FmZ1pd435FIA_2TFW3pMlOHjTbOI1UPChPFg6Etizc3O_n-SLLibC0cEM8YIoIyM"
      title: "lottiefiles.com"
    }
    summary: "The Lottie JSON URL format for Noto Emojis typically follows a specific structure hosted by Google Fonts.\n\nThe general format is:\n`https://fonts.gstatic.com/s/e/notoemoji/latest/[EMOJI_UNICODE]/lottie.json`\n\nHere\'s a breakdown:\n*   **`https://fonts.gstatic.com/s/e/notoemoji/latest/`**: This is the base URL for the latest Noto Emoji animations.\n*   **`[EMOJI_UNICODE]`**: This placeholder should be replaced with the hexadecimal Unicode codepoint of the specific Noto Emoji you want to use. For example, `1f422` represents the chick emoji[1], and `1f602` represents the face with tears of joy emoji[2].\n*   **`/lottie.json`**: This indicates the file is a Lottie JSON animation.\n\nFor instance, to access the Lottie JSON for the chick emoji, the URL would be: `https://fonts.gstatic.com/s/e/notoemoji/latest/1f422/lottie.json`[1]. Similarly, for the face with tears of joy emoji, it would be `https://fonts.gstatic.com/s/e/notoemoji/latest/1f602/lottie.json`[2].\n\nAdditionally, platforms like LottieFiles offer a vast collection of Noto Emoji animations and provide options to download them in Lottie JSON format, or to obtain URLs for animations hosted on their platform[3][4].\n\nSources:\n[1] [github.io](https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQEt5QmAsUfREK-mm4MdQEZvX5D7x5xC-4uEw7jISQSQv0j4po7a4ueAsfEWsio46hCvaoF5b8_259KV76OLwi-thT4f8dVPR-xRfj10ad1nFRXHpfZYurV2s_09XJpC7z4570TMNt7KNMAE4_TDiKiOwqW5nwLMfokFilRzKZCErm7xrN_9_xxZEX5PO6qGEYyPTHnsb--Gvn8U)\n[2] [github.io](https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQHEuUIE1NZI8uVfXTh2d1zYJu97d-FKYyvuL_f4opsEmvbfzL_4G_Tgcylr4qxBLx5igquC7AZBP1WXo8eXYHFDSYABZ0AfL9-ZrZ7sf2fPxv9ChjSSrueyLSkftM9sM8G-pit26BnC3DY8hoNFm59-IaXPZEg-pRDtlaLurW3wlkYGMpMTjQEF-DuqEs92ewf8QaoSvFe7z2w5)\n[3] [lottiefiles.com](https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQF0GyUvPfoaM7a6cB6J77-MOD7LPhRasYWwbsdmIdk_1yv7tCs5wSxAHGEIJhkkN32j5Nw6ma887A3RL1AWdFkndfoTWQQV3MojkN1usZos_anB5BDz0im1uxl-Mb-GaAqiyaC8F2yvmCsqAXHg)\n[4] [lottiefiles.com](https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQGgSCVCGdLWD66My9uZsfbtXgMI0soLfZAGZ-HNYJMVLjNiqBidLy6R4JFviDv04RqKtYbqcjO0pIuKS5aNBpO9GUMcrmSgOvcIZt9m3b11WOQ4SbIl4pOzaTytW-DHUngZwKTTs08pJ3c8aCACDAsuxhZ4FmZ1pd435FIA_2TFW3pMlOHjTbOI1UPChPFg6Etizc3O_n-SLLibC0cEM8YIoIyM)"
    third_party_config {
      provider: THIRD_PARTY_WEB_SEARCH_PROVIDER_GEMINI
    }
    search_type: SEARCH_WEB_TYPE_WEB
  }
}
