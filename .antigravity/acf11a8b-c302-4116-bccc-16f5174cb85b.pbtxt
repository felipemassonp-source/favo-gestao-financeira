  file_change {
    absolute_path_uri: "file:///src/pages/Consultoria.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useRef } from \"react\";\nimport gsap from \"gsap\";\nimport { ScrollTrigger } from \"gsap/ScrollTrigger\";\nimport { useGSAP } from \"@gsap/react\";\nimport SplitType from \"split-type\";\nimport { CheckCircle2 } from \"lucide-react\";\n\ngsap.registerPlugin(ScrollTrigger);\n\nexport default function Consultoria() {\n  const container = useRef<HTMLDivElement>(null);\n  const titleRef = useRef<HTMLHeadingElement>(null);\n\n  useGSAP(() => {\n    // Split Text animation for title\n    if (titleRef.current) {\n      const text = new SplitType(titleRef.current, { types: \'chars\' });\n      \n      gsap.from(text.chars, {\n        opacity: 0,\n        y: 40,\n        scale: 0.5,\n        stagger: 0.03,\n        duration: 0.8,\n        ease: \"back.out(1.5)\",\n      });\n    }\n\n    // Pinned section animation\n    ScrollTrigger.create({\n      trigger: \".pin-section\",\n      start: \"top top\",\n      end: \"+=100%\",\n      pin: true,\n      pinSpacing: true,\n    });\n\n    const items = gsap.utils.toArray(\'.process-item\');\n    items.forEach((item: any, i) => {\n      gsap.from(item, {\n        scrollTrigger: {\n          trigger: item,\n          start: \"top 80%\",\n        },\n        opacity: 0,\n        x: -50,\n        duration: 0.6,\n        delay: i * 0.1,\n      });\n    });\n\n  }, { scope: container });\n\n  const processes = [\n    \"Diagn\303\263stico Financeiro Completo\",\n    \"Mapeamento de Processos Atuais\",\n    \"Estrutura\303\247\303\243o de DRE e Fluxo de Caixa\",\n    \"Defini\303\247\303\243o de KPIs e Metas\",\n    \"Acompanhamento Estrat\303\251gico Mensal\"\n  ];\n\n  return (\n    <div ref={container} className=\"w-full min-h-screen pt-32 pb-20\">\n      <div className=\"max-w-7xl mx-auto px-6\">\n        <h1 ref={titleRef} className=\"text-5xl md:text-7xl font-bold tracking-tighter mb-8 text-white\">\n          Consultoria <span className=\"text-amber-500\">Financeira</span>\n        </h1>\n        <p className=\"text-xl text-slate-400 max-w-3xl leading-relaxed mb-20 opacity-0 animate-[fadeIn_1s_ease_0.5s_forwards]\">\n          A Favo atua lado a lado com os gestores para entender a fundo o modelo de neg\303\263cio, \n          identificar inefici\303\252ncias e projetar cen\303\241rios que garantam a sustentabilidade e \n          o crescimento do capital corporativo.\n        </p>\n\n        {/* ScrollTrigger Pinned Section Example */}\n        <div className=\"pin-section flex flex-col md:flex-row gap-12 items-center min-h-[70vh] bg-slate-900/50 p-12 rounded-3xl border border-slate-800\">\n          <div className=\"flex-1\">\n            <h2 className=\"text-3xl font-bold mb-6 text-white\">Nossa Metodologia</h2>\n            <p className=\"text-slate-400 text-lg leading-relaxed mb-8\">\n              Atrav\303\251s de uma abordagem consultiva baseada em dados reais, estruturamos a intelig\303\252ncia financeira \n              que a sua empresa precisa para tomar decis\303\265es seguras. (Role para ver o processo)\n            </p>\n          </div>\n          <div className=\"flex-1 flex flex-col gap-6\">\n            {processes.map((proc, idx) => (\n              <div key={idx} className=\"process-item flex items-center gap-4 bg-slate-800 p-6 rounded-2xl border border-slate-700 shadow-lg\">\n                <CheckCircle2 className=\"text-amber-500 w-8 h-8 shrink-0\" />\n                <span className=\"text-lg font-medium text-white\">{proc}</span>\n              </div>\n            ))}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}"
    }
