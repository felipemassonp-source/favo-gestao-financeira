    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import { motion } from \"motion/react\";\nimport { ReactNode } from \"react\";\n\ninterface FadeInUpProps {\n  children: ReactNode;\n  delay?: number;\n  className?: string;\n}\n\nexport default function FadeInUp({ children, delay = 0, className = \"\" }: FadeInUpProps) {\n  return (\n    <motion.div\n      initial={{ opacity: 0, y: 50 }}\n      whileInView={{ opacity: 1, y: 0 }}\n      viewport={{ once: true, margin: \"-100px\" }}\n      transition={{ duration: 0.8, ease: [0.21, 0.47, 0.32, 0.98], delay }}\n      className={className}\n    >\n      {children}\n    </motion.div>\n  );\n}"
      replacement_content: "import React, { useRef, ReactNode } from \"react\";\nimport { useGSAP } from \"@gsap/react\";\nimport gsap from \"gsap\";\nimport { ScrollTrigger } from \"gsap/ScrollTrigger\";\n\ngsap.registerPlugin(ScrollTrigger);\n\ninterface FadeInUpProps {\n  children: ReactNode;\n  delay?: number;\n  className?: string;\n  parallax?: boolean;\n  parallaxSpeed?: number;\n}\n\nexport default function FadeInUp({ \n  children, \n  delay = 0, \n  className = \"\", \n  parallax = false, \n  parallaxSpeed = 0.1 \n}: FadeInUpProps) {\n  const containerRef = useRef<HTMLDivElement>(null);\n\n  useGSAP(() => {\n    if (!containerRef.current) return;\n\n    // Premium Fade-in Up Effect\n    gsap.fromTo(containerRef.current, \n      { \n        y: 60, \n        opacity: 0,\n        // Add a slight rotation for a more organic feel if it\'s not a large layout container\n        // rotation: 1 \n      },\n      {\n        y: 0,\n        opacity: 1,\n        // rotation: 0,\n        duration: 1.2,\n        delay: delay,\n        ease: \"power3.out\",\n        scrollTrigger: {\n          trigger: containerRef.current,\n          start: \"top 85%\", // Triggers when the top of the element hits 85% of the viewport height\n          toggleActions: \"play none none reverse\", // Plays forward on enter, reverses on leave back\n        }\n      }\n    );\n\n    // Optional Parallax Effect\n    if (parallax) {\n      gsap.to(containerRef.current, {\n        y: () => -window.innerHeight * parallaxSpeed,\n        ease: \"none\",\n        scrollTrigger: {\n          trigger: containerRef.current,\n          start: \"top bottom\",\n          end: \"bottom top\",\n          scrub: 1, // Smooth scrubbing\n        }\n      });\n    }\n  }, { scope: containerRef });\n\n  return (\n    <div ref={containerRef} className={className}>\n      {children}\n    </div>\n  );\n}"
    }
