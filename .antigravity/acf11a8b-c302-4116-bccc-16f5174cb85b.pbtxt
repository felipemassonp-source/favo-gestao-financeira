        target_content: "  const consultoriaQuestions = {\n    q1: {\n      label: \"Qual o seu principal objetivo com a consultoria?\",\n      options: [\n        \"Organizar as finan\303\247as do zero\",\n        \"Melhorar minha precifica\303\247\303\243o\",\n        \"Planejar o crescimento da empresa\",\n        \"Socorro financeiro (Sair do vermelho)\",\n      ],\n      field: \"dorPrincipal\"\n    },\n    q2: {\n      label: \"Como voc\303\252 controla o financeiro atualmente?\",\n      options: [\n        \"Planilhas (Excel/Google Sheets)\",\n        \"Caderno de anota\303\247\303\265es\",\n        \"Sistema financeiro / ERP\",\n        \"Ainda n\303\243o controlo\",\n      ],\n      field: \"volumeOuControle\"\n    }\n  };\n\n  const questions = type === \"bpo\" ? bpoQuestions : consultoriaQuestions;"
        replacement_content: "  const consultoriaQuestions = {\n    q1: {\n      label: \"Qual o seu principal objetivo com a consultoria?\",\n      options: [\n        \"Organizar as finan\303\247as do zero\",\n        \"Melhorar minha precifica\303\247\303\243o\",\n        \"Planejar o crescimento da empresa\",\n        \"Socorro financeiro (Sair do vermelho)\",\n      ],\n      field: \"dorPrincipal\"\n    },\n    q2: {\n      label: \"Qual o seu faturamento m\303\251dio mensal?\",\n      options: [\n        \"At\303\251 R$ 20.000\",\n        \"De R$ 20.000 a R$ 50.000\",\n        \"De R$ 50.000 a R$ 100.000\",\n        \"Acima de R$ 100.000\",\n      ],\n      field: \"volumeOuControle\"\n    }\n  };\n\n  const getClassification = () => {\n    if (type !== \"consultoria\") return null;\n\n    const dor = formData.dorPrincipal;\n    const faturamento = formData.volumeOuControle;\n\n    if (faturamento === \"At\303\251 R$ 20.000\" || dor === \"Socorro financeiro (Sair do vermelho)\") {\n      return {\n        tag: \"Perfil: Estrutura\303\247\303\243o Essencial\",\n        desc: \"Seu foco inicial deve ser organizar a casa, separar contas e criar controles b\303\241sicos para garantir que a opera\303\247\303\243o respire com sa\303\272de.\"\n      };\n    }\n    \n    if (faturamento === \"Acima de R$ 100.000\" || (faturamento === \"De R$ 50.000 a R$ 100.000\" && dor === \"Planejar o crescimento da empresa\")) {\n      return {\n        tag: \"Perfil: Gest\303\243o Estrat\303\251gica\",\n        desc: \"Sua empresa j\303\241 possui tra\303\247\303\243o. O trabalho agora ser\303\241 em blindar o caixa, otimizar margens de lucro e projetar cen\303\241rios para expans\303\243o segura.\"\n      };\n    }\n\n    return {\n      tag: \"Perfil: Alavancagem\",\n      desc: \"Voc\303\252 tem um cen\303\241rio promissor. Nosso foco ser\303\241 ajustar sua precifica\303\247\303\243o, mapear custos invis\303\255veis e fazer voc\303\252 ver a cor do dinheiro que produz.\"\n    };\n  };\n\n  const questions = type === \"bpo\" ? bpoQuestions : consultoriaQuestions;"
