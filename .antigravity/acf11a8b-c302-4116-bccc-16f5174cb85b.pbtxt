    command_line: "cat << \'EOF\' > src/components/RiskAwareness.tsx\nimport { useRef } from \"react\";\nimport gsap from \"gsap\";\nimport { ScrollTrigger } from \"gsap/ScrollTrigger\";\nimport { useGSAP } from \"@gsap/react\";\nimport { AlertTriangle, TrendingDown, ShieldAlert, XOctagon } from \"lucide-react\";\n\ngsap.registerPlugin(ScrollTrigger);\n\nconst risks = [\n  {\n    title: \"Desorganiza\303\247\303\243o Total\",\n    desc: \"Sua empresa se torna desorganizada em rela\303\247\303\243o \303\240s finan\303\247as, resultando em falta de planejamento, margem de lucro baixa e problemas com capital de giro.\",\n    icon: AlertTriangle\n  },\n  {\n    title: \"Inadimpl\303\252ncia\",\n    desc: \"Sem um controle adequado das contas, a empresa pode enfrentar problemas de inadimpl\303\252ncia, afetando sua credibilidade com fornecedores e clientes.\",\n    icon: TrendingDown\n  },\n  {\n    title: \"Fraudes e Erros\",\n    desc: \"A falta de controle aumenta os riscos de fraudes internas, bem como erros cont\303\241beis que podem prejudicar a integridade dos registros.\",\n    icon: ShieldAlert\n  },\n  {\n    title: \"Perda de Crescimento\",\n    desc: \"Sem uma estrat\303\251gia financeira clara e orienta\303\247\303\243o especializada, sua empresa perde preciosas oportunidades de crescimento e expans\303\243o.\",\n    icon: XOctagon\n  }\n];\n\nexport default function RiskAwareness() {\n  const containerRef = useRef<HTMLDivElement>(null);\n  const textRef = useRef<HTMLDivElement>(null);\n\n  useGSAP(() => {\n    const cards = gsap.utils.toArray(\'.risk-card\');\n    \n    gsap.from(textRef.current, {\n      scrollTrigger: {\n        trigger: containerRef.current,\n        start: \"top 80%\",\n      },\n      opacity: 0,\n      y: 30,\n      duration: 1,\n      ease: \"power3.out\"\n    });\n\n    gsap.from(cards, {\n      scrollTrigger: {\n        trigger: containerRef.current,\n        start: \"top 60%\",\n      },\n      opacity: 0,\n      y: 40,\n      duration: 1,\n      stagger: 0.15,\n      ease: \"power3.out\"\n    });\n  }, { scope: containerRef });\n\n  return (\n    <section ref={containerRef} className=\"py-24 border-t border-[#232A1B]/10\">\n      <div className=\"flex flex-col lg:flex-row gap-16 lg:gap-24 mb-20\" ref={textRef}>\n        <div className=\"lg:w-1/2\">\n          <span className=\"text-[#D8B36B] text-[10px] uppercase tracking-[0.3em] mb-6 block\">Muito mais que n\303\272meros</span>\n          <p className=\"text-xl md:text-2xl font-serif font-light leading-relaxed text-[#232A1B] tracking-wide\">\n            \"Na Favo, entendemos que a gest\303\243o financeira \303\251 sobre <span className=\"italic text-[#D8B36B]\">liberdade, crescimento e tranquilidade</span> para voc\303\252 focar no que realmente importa: o sucesso do seu neg\303\263cio.\"\n          </p>\n        </div>\n        <div className=\"lg:w-1/2 lg:pl-12 lg:border-l lg:border-[#232A1B]/10 flex flex-col justify-center\">\n          <h2 className=\"text-3xl md:text-4xl font-serif font-light uppercase tracking-widest text-[#232A1B] mb-6\">\n            E se a sua empresa <br/><span className=\"italic lowercase text-[#D8B36B]\">ficasse sem dinheiro?</span>\n          </h2>\n          <p className=\"text-[#535458] text-sm font-light leading-relaxed tracking-wide\">\n            Sem uma Gest\303\243o Financeira eficiente, voc\303\252 n\303\243o est\303\241 apenas deixando de ganhar. Voc\303\252 est\303\241 correndo s\303\251rios riscos que podem comprometer o futuro do seu trabalho.\n          </p>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n        {risks.map((item, idx) => (\n          <div key={idx} className=\"risk-card bg-[#FFFFFF] border border-[#232A1B]/10 p-8 md:p-10 hover:border-[#D8B36B]/50 transition-colors group flex flex-col md:flex-row gap-8 items-start\">\n            <div className=\"w-14 h-14 shrink-0 rounded-full bg-[#F7F6EE] border border-[#232A1B]/10 flex items-center justify-center group-hover:bg-[#D8B36B]/10 group-hover:border-[#D8B36B] transition-colors\">\n              <item.icon strokeWidth={1.5} className=\"w-6 h-6 text-[#D8B36B]\" />\n            </div>\n            <div>\n              <h3 className=\"text-lg font-serif uppercase tracking-widest text-[#232A1B] mb-3 group-hover:text-[#D8B36B] transition-colors\">{item.title}</h3>\n              <p className=\"text-sm text-[#535458] font-light leading-relaxed tracking-wide\">{item.desc}</p>\n            </div>\n          </div>\n        ))}\n      </div>\n\n      <div className=\"mt-16 text-center max-w-2xl mx-auto border border-[#D8B36B]/30 bg-[#FFFFFF] p-8\">\n        <p className=\"text-sm font-light tracking-wide text-[#535458] leading-relaxed\">\n          Uma gest\303\243o financeira eficaz \303\251 o alicerce para o sucesso de qualquer neg\303\263cio, proporcionando <span className=\"font-medium text-[#232A1B]\">clareza, controle e oportunidades de crescimento sustent\303\241vel.</span>\n        </p>\n      </div>\n    </section>\n  );\n}\nEOF"
