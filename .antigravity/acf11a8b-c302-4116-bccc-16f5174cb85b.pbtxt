ef = useRef<HTMLDivElement>(null);  useGSAP(() => {    const cards = gsap.utils.toArray(\'.benefit-card\');    gsap.from(cards, {      scrollTrigger: {        trigger: containerRef.current,        start: \"top 85%\",      },      opacity: 0,      y: 40,      duration: 1,      stagger: 0.15,      ease: \"power3.out\"    });  }, { scope: containerRef });  return (    <section ref={containerRef} className=\"py-24 border-t border-[#472f5b]/10\">      <div className=\"flex items-center gap-4 mb-6\">        <span className=\"h-[1px] w-12 bg-[#D8B36B]\"></span>        <span className=\"text-[10px] uppercase tracking-[0.3em] font-light text-[#D8B36B]\">Os Benef\303\255cios reais</span>      </div>            <h2 className=\"text-4xl md:text-5xl font-serif font-light uppercase tracking-widest text-[#472f5b] mb-16\">        Muito al\303\251m de <br/><span className=\"italic lowercase text-[#D8B36B]\">pagar contas</span>      </h2>      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-12 gap-y-16\">        {benefits.map((item, idx) => (          <div key={idx} className=\"benefit-card flex flex-col group\">            <div className=\"w-14 h-14 mb-6 rounded-full bg-[#FFFFFF] border border-[#472f5b]/10 flex items-center justify-center group-hover:border-[#D8B36B] transition-colors shadow-sm\">              <UseAnimations                 animation={item.icon}                 size={32}                 strokeColor=\"#D8B36B\"                 className=\"text-[#D8B36B] group-hover:scale-110 transition-transform cursor-pointer\"              />            </div>            <h3 className=\"text-lg font-serif uppercase tracking-widest text-[#472f5b] mb-3\">{item.title}</h3>            <p className=\"text-sm text-[#4e653d] font-light leading-relaxed tracking-wide\">{item.desc}</p>          </div>        ))}      </div>    </section>  );}"
