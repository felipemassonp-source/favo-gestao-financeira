      replacement_content: "  useGSAP(() => {\n    // 1. Split Text Animation for Hero (replaces GSAP SplitText)\n    if (heroTextRef.current) {\n      const text = new SplitType(heroTextRef.current, { types: \'lines,words,chars\' });\n      \n      // Wrap lines in overflow hidden for a masking effect\n      text.lines?.forEach((line) => {\n        const wrapper = document.createElement(\'div\');\n        wrapper.style.overflow = \'hidden\';\n        line.parentNode?.insertBefore(wrapper, line);\n        wrapper.appendChild(line);\n      });\n\n      gsap.from(text.chars, {\n        y: \"100%\",\n        opacity: 0,\n        rotationZ: 3,\n        stagger: 0.02,\n        duration: 1.4,\n        ease: \"power4.out\",\n        delay: 0.2,\n      });\n\n      gsap.from(\".hero-sub\", {\n        opacity: 0,\n        y: 30,\n        duration: 1.5,\n        ease: \"power3.out\",\n        delay: 1.2,\n      });\n      \n      gsap.from(\".hero-cta\", {\n        opacity: 0,\n        y: 20,\n        duration: 1.2,\n        delay: 1.5,\n        ease: \"power3.out\"\n      });\n    }\n\n    // High-end section title animations\n    const sectionTitles = gsap.utils.toArray(\'.section-title\');\n    sectionTitles.forEach((title: any) => {\n      const splitTitle = new SplitType(title, { types: \'lines,words\' });\n      \n      splitTitle.lines?.forEach((line) => {\n        const wrapper = document.createElement(\'div\');\n        wrapper.style.overflow = \'hidden\';\n        line.parentNode?.insertBefore(wrapper, line);\n        wrapper.appendChild(line);\n      });\n\n      gsap.from(splitTitle.words, {\n        scrollTrigger: {\n          trigger: title,\n          start: \"top 85%\",\n        },\n        y: \"100%\",\n        opacity: 0,\n        duration: 1.2,\n        stagger: 0.05,\n        ease: \"power4.out\"\n      });\n    });\n\n    // 2. ScrollTrigger for services section cards\n    const serviceCards = gsap.utils.toArray(\'.service-card\');\n    serviceCards.forEach((card: any, i) => {\n      gsap.from(card, {\n        scrollTrigger: {\n          trigger: card,\n          start: \"top 85%\",\n          toggleActions: \"play none none reverse\",\n        },\n        opacity: 0,\n        y: 40,\n        duration: 1.2,\n        ease: \"power3.out\",\n        delay: i * 0.15,\n      });\n    });"
