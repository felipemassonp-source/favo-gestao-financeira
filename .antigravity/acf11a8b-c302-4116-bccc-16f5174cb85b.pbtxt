          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "import { useLocation } from \"react-router-dom\";"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "import { motion, AnimatePresence } from \"motion/react\";"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "import Header from \"./Header\";"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
