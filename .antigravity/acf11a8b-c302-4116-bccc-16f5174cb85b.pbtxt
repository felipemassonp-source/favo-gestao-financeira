  file_change {
    absolute_path_uri: "file:///src/components/TangibleResults.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useRef } from \"react\";\nimport gsap from \"gsap\";\nimport { ScrollTrigger } from \"gsap/ScrollTrigger\";\nimport { useGSAP } from \"@gsap/react\";\nimport { \n  BarChart, Bar, XAxis, YAxis, Tooltip, ResponsiveContainer, Cell,\n  AreaChart, Area, CartesianGrid\n} from \"recharts\";\n\ngsap.registerPlugin(ScrollTrigger);\n\nconst timeData = [\n  { name: \"Sem a Favo\", horas: 40 },\n  { name: \"Com a Favo\", horas: 4 }\n];\n\nconst efficiencyData = [\n  { mes: \"M\303\252s 1\", controle: 30 },\n  { mes: \"M\303\252s 2\", controle: 55 },\n  { mes: \"M\303\252s 3\", controle: 75 },\n  { mes: \"M\303\252s 4\", controle: 90 },\n  { mes: \"M\303\252s 5\", controle: 100 }\n];\n\nconst CustomTooltipTime = ({ active, payload }: any) => {\n  if (active && payload && payload.length) {\n    return (\n      <div className=\"bg-[#FFFFFF] border border-[#232A1B]/10 p-4 shadow-xl\">\n        <p className=\"text-[10px] uppercase tracking-[0.2em] font-light text-[#535458] mb-1\">{payload[0].payload.name}</p>\n        <p className=\"text-xl font-serif text-[#D8B36B]\">{payload[0].value}h <span className=\"text-xs font-light text-[#232A1B] uppercase tracking-widest\">/m\303\252s</span></p>\n      </div>\n    );\n  }\n  return null;\n};\n\nconst CustomTooltipEfficiency = ({ active, payload }: any) => {\n  if (active && payload && payload.length) {\n    return (\n      <div className=\"bg-[#FFFFFF] border border-[#232A1B]/10 p-4 shadow-xl\">\n        <p className=\"text-[10px] uppercase tracking-[0.2em] font-light text-[#535458] mb-1\">{payload[0].payload.mes}</p>\n        <p className=\"text-xl font-serif text-[#D8B36B]\">{payload[0].value}% <span className=\"text-xs font-light text-[#232A1B] uppercase tracking-widest\">Controle</span></p>\n      </div>\n    );\n  }\n  return null;\n};\n\nexport default function TangibleResults() {\n  const containerRef = useRef<HTMLDivElement>(null);\n\n  useGSAP(() => {\n    const cards = gsap.utils.toArray(\'.chart-card\');\n    \n    gsap.from(cards, {\n      scrollTrigger: {\n        trigger: containerRef.current,\n        start: \"top 80%\",\n      },\n      opacity: 0,\n      y: 40,\n      duration: 1,\n      stagger: 0.2,\n      ease: \"power3.out\"\n    });\n  }, { scope: containerRef });\n\n  return (\n    <section ref={containerRef} className=\"py-24 border-t border-[#232A1B]/10\">\n      <div className=\"flex items-center gap-4 mb-6\">\n        <span className=\"h-[1px] w-12 bg-[#D8B36B]\"></span>\n        <span className=\"text-[10px] uppercase tracking-[0.3em] font-light text-[#D8B36B]\">Resultados Tang\303\255veis</span>\n      </div>\n      \n      <div className=\"flex flex-col md:flex-row md:items-end justify-between gap-8 mb-16\">\n        <h2 className=\"text-4xl md:text-5xl font-serif font-light uppercase tracking-widest text-[#232A1B]\">\n          O impacto dos <br/><span className=\"italic lowercase text-[#D8B36B]\">n\303\272meros a seu favor</span>\n        </h2>\n        <p className=\"text-[#535458] text-sm font-light leading-relaxed tracking-wide max-w-sm\">\n          N\303\263s transformamos a dor de cabe\303\247a burocr\303\241tica em tempo livre e m\303\251tricas visuais, dando a voc\303\252 controle absoluto sobre o crescimento.\n        </p>\n      </div>\n\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n        \n        {/* Time Saved Chart */}\n        <div className=\"chart-card bg-[#FFFFFF] border border-[#232A1B]/10 p-10 shadow-lg group hover:border-[#D8B36B]/40 transition-colors\">\n          <h3 className=\"text-xl font-serif font-light text-[#232A1B] mb-2 uppercase tracking-widest\">Tempo Gasto com Burocracia</h3>\n          <p className=\"text-xs font-light text-[#535458] tracking-wide mb-10\">\n            Horas gastas por m\303\252s com pagamentos, concilia\303\247\303\243o e emiss\303\243o de notas.\n          </p>\n          <div className=\"h-64 w-full\">\n            <ResponsiveContainer width=\"100%\" height=\"100%\">\n              <BarChart data={timeData} margin={{ top: 10, right: 10, left: -20, bottom: 0 }}>\n                <XAxis \n                  dataKey=\"name\" \n                  axisLine={false} \n                  tickLine={false} \n                  tick={{ fill: \'#535458\', fontSize: 10, fontWeight: 300, textAnchor: \'middle\' }}\n                  dy={10}\n                />\n                <YAxis \n                  axisLine={false} \n                  tickLine={false} \n                  tick={{ fill: \'#535458\', fontSize: 10, fontWeight: 300 }}\n                />\n                <Tooltip content={<CustomTooltipTime />} cursor={{ fill: \'rgba(216, 179, 107, 0.05)\' }} />\n                <Bar dataKey=\"horas\" radius={[4, 4, 0, 0]} barSize={60} animationDuration={1500}>\n                  {timeData.map((entry, index) => (\n                    <Cell key={`cell-${index}`} fill={index === 0 ? \'#232A1B\' : \'#D8B36B\'} fillOpacity={index === 0 ? 0.1 : 1} />\n                  ))}\n                </Bar>\n              </BarChart>\n            </ResponsiveContainer>\n          </div>\n        </div>\n\n        {/* Efficiency/Control Chart */}\n        <div className=\"chart-card bg-[#FFFFFF] border border-[#232A1B]/10 p-10 shadow-lg group hover:border-[#D8B36B]/40 transition-colors\">\n          <h3 className=\"text-xl font-serif font-light text-[#232A1B] mb-2 uppercase tracking-widest\">N\303\255vel de Visibilidade e Controle</h3>\n          <p className=\"text-xs font-light text-[#535458] tracking-wide mb-10\">\n            Aumento da clareza sobre margem de lucro e fluxo de caixa ao longo dos meses.\n          </p>\n          <div className=\"h-64 w-full\">\n            <ResponsiveContainer width=\"100%\" height=\"100%\">\n              <AreaChart data={efficiencyData} margin={{ top: 10, right: 10, left: -20, bottom: 0 }}>\n                <defs>\n                  <linearGradient id=\"colorControle\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                    <stop offset=\"5%\" stopColor=\"#D8B36B\" stopOpacity={0.3}/>\n                    <stop offset=\"95%\" stopColor=\"#D8B36B\" stopOpacity={0}/>\n                  </linearGradient>\n                </defs>\n                <CartesianGrid strokeDasharray=\"3 3\" vertical={false} stroke=\"rgba(35, 42, 27, 0.05)\" />\n                <XAxis \n                  dataKey=\"mes\" \n                  axisLine={false} \n                  tickLine={false} \n                  tick={{ fill: \'#535458\', fontSize: 10, fontWeight: 300 }}\n                  dy={10}\n                />\n                <YAxis \n                  axisLine={false} \n                  tickLine={false} \n                  tick={{ fill: \'#535458\', fontSize: 10, fontWeight: 300 }}\n                />\n                <Tooltip content={<CustomTooltipEfficiency />} />\n                <Area \n                  type=\"monotone\" \n                  dataKey=\"controle\" \n                  stroke=\"#D8B36B\" \n                  strokeWidth={2}\n                  fillOpacity={1} \n                  fill=\"url(#colorControle)\" \n                  animationDuration={2000}\n                />\n              </AreaChart>\n            </ResponsiveContainer>\n          </div>\n        </div>\n\n      </div>\n    </section>\n  );\n}\n"
    }
