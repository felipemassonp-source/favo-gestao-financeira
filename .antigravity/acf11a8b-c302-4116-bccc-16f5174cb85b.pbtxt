      full: "import { useState, useRef, useEffect } from \"react\";import gsap from \"gsap\";import { useGSAP } from \"@gsap/react\";import { Check, ArrowRight } from \"lucide-react\";import { cn } from \"../lib/utils\";const steps = [  {    title: \"O Raio-X Simples\",    description: \"Em uma conversa amig\303\241vel e sem jarg\303\265es, entendemos de onde o dinheiro da sua empresa vem e para onde vai. Nada de planilhas chatas, n\303\263s fazemos o levantamento inicial.\"  },  {    title: \"A Regra de Ouro\",    description: \"Organizamos a casa separando o que \303\251 seu e o que \303\251 da empresa. Definimos o seu pr\303\263-labore (seu sal\303\241rio) de forma segura, com base no que o neg\303\263cio realmente pode pagar.\"  },  {    title: \"Ferramentas & Automa\303\247\303\243o\",    description: \"Implementamos sistemas visuais e f\303\241ceis de usar. O b\303\241sico bem feito com a tecnologia certa. Aquela burocracia que levava horas, agora toma apenas alguns minutos.\"  },  {    title: \"Lucro Claro e Estrat\303\251gia\",    description: \"Pronto! Voc\303\252 ganha tempo para focar em atender seus clientes, enquanto mostramos o seu lucro crescendo atrav\303\251s de an\303\241lises did\303\241ticas e super f\303\241ceis de entender.\"  }];export default function InteractiveJourney() {  const [activeStep, setActiveStep] = useState(0);  const progressCircleRef = useRef<SVGCircleElement>(null);  const contentRef = useRef<HTMLDivElement>(null);  const progress = ((activeStep + 1) / steps.length) * 100;  const circumference = 2 * Math.PI * 45; // radius = 45  useGSAP(() => {    if (progressCircleRef.current) {      const offset = circumference - (progress / 100) * circumference;      gsap.to(progressCircleRef.current, {        strokeDashoffset: offset,        duration: 1,        ease: \"power3.out\"      });    }  }, [progress, circumference]);  useGSAP(() => {    if (contentRef.current) {      gsap.fromTo(        contentRef.current,        { opacity: 0, y: 20 },        { opacity: 1, y: 0, duration: 0.6, ease: \"power2.out\" }      );    }  }, [activeStep]);  return (    <div className=\"bg-[#FFFFFF] border border-[#232A1B]/10 p-10 md:p-16 shadow-xl flex flex-col md:flex-row gap-12 items-center\">            {/* Gamified Progress Side */}      <div className=\"flex-shrink-0 flex flex-col items-center gap-6\">        <div className=\"relative w-40 h-40 flex items-center justify-center\">          {/* Background Circle */}          <svg className=\"w-full h-full transform -rotate-90\" viewBox=\"0 0 100 100\">            <circle              cx=\"50\"              cy=\"50\"              r=\"45\"              fill=\"transparent\"              stroke=\"#232A1B\"              strokeWidth=\"1\"              strokeOpacity=\"0.1\"            />            {/* Animated Progress Circle */}            <circle              ref={progressCircleRef}              cx=\"50\"              cy=\"50\"              r=\"45\"              fill=\"transparent\"              stroke=\"#D8B36B\"              strokeWidth=\"2\"              strokeDasharray={circumference}              strokeDashoffset={circumference}              strokeLinecap=\"round\"            />          </svg>          <div className=\"absolute inset-0 flex flex-col items-center justify-center text-[#232A1B]\">            <span className=\"text-4xl font-serif font-light\">{Math.round(progress)}%</span>            <span className=\"text-[8px] uppercase tracking-[0.2em] text-[#535458] mt-1\">Organizado</span>          </div>        </div>                <div className=\"flex gap-2\">          {steps.map((_, idx) => (            <button              key={idx}              onClick={() => setActiveStep(idx)}              className={cn(                \"w-2.5 h-2.5 rounded-full transition-all duration-300\",                idx === activeStep                   ? \"bg-[#D8B36B] scale-125\"                   : idx < activeStep                     ? \"bg-[#D8B36B]/40 cursor-pointer\"                     : \"bg-[#232A1B]/10 cursor-pointer hover:bg-[#232A1B]/20\"              )}              aria-label={`Ir para passo ${idx + 1}`}            />          ))}        </div>      </div>      {/* Content Side */}      <div className=\"flex-1 w-full border-t md:border-t-0 md:border-l border-[#232A1B]/10 pt-10 md:pt-0 md:pl-12 min-h-[220px] flex flex-col justify-center\">        <div ref={contentRef}>          <div className=\"flex items-center gap-3 mb-4\">            <span className=\"flex items-center justify-center w-6 h-6 rounded-full bg-[#F7F6EE] border border-[#232A1B]/10 text-[10px] font-serif text-[#D8B36B]\">              {activeStep + 1}            </span>            <span className=\"text-[10px] uppercase tracking-[0.2em] font-light text-[#D8B36B]\">              Passo a Passo            </span>          </div>          <h3 className=\"text-2xl md:text-3xl font-serif uppercase tracking-widest font-light text-[#232A1B] mb-6\">            {steps[activeStep].title}          </h3>          <p className=\"text-sm font-light text-[#535458] leading-relaxed tracking-wide\">            {steps[activeStep].description}          </p>                    <button             onClick={() => setActiveStep(prev => Math.min(prev + 1, steps.length - 1))}            disabled={activeStep === steps.length - 1}            className={cn(              \"mt-8 flex items-center gap-2 text-xs uppercase tracking-[0.1em] transition-all duration-300\",              activeStep === steps.length - 1                 ? \"text-[#D8B36B] opacity-100 cursor-default\"                 : \"text-[#232A1B] hover:text-[#D8B36B] hover:gap-4\"            )}          >            {activeStep === steps.length - 1 ? (              <>                <Check className=\"w-4 h-4\" /> Jornada Conclu\303\255da              </>            ) : (              <>                Avan\303\247ar Passo <ArrowRight className=\"w-4 h-4\" />              </>            )}          </button>        </div>      </div>    </div>  );}"
    }
