        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    // 3. Observer API Interactive Data Section"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    // Instead of normal scroll, we listen to swipe/wheel events to toggle data panels"
