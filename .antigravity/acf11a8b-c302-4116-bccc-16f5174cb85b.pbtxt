          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            Andryelle<br/><span className=\"italic lowercase text-[#D8B36B]\">Niederauer</span>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          </h3>"
