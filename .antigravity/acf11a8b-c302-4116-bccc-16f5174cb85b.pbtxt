        replacement_content: "  return (\n    <div ref={container} className=\"w-full min-h-screen pt-40 pb-20 bg-[#050505]\">\n      <div className=\"max-w-7xl mx-auto px-6\">\n        <h1 ref={titleRef} className=\"text-6xl md:text-8xl font-serif font-light tracking-widest mb-12 uppercase\">\n          Consultoria<br/> <span className=\"text-[#B89C72] italic lowercase\">Financeira</span>\n        </h1>\n        <p className=\"subtitle text-sm md:text-base font-light text-[#E5E5E5]/50 max-w-2xl leading-relaxed mb-32 opacity-0 tracking-wide\">\n          A Favo atua lado a lado com os gestores para entender a fundo o modelo de neg\303\263cio, \n          identificar inefici\303\252ncias e projetar cen\303\241rios que garantam a sustentabilidade e \n          o crescimento do capital corporativo em ambientes de alta complexidade.\n        </p>\n\n        {/* ScrollTrigger Pinned Section Example */}\n        <div className=\"pin-section flex flex-col md:flex-row gap-16 items-center min-h-[80vh] bg-[#0A0A0A] p-16 border border-white/5\">\n          <div className=\"flex-1\">\n            <span className=\"text-[#B89C72] text-[10px] uppercase tracking-[0.3em] mb-6 block\">O Processo</span>\n            <h2 className=\"text-4xl font-serif font-light mb-8 uppercase tracking-widest\">Metodologia</h2>\n            <p className=\"text-[#E5E5E5]/50 text-sm font-light leading-relaxed mb-8 tracking-wide max-w-md\">\n              Atrav\303\251s de uma abordagem consultiva baseada em dados reais, estruturamos a intelig\303\252ncia financeira \n              que a sua empresa precisa para tomar decis\303\265es seguras. Role para explorar as etapas.\n            </p>\n          </div>\n          <div className=\"flex-1 flex flex-col gap-px bg-white/5 border border-white/5 w-full\">\n            {processes.map((proc, idx) => (\n              <div key={idx} className=\"process-item flex items-center gap-6 bg-[#050505] p-8 hover:bg-[#0A0A0A] transition-colors\">\n                <span className=\"text-[#B89C72] text-[10px] tracking-widest font-light\">0{idx + 1}</span>\n                <span className=\"text-sm font-light tracking-wider uppercase\">{proc}</span>\n              </div>\n            ))}\n          </div>\n        </div>\n      </div>\n    </div>\n  );"
      }
      num_matches: 1
    }
  }
