        lines {
          text: "    question: \"Como a Favo garante a seguran\303\247a e o sigilo das minhas informa\303\247\303\265es financeiras?\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    answer: \"A confidencialidade \303\251 a base do nosso neg\303\263cio. Trabalhamos com rigorosos Contratos de Confidencialidade (NDA) assinados antes de qualquer troca de dados. Toda a comunica\303\247\303\243o e acesso aos sistemas ocorrem em ambiente seguro, com permiss\303\265es restritas exclusivamente aos analistas seniores dedicados \303\240 sua conta.\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
