ff0] hover:border-[#D8B36B] transition-all duration-300\">              <MessageCircle className=\"w-4 h-4\" />            </a>          </div>        </div>        {/* Quick Links */}        <div>          <h4 className=\"font-light uppercase tracking-[0.2em] text-[10px] mb-6 text-[#D8B36B]\">Navega\303\247\303\243o</h4>          <ul className=\"space-y-4 text-[#4e653d] text-xs font-light tracking-wide\">            <li><Link to=\"/\" className=\"hover:text-[#472f5b] hover:pl-2 transition-all duration-300 block\">In\303\255cio</Link></li>            <li><Link to=\"/gestao-financeira\" className=\"hover:text-[#472f5b] hover:pl-2 transition-all duration-300 block\">Gest\303\243o Financeira</Link></li>            <li><Link to=\"/consultoria\" className=\"hover:text-[#472f5b] hover:pl-2 transition-all duration-300 block\">Consultoria</Link></li>            <li><a href=\"/#contato\" className=\"hover:text-[#472f5b] hover:pl-2 transition-all duration-300 block\">Fale Conosco</a></li>          </ul>        </div>        {/* Services */}        <div>          <h4 className=\"font-light uppercase tracking-[0.2em] text-[10px] mb-6 text-[#D8B36B]\">Solu\303\247\303\265es</h4>          <ul className=\"space-y-4 text-[#4e653d] text-xs font-light tracking-wide\">            <li><Link to=\"/gestao-financeira\" className=\"hover:text-[#472f5b] hover:pl-2 transition-all duration-300 block\">BPO Financeiro</Link></li>            <li><Link to=\"/consultoria\" className=\"hover:text-[#472f5b] hover:pl-2 transition-all duration-300 block\">Consultoria Estrat\303\251gica</Link></li>            <li><Link to=\"/consultoria\" className=\"hover:text-[#472f5b] hover:pl-2 transition-all duration-300 block\">Diagn\303\263stico Financeiro</Link></li>            <li><Link to=\"/gestao-financeira\" className=\"hover:text-[#472f5b] hover:pl-2 transition-all duration-300 block\">An\303\241lise de Dados</Link></li>          </ul>        </div>        {/* Contact */}        <div>          <h4 classNa