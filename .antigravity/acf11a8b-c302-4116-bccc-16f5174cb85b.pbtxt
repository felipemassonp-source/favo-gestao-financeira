    combined_output {
      full: "import { useRef } from \"react\";import gsap from \"gsap\";import { ScrollTrigger } from \"gsap/ScrollTrigger\";import { useGSAP } from \"@gsap/react\";import SplitType from \"split-type\";import { CheckCircle2 } from \"lucide-react\";gsap.registerPlugin(ScrollTrigger);export default function Consultoria() {  const container = useRef<HTMLDivElement>(null);  const titleRef = useRef<HTMLHeadingElement>(null);  const isInitialLoad = !sessionStorage.getItem(\'favo_visited\');  const initialDelay = isInitialLoad ? 2.4 : 0.2;  useGSAP(() => {    // Split Text animation for title    if (titleRef.current) {      const text = new SplitType(titleRef.current, { types: \'lines,words,chars\' });            text.lines?.forEach((line) => {        const wrapper = document.createElement(\'div\');        wrapper.style.overflow = \'hidden\';        line.parentNode?.insertBefore(wrapper, line);        wrapper.appendChild(line);      });      gsap.fromTo(\".subtitle\",         { opacity: 0, y: 30 },        { opacity: 1, y: 0, duration: 1.5, ease: \"power3.out\", delay: initialDelay + 1.0 }      );      gsap.from(text.chars, {        opacity: 0,        y: \"100%\",        rotationZ: 2,        stagger: 0.02,        duration: 1.4,        ease: \"power4.out\",        delay: initialDelay      });    }    // High-end section title animations    const sectionTitles = gsap.utils.toArray(\'.section-title\');    sectionTitles.forEach((title: any) => {      const splitTitle = new SplitType(title, { types: \'lines,words\' });            splitTitle.lines?.forEach((line) => {        const wrapper = document.createElement(\'div\');        wrapper.style.overflow = \'hidden\';        line.parentNode?.insertBefore(wrapper, line);        wrapper.appendChild(line);      });      gsap.from(splitTitle.words, {        scrollTrigger: {          trigger: title,          start: \"top 85%\",        },        y: \"100%\",        opacity: 0,        duration: 1.2,        stagger: 0.05,        ease: \"power4.out\"      });    });    // Pinned section animation    ScrollTrigger.create({      trigger: \".pin-section\",      start: \"top top\",      end: \"+=100%\",      pin: true,      pinSpacing: true,    });    const items = gsap.utils.toArray(\'.process-item\');    items.forEach((item: any, i) => {      gsap.from(item, {        scrollTrigger: {          trigger: item,          start: \"top 80%\",        },        opacity: 0,        y: 30,        duration: 1,        ease: \"power3.out\",        delay: i * 0.1,      });    });  }, { scope: container });  const processes = [    \"Diagn\303\263stico Financeiro Completo\",    \"Mapeamento de Processos Atuais\",    \"Estrutura\303\247\303\243o de DRE e Fluxo de Caixa\",    \"Defini\303\247\303\243o de KPIs e Metas\",    \"Acompanhamento Estrat\303\251gico Mensal\"  ];  return (    <div ref={container} className=\"w-full min-h-screen pt-40 pb-20 bg-[#F7F6EE]\">      <div className=\"max-w-7xl mx-auto px-6\">        <h1 ref={titleRef} className=\"text-6xl md:text-8xl font-serif font-light tracking-widest mb-12 uppercase text-[#232A1B]\">          Consultoria<br/> <span className=\"text-[#D8B36B] italic lowercase\">Financeira</span>        </h1>        <p className=\"subtitle text-sm md:text-base font-light text-[#535458] max-w-2xl leading-relaxed mb-32 opacity-0 tracking-wide\">          A Favo atua lado a lado com os gestores para entender a fundo o modelo de neg\303\263cio,           identificar inefici\303\252ncias e projetar cen\303\241rios que garantam a sustentabilidade e           o crescimento do capital corporativo em ambientes de alta complexidade.        </p>        {/* ScrollTrigger Pinned Section Example */}        <div className=\"pin-section flex flex-col md:flex-row gap-16 items-center min-h-[80vh] bg-[#FFFFFF] p-16 border border-[#232A1B]/10 shadow-xl\">          <div className=\"flex-1\">            <span className=\"text-[#D8B36B] text-[10px] uppercase tracking-[0.3em] mb-6 block\">O Processo</span>            <h2 className=\"section-title text-4xl font-serif font-light mb-8 uppercase tracking-widest text-[#232A1B]\">Metodologia</h2>            <p className=\"text-[#535458] text-sm font-light leading-relaxed mb-8 tracking-wide max-w-md\">              Atrav\303\251s de uma abordagem consultiva baseada em dados reais, estruturamos a intelig\303\252ncia financeira               que a sua empresa precisa para tomar decis\303\265es seguras. Role para explorar as etapas.            </p>          </div>          <div className=\"flex-1 flex flex-col gap-px bg-[#232A1B]/10 border border-[#232A1B]/10 w-full\">            {processes.map((proc, idx) => (              <div key={idx} className=\"process-item flex items-center gap-6 bg-[#FFFFFF] p-8 hover:bg-[#FDFCFB] transition-colors\">                <span className=\"text-[#D8B36B] text-[10px] tracking-widest font-light\">0{idx + 1}</span>                <span className=\"text-sm font-light tracking-wider uppercase text-[#232A1B]\">{proc}</span>              </div>            ))}          </div>        </div>      </div>    </div>  );}"
    }
