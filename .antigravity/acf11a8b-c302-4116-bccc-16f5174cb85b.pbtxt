    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useRef } from \"react\";\nimport gsap from \"gsap\";\nimport { ScrollTrigger } from \"gsap/ScrollTrigger\";\nimport { useGSAP } from \"@gsap/react\";\nimport SplitType from \"split-type\";\nimport InteractiveJourney from \"../components/InteractiveJourney\";\nimport MagneticButton from \"../components/MagneticButton\";\nimport { Link } from \"react-router-dom\";\n\ngsap.registerPlugin(ScrollTrigger);\n\nexport default function Consultoria() {\n  const container = useRef<HTMLDivElement>(null);\n  const titleRef = useRef<HTMLHeadingElement>(null);\n\n  const isInitialLoad = !sessionStorage.getItem(\'favo_visited\');\n  const initialDelay = isInitialLoad ? 2.4 : 0.2;\n\n  useGSAP(() => {\n    // Split Text animation for title\n    if (titleRef.current) {\n      const text = new SplitType(titleRef.current, { types: \'lines,words,chars\' });\n      \n      text.lines?.forEach((line) => {\n        const wrapper = document.createElement(\'div\');\n        wrapper.style.overflow = \'hidden\';\n        line.parentNode?.insertBefore(wrapper, line);\n        wrapper.appendChild(line);\n      });\n\n      gsap.fromTo(\".subtitle\", \n        { opacity: 0, y: 30 },\n        { opacity: 1, y: 0, duration: 1.5, ease: \"power3.out\", delay: initialDelay + 1.0 }\n      );\n\n      gsap.from(text.chars, {\n        opacity: 0,\n        y: \"100%\",\n        rotationZ: 2,\n        stagger: 0.02,\n        duration: 1.4,\n        ease: \"power4.out\",\n        delay: initialDelay\n      });\n    }\n\n    // High-end section title animations\n    const sectionTitles = gsap.utils.toArray(\'.section-title\');\n    sectionTitles.forEach((title: any) => {\n      const splitTitle = new SplitType(title, { types: \'lines,words\' });\n      \n      splitTitle.lines?.forEach((line) => {\n        const wrapper = document.createElement(\'div\');\n        wrapper.style.overflow = \'hidden\';\n        line.parentNode?.insertBefore(wrapper, line);\n        wrapper.appendChild(line);\n      });\n\n      gsap.from(splitTitle.words, {\n        scrollTrigger: {\n          trigger: title,\n          start: \"top 85%\",\n        },\n        y: \"100%\",\n        opacity: 0,\n        duration: 1.2,\n        stagger: 0.05,\n        ease: \"power4.out\"\n      });\n    });\n\n  }, { scope: container });\n\n  return (\n    <div ref={container} className=\"w-full min-h-screen pt-40 pb-20 bg-[#F7F6EE]\">\n      <div className=\"max-w-7xl mx-auto px-6\">\n        \n        {/* Hero Section */}\n        <h1 ref={titleRef} className=\"text-6xl md:text-8xl font-serif font-light tracking-widest mb-12 uppercase text-[#232A1B]\">\n          Consultoria<br/> <span className=\"text-[#D8B36B] italic lowercase\">Descomplicada</span>\n        </h1>\n        <p className=\"subtitle text-sm md:text-base font-light text-[#535458] max-w-2xl leading-relaxed mb-32 opacity-0 tracking-wide\">\n          Estrat\303\251gias simples, ferramentas certas e o b\303\241sico bem feito. Ajudamos voc\303\252 a organizar sua casa financeira e ver o lucro real do seu trabalho, sem jarg\303\265es ou planilhas que d\303\243o dor de cabe\303\247a.\n        </p>\n\n        {/* Gamified Journey Section */}\n        <div className=\"py-20 border-t border-[#232A1B]/10\">\n          <div className=\"flex flex-col md:flex-row md:items-end justify-between gap-8 mb-16\">\n            <div>\n              <span className=\"text-[#D8B36B] text-[10px] uppercase tracking-[0.3em] mb-6 block\">Como Funciona</span>\n              <h2 className=\"section-title text-4xl md:text-5xl font-serif font-light uppercase tracking-widest text-[#232A1B]\">\n                Desbloqueie<br/><span className=\"italic lowercase text-[#D8B36B]\">seu Lucro</span>\n              </h2>\n            </div>\n            <p className=\"text-[#535458] text-sm font-light leading-relaxed tracking-wide max-w-sm\">\n              Um m\303\251todo robusto disfar\303\247ado de simplicidade. Em 4 passos interativos, veja como transformamos a burocracia do seu dia a dia em uma rotina leve e lucrativa.\n            </p>\n          </div>\n\n          <InteractiveJourney />\n        </div>\n\n        {/* Benefits / Value Section */}\n        <div className=\"py-32 border-t border-[#232A1B]/10 mt-16\">\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-16\">\n            <div>\n              <span className=\"text-[#D8B36B] text-[10px] uppercase tracking-[0.2em] mb-4 block border-b border-[#D8B36B]/30 pb-4 w-12\"></span>\n              <h3 className=\"text-xl font-serif uppercase tracking-widest font-light text-[#232A1B] mb-4\">\n                O B\303\241sico que Funciona\n              </h3>\n              <p className=\"text-sm font-light text-[#535458] leading-relaxed tracking-wide\">\n                N\303\243o reinventamos a roda, n\303\263s fazemos ela girar. Focamos no feij\303\243o com arroz das finan\303\247as que a maioria n\303\243o faz: separar contas, precificar certo e controlar gastos.\n              </p>\n            </div>\n            <div>\n              <span className=\"text-[#D8B36B] text-[10px] uppercase tracking-[0.2em] mb-4 block border-b border-[#D8B36B]/30 pb-4 w-12\"></span>\n              <h3 className=\"text-xl font-serif uppercase tracking-widest font-light text-[#232A1B] mb-4\">\n                Ferramentas Certas\n              </h3>\n              <p className=\"text-sm font-light text-[#535458] leading-relaxed tracking-wide\">\n                Voc\303\252 n\303\243o precisa ser um mestre do Excel. N\303\263s implementamos sistemas simples e intuitivos que automatizam a burocracia, devolvendo horas preciosas para o seu dia.\n              </p>\n            </div>\n            <div>\n              <span className=\"text-[#D8B36B] text-[10px] uppercase tracking-[0.2em] mb-4 block border-b border-[#D8B36B]/30 pb-4 w-12\"></span>\n              <h3 className=\"text-xl font-serif uppercase tracking-widest font-light text-[#232A1B] mb-4\">\n                Retorno Absoluto\n              </h3>\n              <p className=\"text-sm font-light text-[#535458] leading-relaxed tracking-wide\">\n                A consultoria se paga rapidamente quando voc\303\252 descobre onde o dinheiro estava vazando e passa a precificar seus servi\303\247os com base na sua margem de lucro real.\n              </p>\n            </div>\n          </div>\n        </div>\n\n        {/* CTA */}\n        <div className=\"py-24 border-t border-[#232A1B]/10 flex flex-col items-center justify-center text-center\">\n          <h2 className=\"section-title text-4xl font-serif font-light uppercase tracking-widest text-[#232A1B] mb-12\">\n            Vamos arrumar<br/><span className=\"italic lowercase text-[#D8B36B]\">a casa?</span>\n          </h2>\n          <MagneticButton>\n            <Link to=\"/#contato\" className=\"border border-[#232A1B]/20 px-12 py-5 text-xs uppercase tracking-[0.2em] hover:border-[#D8B36B] hover:text-[#D8B36B] transition-colors font-light rounded-full bg-[#FFFFFF] shadow-sm\">\n              Agendar Diagn\303\263stico Gratuito\n            </Link>\n          </MagneticButton>\n        </div>\n\n      </div>\n    </div>\n  );\n}\n"
    }
