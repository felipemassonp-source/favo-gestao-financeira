      <label className=\"text-xs uppercase tracking-widest font-light text-[#472f5b]\">E-mail Profissional</label>                <input                   required                  type=\"email\"                  value={formData.email}                  onChange={(e) => setFormData({...formData, email: e.target.value})}                  className=\"w-full bg-transparent border-b border-[#472f5b]/20 py-3 text-sm text-[#472f5b] focus:outline-none focus:border-[#D8B36B] transition-colors\"                  placeholder=\"seu@email.com.br\"                />              </div>              <div className=\"space-y-2\">                <label className=\"text-xs uppercase tracking-widest font-light text-[#472f5b]\">Nome da Empresa</label>                <input                   required                  type=\"text\"                  value={formData.empresa}                  onChange={(e) => setFormData({...formData, empresa: e.target.value})}                  className=\"w-full bg-transparent border-b border-[#472f5b]/20 py-3 text-sm text-[#472f5b] focus:outline-none focus:border-[#D8B36B] transition-colors\"                  placeholder=\"Sua marca\"                />              </div>              <div className=\"pt-6\">                <button                   type=\"submit\"                  className=\"w-full flex items-center justify-center gap-4 bg-[#472f5b] text-[#fffff0] py-4 text-xs uppercase tracking-[0.2em] font-light hover:bg-[#4e653d] transition-colors\"                >                  Pr\303\263ximo Passo <ArrowRight className=\"w-4 h-4\" />                </button>              </div>            </form>          )}          {step === 2 && (            <form onSubmit={handleSubmit} className=\"space-y-8 animate-in fade-in slide-in-from-right-4 duration-500\">                            {/* Question 1 */}              <div className=\"space-y-4\">                <label className=\"text-sm font-serif tracking-wide text-[#472f5b] block\">                  1. {questions.q1.label}                </label>                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3\">                  {questions.q1.options.map((opt) => (                    <button                      type=\"button\"                      key={opt}                      onClick={() => setFormData({...formData, dorPrincipal: opt})}                      className={cn(                        \"text-left p-4 text-xs font-light tracking-wide border transition-all duration-300\",                        formData.dorPrincipal === opt                           ? \"border-[#D8B36B] bg-[#D8B36B]/5 text-[#472f5b]\"                           : \"border-[#472f5b]/10 text-[#4e653d] hover:border-[#472f5b]/30\"                      )}                    >                      {opt}                    </button>                  ))}                </div>              </div>              {/* Question 2 */}              <div className=\"space-y-4\">                <label className=\"text-sm font-serif tracking-wide text-[#472f5b] block\">                  2. {questions.q2.label}                </label>                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3\">                  {questions.q2.options.map((opt) => (                    <button                      type=\"button\"                      key={opt}                      onClick={() => setFormData({...formData, volumeOuControle: opt})}                      className={cn(                        \"text-left p-4 text-xs font-light tracking-wide border transition-all duration-300\",                        formData.volumeOuControle === opt                           ? \"border-[#D8B36B] bg-[#D8B36B]/5 text-[#472f5b]\"                           : \"border-[#472f5b]/10 text-[#4e653d] hover:border-[#472f5b]/30\"                      )}                    >                      {opt}                    </button>                  ))}                </div>              </div>              <div className=\"pt