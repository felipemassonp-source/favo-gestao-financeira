    replacement_infos {
      original_chunk {
        target_content: "      {/* Hero Section */}\n      <section className=\"relative h-screen flex flex-col justify-center px-6 max-w-7xl mx-auto\">\n        <div className=\"absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-amber-900/20 via-slate-950 to-slate-950\"></div>\n        <h1 \n          ref={heroTextRef} \n          className=\"text-5xl md:text-7xl lg:text-8xl font-bold tracking-tighter leading-[1.1] max-w-4xl\"\n          style={{ perspective: \"1000px\" }}\n        >\n          Intelig\303\252ncia Financeira para <span className=\"text-amber-500\">Resultados Exatos.</span>\n        </h1>\n        <p className=\"hero-sub mt-8 text-xl text-slate-400 max-w-2xl leading-relaxed\">\n          Transformamos dados complexos em estrat\303\251gias claras. Consultoria especializada para empresas que buscam crescimento sustent\303\241vel e m\303\241xima rentabilidade.\n        </p>\n        <div className=\"hero-cta mt-12 flex gap-4\">\n          <Link to=\"/consultoria\" className=\"px-8 py-4 rounded-full bg-amber-500 text-slate-950 font-bold hover:bg-amber-400 transition-colors flex items-center gap-2 group\">\n            Conhe\303\247a a Consultoria\n            <ArrowRight className=\"w-5 h-5 group-hover:translate-x-1 transition-transform\" />\n          </Link>\n        </div>\n      </section>"
        replacement_content: "      {/* Hero Section */}\n      <section className=\"relative h-screen flex flex-col justify-center px-6 max-w-7xl mx-auto overflow-hidden\">\n        <div className=\"absolute top-[-100px] right-[-100px] w-[400px] h-[400px] bg-[#14362D] opacity-[0.03] rounded-full blur-3xl pointer-events-none\"></div>\n        <div className=\"absolute bottom-[-50px] left-[-50px] w-[300px] h-[300px] bg-[#D4AF37] opacity-[0.05] rounded-full blur-3xl pointer-events-none\"></div>\n        <h1 \n          ref={heroTextRef} \n          className=\"text-5xl md:text-7xl lg:text-8xl font-light tracking-tighter leading-[0.9] max-w-4xl font-serif italic relative z-10\"\n          style={{ perspective: \"1000px\" }}\n        >\n          <span className=\"block opacity-100\">Intelig\303\252ncia</span>\n          <span className=\"block text-[#D4AF37] font-bold not-italic font-sans\">Financeira</span>\n          <span className=\"block\">Sob Medida.</span>\n        </h1>\n        <p className=\"hero-sub mt-8 text-lg text-[#14362D]/70 max-w-2xl leading-relaxed relative z-10\">\n          Transformamos dados complexos em decis\303\265es estrat\303\251gicas para impulsionar a sa\303\272de financeira do seu neg\303\263cio com precis\303\243o e transpar\303\252ncia.\n        </p>\n        <div className=\"hero-cta mt-12 flex gap-4 relative z-10\">\n          <Link to=\"/consultoria\" className=\"px-6 py-3 rounded-full bg-[#14362D] text-white font-bold text-xs uppercase tracking-widest hover:bg-[#1B4332] transition-colors shadow-lg\">\n            Consultoria\n          </Link>\n        </div>\n      </section>"
