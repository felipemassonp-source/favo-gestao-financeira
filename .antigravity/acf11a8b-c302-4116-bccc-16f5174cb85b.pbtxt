  run_command {
    cwd: "."
    exit_code: 0
    blocking: true
    wait_ms_before_async: 5000
    combined_output {
      full: "import { useRef } from \"react\";import gsap from \"gsap\";import { ScrollTrigger } from \"gsap/ScrollTrigger\";import { useGSAP } from \"@gsap/react\";import SplitType from \"split-type\";import MagneticButton from \"../components/MagneticButton\";import { Link } from \"react-router-dom\";import { Check } from \"lucide-react\";import TangibleResults from \"../components/TangibleResults\";import ImpactMetrics from \"../components/ImpactMetrics\";import OnboardingJourney from \"../components/OnboardingJourney\";import FinancialBenefits from \"../components/FinancialBenefits\";import RiskAwareness from \"../components/RiskAwareness\";import Testimonials from \"../components/Testimonials\";import LeadCaptureForm from \"../components/LeadCaptureForm\";gsap.registerPlugin(ScrollTrigger);const tasks = [  \"Controle de fluxo de caixa\",  \"Gest\303\243o de contas a pagar\",  \"Gest\303\243o de contas a receber\",  \"Emiss\303\243o de nota fiscal\",  \"Emiss\303\243o de boletos e relat\303\263rios\",  \"Gr\303\241fico de resultados\",  \"Apoio cont\303\241bil\",  \"Controle de inadimpl\303\252ncia\",  \"Controle de cart\303\243o de cr\303\251dito\",  \"Controle or\303\247ament\303\241rio\",  \"Controle de metas\",  \"Distribui\303\247\303\243o de despesas por projetos\",  \"Fechamento de documentos banc\303\241rios mensais\",  \"Controle de notas de despesas\"];export default function GestaoFinanceira() {  const container = useRef<HTMLDivElement>(null);  const titleRef = useRef<HTMLHeadingElement>(null);  const isInitialLoad = !sessionStorage.getItem(\'favo_visited\');  const initialDelay = isInitialLoad ? 2.4 : 0.2;  useGSAP(() => {    if (titleRef.current) {      const text = new SplitType(titleRef.current, { types: \'lines,words,chars\' });            text.lines?.forEach((line) => {        const wrapper = document.createElement(\'div\');        wrapper.style.overflow = \'hidden\';        line.parentNode?.insertBefore(wrapper, line);        wrapper.appendChild(line);      });      gsap.fromTo(\".subtitle\",         { opacity: 0, y: 30 },        { opacity: 1, y: 0, duration: 1.5, ease: \"power3.out\", delay: initialDelay + 1.0 }      );      gsap.from(text.chars, {        opacity: 0,        y: \"100%\",        rotationZ: 2,        stagger: 0.02,        duration: 1.4,        ease: \"power4.out\",        delay: initialDelay      });    }    const taskItems = gsap.utils.toArray(\'.task-item\');    gsap.from(taskItems, {      scrollTrigger: {        trigger: \".tasks-grid\",        start: \"top 85%\",      },      opacity: 0,      y: 20,      duration: 0.8,      stagger: 0.08,      ease: \"power3.out\"    });  }, { scope: container });  return (    <div ref={container} className=\"w-full min-h-screen pt-40 pb-20 bg-[#fffff0]\">      <div className=\"max-w-7xl mx-auto px-6\">                {/* Hero Section */}        <div className=\"flex items-center gap-4 mb-8\">          <span className=\"h-[1px] w-12 bg-[#D8B36B]\"></span>          <span className=\"text-[10px] uppercase tracking-[0.3em] font-light text-[#D8B36B]\">Terceiriza\303\247\303\243o / BPO</span>        </div>                <h1 ref={titleRef} className=\"text-6xl md:text-8xl font-serif font-light tracking-widest mb-12 uppercase text-[#472f5b] max-w-5xl\">          Gest\303\243o<br/> <span className=\"text-[#D8B36B] italic lowercase\">Financeira</span>        </h1>        <p className=\"subtitle text-sm md:text-base font-light text-[#4e653d] max-w-2xl leading-relaxed mb-24 opacity-0 tracking-wide\">          Um servi\303\247o mensal e recorrente onde assumimos o acompanhamento di\303\241rio da sua empresa.           Tiramos a burocracia das suas m\303\243os para que voc\303\252 tenha paz de esp\303\255rito e foque exclusivamente no atendimento aos seus clientes e crescimento do neg\303\263cio.        </p>        {/* Animated Impact Metrics */}        <ImpactMetrics />        {/* Risk Awareness Section */}        <RiskAwareness />        {/* Features Grid */}        <div className=\"py-20 border-t border-[#472f5b]/10 mt-16\">          <div className=\"flex flex-col md:flex-row md:items-end justify-between gap-8 mb-20\">            <div>              <span className=\"text-[#D8B36B] text-[10px] uppercase tracking-[0.3em] mb-6 block\">O que est\303\241 incluso</span>              <h2 className=\"text-4xl md:text-5xl font-serif font-light uppercase tracking-widest text-[#472f5b]\">                Nossa rotina,<br/><span className=\"italic lowercase text-[#D8B36B]\">seu tempo livre</span>              </h2>            </div>            <p className=\"text-[#4e653d] text-sm font-light leading-relaxed tracking-wide max-w-sm\">              Mais do que pagar contas, n\303\263s estruturamos e acompanhamos cada centavo que entra e sai. Entregamos clareza visual e controle absoluto.            </p>          </div>          <div className=\"tasks-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-4\">            {tasks.map((task, idx) => (              <div                 key={idx}                 className=\"task-item flex items-start gap-4 p-6 bg-[#FFFFFF] border border-[#472f5b]/5 hover:border-[#D8B36B]/50 transition-colors group\"              >                <div className=\"mt-0.5 flex-shrink-0 w-5 h-5 rounded-full border border-[#D8B36B] flex items-center justify-center bg-[#D8B36B]/10 group-hover:scale-110 transition-transform\">                  <Check strokeWidth={2.5} className=\"w-2.5 h-2.5 text-[#D8B36B]\" />                </div>                <span className=\"text-sm font-light tracking-wide text-[#472f5b]\">{task}</span>              </div>            ))}          </div>        </div>        {/* Financial Benefits Section */}        <FinancialBenefits />        {/* Onboarding Journey */}        <OnboardingJourney />        {/* Tangible Results Charts */}        <TangibleResults />        {/* Testimonials */}        <div className=\"-mx-6\">          <Testimonials showPricing={true} />        </div>  