    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useRef } from \"react\";\nimport gsap from \"gsap\";\nimport { ScrollTrigger } from \"gsap/ScrollTrigger\";\nimport { useGSAP } from \"@gsap/react\";\n\ngsap.registerPlugin(ScrollTrigger);\n\nconst stats = [\n  {\n    value: \"100%\",\n    label: \"Foco no Cliente\",\n    description: \"N\303\263s assumimos a burocracia para voc\303\252 focar apenas no que faz de melhor.\"\n  },\n  {\n    value: \"+50\",\n    label: \"Neg\303\263cios Organizados\",\n    description: \"Prestadores de servi\303\247os que conquistaram paz de esp\303\255rito financeira.\"\n  },\n  {\n    value: \"Zero\",\n    label: \"Jarg\303\265es Complexos\",\n    description: \"Comunica\303\247\303\243o simples, direta e desenhada para n\303\243o-financeiros.\"\n  },\n  {\n    value: \"24/7\",\n    label: \"Tranquilidade\",\n    description: \"A certeza de que as contas da sua empresa est\303\243o separadas, em dia e seguras.\"\n  }\n];\n\nexport default function TrustIndicators() {\n  const containerRef = useRef<HTMLDivElement>(null);\n\n  useGSAP(() => {\n    const indicators = gsap.utils.toArray(\'.trust-indicator\');\n    \n    gsap.from(indicators, {\n      scrollTrigger: {\n        trigger: containerRef.current,\n        start: \"top 85%\",\n      },\n      opacity: 0,\n      y: 40,\n      duration: 1.2,\n      stagger: 0.15,\n      ease: \"power4.out\"\n    });\n  }, { scope: containerRef });\n\n  return (\n    <section ref={containerRef} className=\"py-24 px-6 max-w-7xl mx-auto border-t border-[#232A1B]/10\">\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-16 lg:gap-8\">\n        {stats.map((stat, i) => (\n          <div key={i} className=\"trust-indicator flex flex-col items-center text-center\">\n            <span className=\"text-6xl md:text-7xl font-serif text-[#D8B36B] mb-6 block font-light\">\n              {stat.value}\n            </span>\n            <span className=\"text-[10px] uppercase tracking-[0.2em] font-light text-[#232A1B] mb-4 block border-b border-[#D8B36B]/30 pb-4 w-12\">\n            </span>\n            <span className=\"text-sm font-serif uppercase tracking-widest text-[#232A1B] mb-3 block\">\n              {stat.label}\n            </span>\n            <p className=\"text-xs text-[#535458] font-light tracking-wide leading-relaxed max-w-[220px]\">\n              {stat.description}\n            </p>\n          </div>\n        ))}\n      </div>\n    </section>\n  );\n}\n"
    }
