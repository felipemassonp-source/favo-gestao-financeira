  view_file {
    absolute_path_uri: "file:///src/pages/GestaoFinanceira.tsx"
    end_line: 203
    content: "import FadeInUp from \"../components/FadeInUp\";\nimport { useRef } from \"react\";\nimport gsap from \"gsap\";\nimport { ScrollTrigger } from \"gsap/ScrollTrigger\";\nimport { useGSAP } from \"@gsap/react\";\nimport SplitType from \"split-type\";\nimport MagneticButton from \"../components/MagneticButton\";\nimport { Link } from \"react-router-dom\";\nimport { Check } from \"lucide-react\";\n\nimport TangibleResults from \"../components/TangibleResults\";\nimport ImpactMetrics from \"../components/ImpactMetrics\";\nimport OnboardingJourney from \"../components/OnboardingJourney\";\nimport FinancialBenefits from \"../components/FinancialBenefits\";\nimport RiskAwareness from \"../components/RiskAwareness\";\n\nimport Testimonials from \"../components/Testimonials\";\nimport LeadCaptureForm from \"../components/LeadCaptureForm\";\nimport TrustBadges from \"../components/TrustBadges\";\nimport SecurityGuarantee from \"../components/SecurityGuarantee\";\nimport FinancialIllustration from \"../components/FinancialIllustration\";\nimport FAQ from \"../components/FAQ\";\n\ngsap.registerPlugin(ScrollTrigger);\n\nconst tasks = [\n  \"Controle de fluxo de caixa\",\n  \"Gest\303\243o de contas a pagar\",\n  \"Gest\303\243o de contas a receber\",\n  \"Emiss\303\243o de nota fiscal\",\n  \"Emiss\303\243o de boletos e relat\303\263rios\",\n  \"Gr\303\241fico de resultados\",\n  \"Apoio cont\303\241bil\",\n  \"Controle de inadimpl\303\252ncia\",\n  \"Controle de cart\303\243o de cr\303\251dito\",\n  \"Controle or\303\247ament\303\241rio\",\n  \"Controle de metas\",\n  \"Distribui\303\247\303\243o de despesas por projetos\",\n  \"Fechamento de documentos banc\303\241rios mensais\",\n  \"Controle de notas de despesas\"\n];\n\nexport default function GestaoFinanceira() {\n  const container = useRef<HTMLDivElement>(null);\n  const titleRef = useRef<HTMLHeadingElement>(null);\n\n  const isInitialLoad = !sessionStorage.getItem(\'favo_visited\');\n  const initialDelay = isInitialLoad ? 2.4 : 0.2;\n\n  useGSAP(() => {\n    if (titleRef.current) {\n      const text = new SplitType(titleRef.current, { types: \'lines,words,chars\' });\n      \n      text.lines?.forEach((line) => {\n        const wrapper = document.createElement(\'div\');\n        wrapper.style.overflow = \'hidden\';\n        line.parentNode?.insertBefore(wrapper, line);\n        wrapper.appendChild(line);\n      });\n\n      gsap.fromTo(\".subtitle\", \n        { opacity: 0, y: 30 },\n        { opacity: 1, y: 0, duration: 1.5, ease: \"power3.out\", delay: initialDelay + 1.0 }\n      );\n\n      gsap.from(text.chars, {\n        opacity: 0,\n        y: \"100%\",\n        rotationZ: 2,\n        stagger: 0.02,\n        duration: 1.4,\n        ease: \"power4.out\",\n        delay: initialDelay\n      });\n    }\n\n    const taskItems = gsap.utils.toArray(\'.task-item\');\n    gsap.from(taskItems, {\n      scrollTrigger: {\n        trigger: \".tasks-grid\",\n        start: \"top 85%\",\n      },\n      opacity: 0,\n      y: 20,\n      duration: 0.8,\n      stagger: 0.08,\n      ease: \"power3.out\"\n    });\n\n  }, { scope: container });\n\n  return (\n    <div ref={container} className=\"w-full min-h-screen pt-40 pb-20 bg-[#fffff0]\">\n      <div className=\"max-w-7xl mx-auto px-6\">\n        \n        {/* Hero Section */}\n        <div className=\"flex items-center gap-4 mb-8\">\n          <span className=\"h-[1px] w-12 bg-[#D8B36B]\"></span>\n          <span className=\"text-[10px] uppercase tracking-[0.3em] font-light text-[#b2893d]\">Terceiriza\303\247\303\243o / BPO</span>\n        </div>\n        \n        <h1 ref={titleRef} className=\"text-6xl md:text-8xl font-serif font-light tracking-widest mb-12 uppercase text-[#472f5b] max-w-5xl\">\n          Gest\303\243o<br/> <span className=\"text-[#b2893d] italic lowercase\">Financeira</span>\n        </h1>\n        <p className=\"subtitle text-sm md:text-base font-light text-[#2a3a1e] max-w-2xl leading-relaxed mb-24 opacity-0 tracking-wide\">\n          Um servi\303\247o mensal e recorrente onde assumimos o acompanhamento di\303\241rio da sua empresa. \n          Tiramos a burocracia das suas m\303\243os para que voc\303\252 tenha paz de esp\303\255rito e foque exclusivamente no atendimento aos seus clientes e crescimento do neg\303\263cio.\n        </p>\n\n        {/* Animated Impact Metrics */}\n        <FadeInUp>\n          <ImpactMetrics />\n        </FadeInUp>\n\n        {/* Risk Awareness Section */}\n        <FadeInUp>\n          <RiskAwareness />\n        </FadeInUp>\n\n        {/* Features Grid */}\n        <div className=\"py-20 border-t border-[#472f5b]/10 mt-16\">\n          <div className=\"flex flex-col lg:flex-row gap-12 lg:gap-16 mb-20\">\n            <div className=\"lg:w-1/2\">\n              <span className=\"text-[#b2893d] text-[10px] uppercase tracking-[0.3em] mb-6 block\">O que est\303\241 incluso</span>\n              <h2 className=\"text-4xl md:text-5xl font-serif font-light uppercase tracking-widest text-[#472f5b] mb-8\">\n                Nossa rotina,<br/><span className=\"italic lowercase text-[#b2893d]\">seu tempo livre</span>\n              </h2>\n              <p className=\"text-[#2a3a1e] text-sm font-normal leading-relaxed tracking-wide max-w-md\">\n                Mais do que pagar contas, n\303\263s estruturamos e acompanhamos cada centavo que entra e sai. Entregamos clareza visual, concilia\303\247\303\265es banc\303\241rias rigorosas e relat\303\263rios financeiros detalhados para o seu controle absoluto.\n              </p>\n            </div>\n            <div className=\"lg:w-1/2\">\n              <FinancialIllustration />\n            </div>\n          </div>\n\n          <div className=\"tasks-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-4\">\n            {tasks.map((task, idx) => (\n              <div \n                key={idx} \n                className=\"task-item flex items-start gap-4 p-6 bg-[#FFFFFF] border border-[#472f5b]/5 hover:border-[#D8B36B]/50 transition-colors group\"\n              >\n                <div className=\"mt-0.5 flex-shrink-0 w-5 h-5 rounded-full border border-[#D8B36B] flex items-center justify-center bg-[#D8B36B]/10 group-hover:scale-110 transition-transform\">\n                  <Check strokeWidth={2.5} className=\"w-2.5 h-2.5 text-[#b2893d]\" />\n                </div>\n                <span className=\"text-sm font-normal tracking-wide text-[#472f5b]\">{task}</span>\n              </div>\n            ))}\n          </div>\n        </div>\n\n        {/* Financial Benefits Section */}\n        <FadeInUp>\n          <FinancialBenefits />\n        </FadeInUp>\n\n        {/* Security and Confidentiality Guarantee */}\n        <FadeInUp>\n          <SecurityGuarantee />\n        </FadeInUp>\n\n        {/* Onboarding Journey */}\n        <FadeInUp>\n          <OnboardingJourney />\n        </FadeInUp>\n\n        {/* Tangible Results Charts */}\n        <FadeInUp>\n          <TangibleResults />\n        </FadeInUp>\n\n        {/* Testimonials */}\n        <div className=\"-mx-6\">\n          <FadeInUp>\n            <Testimonials showPricing={true} />\n          </FadeInUp>\n        </div>\n\n        {/* FAQ Section */}\n        <FadeInUp>\n          <FAQ />\n        </FadeInUp>\n\n        {/* CTA */}\n        <div className=\"py-24 border-t border-[#472f5b]/10 mt-16\">\n          <FadeInUp>\n          <div className=\"flex flex-col items-center justify-center text-center mb-16\">\n            <h2 className=\"text-4xl font-serif font-light uppercase tracking-widest text-[#472f5b] mb-6\">\n              Pronto para <span className=\"italic lowercase text-[#b2893d]\">delegar?</span>\n            </h2>\n            <p className=\"text-[#2a3a1e] text-sm font-normal max-w-md tracking-wide\">\n              Pare de gastar seu tempo com planilhas e boletos. Preencha os dados abaixo e receba um diagn\303\263stico personalizado.\n            </p>\n          </div>\n          <LeadCaptureForm type=\"bpo\" />\n          <TrustBadges />\n          </FadeInUp>\n        </div>\n\n      </div>\n    </div>\n  );\n}\n"
    raw_content: "import FadeInUp from \"../components/FadeInUp\";\nimport { useRef } from \"react\";\nimport gsap from \"gsap\";\nimport { ScrollTrigger } from \"gsap/ScrollTrigger\";\nimport { useGSAP } from \"@gsap/react\";\nimport SplitType from \"split-type\";\nimport MagneticButton from \"../components/MagneticButton\";\nimport { Link } from \"react-router-dom\";\nimport { Check } from \"lucide-react\";\n\nimport TangibleResults from \"../components/TangibleResults\";\nimport ImpactMetrics from \"../components/ImpactMetrics\";\nimport OnboardingJourney from \"../components/OnboardingJourney\";\nimport FinancialBenefits from \"../components/FinancialBenefits\";\nimport RiskAwareness from \"../components/RiskAwareness\";\n\nimport Testimonials from \"../components/Testimonials\";\nimport LeadCaptureForm from \"../components/LeadCaptureForm\";\nimport TrustBadges from \"../components/TrustBadges\";\nimport SecurityGuarantee from \"../components/SecurityGuarantee\";\nimport FinancialIllustration from \"../components/FinancialIllustration\";\nimport FAQ from \"../components/FAQ\";\n\ngsap.registerPlugin(ScrollTrigger);\n\nconst tasks = [\n  \"Controle de fluxo de caixa\",\n  \"Gest\303\243o de contas a pagar\",\n  \"Gest\303\243o de contas a receber\",\n  \"Emiss\303\243o de nota fiscal\",\n  \"Emiss\303\243o de boletos e relat\303\263rios\",\n  \"Gr\303\241fico de resultados\",\n  \"Apoio cont\303\241bil\",\n  \"Controle de inadimpl\303\252ncia\",\n  \"Controle de cart\303\243o de cr\303\251dito\",\n  \"Controle or\303\247ament\303\241rio\",\n  \"Controle de metas\",\n  \"Distribui\303\247\303\243o de despesas por projetos\",\n  \"Fechamento de documentos banc\303\241rios mensais\",\n  \"Controle de notas de despesas\"\n];\n\nexport default function GestaoFinanceira() {\n  const container = useRef<HTMLDivElement>(null);\n  const titleRef = useRef<HTMLHeadingElement>(null);\n\n  const isInitialLoad = !sessionStorage.getItem(\'favo_visited\');\n  const initialDelay = isInitialLoad ? 2.4 : 0.2;\n\n  useGSAP(() => {\n    if (titleRef.current) {\n      const text = new SplitType(titleRef.current, { types: \'lines,words,chars\' });\n      \n      text.lines?.forEach((line) => {\n        const wrapper = document.createElement(\'div\');\n        wrapper.style.overflow = \'hidden\';\n        line.parentNode?.insertBefore(wrapper, line);\n        wrapper.appendChild(line);\n      });\n\n      gsap.fromTo(\".subtitle\", \n        { opacity: 0, y: 30 },\n        { opacity: 1, y: 0, duration: 1.5, ease: \"power3.out\", delay: initialDelay + 1.0 }\n      );\n\n      gsap.from(text.chars, {\n        opacity: 0,\n        y: \"100%\",\n        rotationZ: 2,\n        stagger: 0.02,\n        duration: 1.4,\n        ease: \"power4.out\",\n        delay: initialDelay\n      });\n    }\n\n    const taskItems = gsap.utils.toArray(\'.task-item\');\n    gsap.from(taskItems, {\n      scrollTrigger: {\n        trigger: \".tasks-grid\",\n        start: \"top 85%\",\n      },\n      opacity: 0,\n      y: 20,\n      duration: 0.8,\n      stagger: 0.08,\n      ease: \"power3.out\"\n    });\n\n  }, { scope: container });\n\n  return (\n    <div ref={container} className=\"w-full min-h-screen pt-40 pb-20 bg-[#fffff0]\">\n      <div className=\"max-w-7xl mx-auto px-6\">\n        \n        {/* Hero Section */}\n        <div className=\"flex items-center gap-4 mb-8\">\n          <span className=\"h-[1px] w-12 bg-[#D8B36B]\"></span>\n          <span className=\"text-[10px] uppercase tracking-[0.3em] font-light text-[#b2893d]\">Terceiriza\303\247\303\243o / BPO</span>\n        </div>\n        \n        <h1 ref={titleRef} className=\"text-6xl md:text-8xl font-serif font-light tracking-widest mb-12 uppercase text-[#472f5b] max-w-5xl\">\n          Gest\303\243o<br/> <span className=\"text-[#b2893d] italic lowercase\">Financeira</span>\n        </h1>\n        <p className=\"subtitle text-sm md:text-base font-light text-[#2a3a1e] max-w-2xl leading-relaxed mb-24 opacity-0 tracking-wide\">\n          Um servi\303\247o mensal e recorrente onde assumimos o acompanhamento di\303\241rio da sua empresa. \n          Tiramos a burocracia das suas m\303\243os para que voc\303\252 tenha paz de esp\303\255rito e foque exclusivamente no atendimento aos seus clientes e crescimento do neg\303\263cio.\n        </p>\n\n        {/* Animated Impact Metrics */}\n        <FadeInUp>\n          <ImpactMetrics />\n        </FadeInUp>\n\n        {/* Risk Awareness Section */}\n        <FadeInUp>\n          <RiskAwareness />\n        </FadeInUp>\n\n        {/* Features Grid */}\n        <div className=\"py-20 border-t border-[#472f5b]/10 mt-16\">\n          <div className=\"flex flex-col lg:flex-row gap-12 lg:gap-16 mb-20\">\n            <div className=\"lg:w-1/2\">\n              <span className=\"text-[#b2893d] text-[10px] uppercase tracking-[0.3em] mb-6 block\">O que est\303\241 incluso</span>\n              <h2 className=\"text-4xl md:text-5xl font-serif font-light uppercase tracking-widest text-[#472f5b] mb-8\">\n                Nossa rotina,<br/><span className=\"italic lowercase text-[#b2893d]\">seu tempo livre</span>\n              </h2>\n              <p className=\"text-[#2a3a1e] text-sm font-normal leading-relaxed tracking-wide max-w-md\">\n                Mais do que pagar contas, n\303\263s estruturamos e acompanhamos cada centavo que entra e sai. Entregamos clareza visual, concilia\303\247\303\265es banc\303\241rias rigorosas e relat\303\263rios financeiros detalhados para o seu controle absoluto.\n              </p>\n            </div>\n            <div className=\"lg:w-1/2\">\n              <FinancialIllustration />\n            </div>\n          </div>\n\n          <div className=\"tasks-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-4\">\n            {tasks.map((task, idx) => (\n              <div \n                key={idx} \n                className=\"task-item flex items-start gap-4 p-6 bg-[#FFFFFF] border border-[#472f5b]/5 hover:border-[#D8B36B]/50 transition-colors group\"\n              >\n                <div className=\"mt-0.5 flex-shrink-0 w-5 h-5 rounded-full border border-[#D8B36B] flex items-center justify-center bg-[#D8B36B]/10 group-hover:scale-110 transition-transform\">\n                  <Check strokeWidth={2.5} className=\"w-2.5 h-2.5 text-[#b2893d]\" />\n                </div>\n                <span className=\"text-sm font-normal tracking-wide text-[#472f5b]\">{task}</span>\n              </div>\n            ))}\n          </div>\n        </div>\n\n        {/* Financial Benefits Section */}\n        <FadeInUp>\n          <FinancialBenefits />\n        </FadeInUp>\n\n        {/* Security and Confidentiality Guarantee */}\n        <FadeInUp>\n          <SecurityGuarantee />\n        </FadeInUp>\n\n        {/* Onboarding Journey */}\n        <FadeInUp>\n          <OnboardingJourney />\n        </FadeInUp>\n\n        {/* Tangible Results Charts */}\n        <FadeInUp>\n          <TangibleResults />\n        </FadeInUp>\n\n        {/* Testimonials */}\n        <div className=\"-mx-6\">\n          <FadeInUp>\n            <Testimonials showPricing={true} />\n          </FadeInUp>\n        </div>\n\n        {/* FAQ Section */}\n        <FadeInUp>\n          <FAQ />\n        </FadeInUp>\n\n        {/* CTA */}\n        <div className=\"py-24 border-t border-[#472f5b]/10 mt-16\">\n          <FadeInUp>\n          <div className=\"flex flex-col items-center justify-center text-center mb-16\">\n            <h2 className=\"text-4xl font-serif font-light uppercase tracking-widest text-[#472f5b] mb-6\">\n              Pronto para <span className=\"italic lowercase text-[#b2893d]\">delegar?</span>\n            </h2>\n            <p className=\"text-[#2a3a1e] text-sm font-normal max-w-md tracking-wide\">\n              Pare de gastar seu tempo com planilhas e boletos. Preencha os dados abaixo e receba um diagn\303\263stico personalizado.\n            </p>\n          </div>\n          <LeadCaptureForm type=\"bpo\" />\n          <TrustBadges />\n          </FadeInUp>\n        </div>\n\n      </div>\n    </div>\n  );\n}\n"
