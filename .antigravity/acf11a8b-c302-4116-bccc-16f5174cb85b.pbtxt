    combined_output {
      full: "import { useRef } from \"react\";import gsap from \"gsap\";import { ScrollTrigger } from \"gsap/ScrollTrigger\";import { useGSAP } from \"@gsap/react\";import {   BarChart, Bar, XAxis, YAxis, Tooltip, ResponsiveContainer, Cell,  AreaChart, Area, CartesianGrid} from \"recharts\";gsap.registerPlugin(ScrollTrigger);const timeData = [  { name: \"M\303\251dia Nacional\", horas: 84 },  { name: \"Clientes Favo\", horas: 4 }];const efficiencyData = [  { mes: \"M\303\252s 1\", controle: 30 },  { mes: \"M\303\252s 2\", controle: 55 },  { mes: \"M\303\252s 3\", controle: 75 },  { mes: \"M\303\252s 4\", controle: 90 },  { mes: \"M\303\252s 5\", controle: 100 }];const CustomTooltipTime = ({ active, payload }: any) => {  if (active && payload && payload.length) {    return (      <div className=\"bg-[#FFFFFF] border border-[#472f5b]/10 p-4 shadow-xl\">        <p className=\"text-[10px] uppercase tracking-[0.2em] font-light text-[#4e653d] mb-1\">{payload[0].payload.name}</p>        <p className=\"text-xl font-serif text-[#D8B36B]\">{payload[0].value}h <span className=\"text-xs font-light text-[#472f5b] uppercase tracking-widest\">/m\303\252s</span></p>      </div>    );  }  return null;};const CustomTooltipEfficiency = ({ active, payload }: any) => {  if (active && payload && payload.length) {    return (      <div className=\"bg-[#FFFFFF] border border-[#472f5b]/10 p-4 shadow-xl\">        <p className=\"text-[10px] uppercase tracking-[0.2em] font-light text-[#4e653d] mb-1\">{payload[0].payload.mes}</p>        <p className=\"text-xl font-serif text-[#D8B36B]\">{payload[0].value}% <span className=\"text-xs font-light text-[#472f5b] uppercase tracking-widest\">Controle</span></p>      </div>    );  }  return null;};export default function TangibleResults() {  const containerRef = useRef<HTMLDivElement>(null);  useGSAP(() => {    const cards = gsap.utils.toArray(\'.chart-card\');        gsap.from(cards, {      scrollTrigger: {        trigger: containerRef.current,        start: \"top 80%\",      },      opacity: 0,      y: 40,      duration: 1,      stagger: 0.2,      ease: \"power3.out\"    });  }, { scope: containerRef });  return (    <section ref={containerRef} className=\"py-24 border-t border-[#472f5b]/10\">      <div className=\"flex items-center gap-4 mb-6\">        <span className=\"h-[1px] w-12 bg-[#D8B36B]\"></span>        <span className=\"text-[10px] uppercase tracking-[0.3em] font-light text-[#D8B36B]\">Resultados Tang\303\255veis</span>      </div>            <div className=\"flex flex-col md:flex-row md:items-end justify-between gap-8 mb-16\">        <h2 className=\"text-4xl md:text-5xl font-serif font-light uppercase tracking-widest text-[#472f5b]\">          O impacto dos <br/><span className=\"italic lowercase text-[#D8B36B]\">n\303\272meros a seu favor</span>        </h2>        <p className=\"text-[#4e653d] text-sm font-light leading-relaxed tracking-wide max-w-sm\">          N\303\263s transformamos a dor de cabe\303\247a burocr\303\241tica em tempo livre e m\303\251tricas visuais, dando a voc\303\252 controle absoluto sobre o crescimento.        </p>      </div>      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8\">                {/* Time Saved Chart */}        <div className=\"chart-card bg-[#FFFFFF] border border-[#472f5b]/10 p-10 shadow-lg group hover:border-[#D8B36B]/40 transition-colors flex flex-col\">          <h3 className=\"text-xl font-serif font-light text-[#472f5b] mb-2 uppercase tracking-widest\">Tempo Gasto com Burocracia</h3>          <p className=\"text-xs font-light text-[#4e653d] tracking-wide mb-4\">            Horas gastas por m\303\252s com pagamentos, concilia\303\247\303\243o e emiss\303\243o de notas.          </p>          <div className=\"mb-8 inline-block bg-[#fffff0] px-3 py-1.5 rounded-sm border border-[#472f5b]/5\">            <p className=\"text-[9px] uppercase tracking-wider text-[#4e653d]\">              * PMEs gastam 21h semanais (84h/m\303\252s) em m\303\251dia com finan\303\247as.              <br/><span className=\"text-[#D8B36B] font-medium\">Fonte: Conta Simples & Visa (2023)</span>            </p>          </div>          <div className=\"h-64 w-full mt-auto\">            <ResponsiveContainer width=\"100%\" height=\"100%\">              <BarChart data={timeData} margin={{ top: 10, right: 10, left: -20, bottom: 0 }}>                <XAxis                   dataKey=\"name\"                   axisLine={false}                   tickLine={false}                   tick={{ fill: \'#4e653d\', fontSize: 10, fontWeight: 300, textAnchor: \'middle\' }}                  dy={10}                />                <YAxis                   axisLine={false}                   tickLine={false}                   tick={{ fill: \'#4e653d\', fontSize: 10, fontWeight: 300 }}                />                <Tooltip content={<CustomTooltipTime />} cursor={{ fill: \'rgba(216, 179, 107, 0.05)\' }} />                <Bar dataKey=\"horas\" radius={[4, 4, 0, 0]} barSize={60} animationDuration={1500}>                  {timeData.map((entry, index) => (                    <Cell key={`cell-${index}`} fill={index === 0 ? \'#472f5b\' : \'#D8B36B\'} fillOpacity={index === 0 ? 0.1 : 1} />                  ))}                </Bar>              </BarChart>            </ResponsiveContainer>          </div>        </div>        {/* Efficiency/Control Chart */}        <div className=\"chart-card bg-[#FFFFFF] border border-[#472f5b]/10 p-10 shadow-lg group hover:border-[#D8B36B]/40 transition-colors flex flex-col\">          <h3 className=\"text-xl font-serif font-light text-[#472f5b] mb-2 uppercase tracking-widest\">N\303\255vel de Visibilidade e Controle</h3>          <p className=\"text-xs font-light text-[#4e653d] tracking-wide mb-4\">            Aumento da clareza sobre margem de lucro e fluxo de caixa ao longo dos meses.          </p>          <div className=\"mb-8 inline-block bg-[#fffff0] px-3 py-1.5 rounded-sm border border-[#472f5b]/5\">            <p className=\"text-[9px] uppercase tracking-wider text-[#4e653d]\">              * 60% das PMEs fecham em 5 anos devido \303\240 falta de gest\303\243o financeira.              <br/><span className=\"text-[#D8B36B] font-medium\">Fonte: Estudo Causa Mortis (Sebrae)</span>            </p>          </div>          <div className=\"h-64 w-full mt-auto\">            <ResponsiveContainer width=\"100%\" height=\"100%\">              <AreaChart data={efficiencyData} margin={{ top: 10, right: 10, left: -20, bottom: 0 }}>                <defs>                  <linearGradient id=\"colorControle\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">                    <stop offset=\"5%\" stopColor=\"#D8B36B\" stopOpacity={0.3}/>                    <stop offset=\"95%\" stopColor=\"#D8B36B\" stopOpacity={0}/>                  </linearGradient>                </defs>                <CartesianGrid strokeDasharray=\"3 3\" vertical={false} stroke=\"rgba(35, 42, 27, 0.05)\" />                <XAxis                   dataKey=\"mes\"                   axisLine={false}                   tickLine={false}                   tick={{ fill: \'#4e653d\', fontSize: 10, fontWeight: 300 }}                  dy={10}                />                <YAxis                   axisLine={false}                   tickLine={false}                   tick={{ fill: \'#4e653d\', fontSize: 10, fontWeight: 300 }}                />                <Tooltip content={<CustomTooltipEfficiency />} />                <Area                   type=\"monotone\"                   dataKey=\"controle\"                   stroke=\"#D8B36B\"                   strokeWidth={2}                  fillOpacity={1}                   fill=\"url(#colorControle)\"                   animationDuration={2000}                />              </AreaChart>            </ResponsiveContainer>          </div>        </div>      </div>    </section>  );}"
