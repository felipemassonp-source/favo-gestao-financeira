          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            <span className=\"text-[#D8B36B] text-[10px] uppercase tracking-[0.3em] mb-4\">Problema 03</span>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
