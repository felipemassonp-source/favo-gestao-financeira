    blocking: true
    wait_ms_before_async: 5000
    command_line: "cat << \'EOF\' > src/components/CaseStudy.tsx\nimport { useRef } from \"react\";\nimport gsap from \"gsap\";\nimport { ScrollTrigger } from \"gsap/ScrollTrigger\";\nimport { useGSAP } from \"@gsap/react\";\nimport { ArrowRight, TrendingUp, Clock, Target } from \"lucide-react\";\n\ngsap.registerPlugin(ScrollTrigger);\n\nexport default function CaseStudy() {\n  const containerRef = useRef<HTMLDivElement>(null);\n\n  useGSAP(() => {\n    const elements = gsap.utils.toArray(\'.case-animate\');\n    \n    gsap.from(elements, {\n      scrollTrigger: {\n        trigger: containerRef.current,\n        start: \"top 75%\",\n      },\n      opacity: 0,\n      y: 30,\n      duration: 1.2,\n      stagger: 0.2,\n      ease: \"power3.out\"\n    });\n  }, { scope: containerRef });\n\n  return (\n    <section ref={containerRef} className=\"py-24 bg-[#472f5b] text-[#fffff0] my-20\">\n      <div className=\"max-w-7xl mx-auto px-6\">\n        \n        <div className=\"flex flex-col lg:flex-row gap-16 lg:gap-24\">\n          \n          {/* Narrative / Context */}\n          <div className=\"w-full lg:w-1/2\">\n            <div className=\"case-animate flex items-center gap-4 mb-8\">\n              <span className=\"h-[1px] w-12 bg-[#D8B36B]\"></span>\n              <span className=\"text-[10px] uppercase tracking-[0.3em] font-light text-[#D8B36B]\">Estudo de Caso Real</span>\n            </div>\n            \n            <h2 className=\"case-animate text-4xl md:text-5xl font-serif font-light uppercase tracking-widest mb-8\">\n              Do Caos \303\240 <br/><span className=\"italic lowercase text-[#D8B36B]\">Previsibilidade</span>\n            </h2>\n            \n            <div className=\"case-animate space-y-8\">\n              <div>\n                <h4 className=\"text-xs uppercase tracking-widest text-[#D8B36B] mb-3 font-medium\">O Cen\303\241rio (Antes)</h4>\n                <p className=\"text-sm font-light text-[#fffff0]/70 leading-relaxed tracking-wide\">\n                  Uma ag\303\252ncia de marketing digital que crescia r\303\241pido, mas os s\303\263cios n\303\243o sabiam se a empresa dava lucro. \n                  Mistura de contas pessoais e jur\303\255dicas, precifica\303\247\303\243o baseada no \"feeling\" e muito tempo gasto apagando inc\303\252ndios financeiros.\n                </p>\n              </div>\n              \n              <div>\n                <h4 className=\"text-xs uppercase tracking-widest text-[#D8B36B] mb-3 font-medium\">A Solu\303\247\303\243o Favo (6 Semanas)</h4>\n                <p className=\"text-sm font-light text-[#fffff0]/70 leading-relaxed tracking-wide\">\n                  Implantamos um BPO Financeiro integrado ao Conta Azul. Mapeamos os custos fixos, separamos o pr\303\263-labore \n                  e desenhamos DREs gerenciais semanais. Passamos a atuar como um CFO virtual, guiando as tomadas de decis\303\243o.\n                </p>\n              </div>\n            </div>\n          </div>\n          \n          {/* Metrics */}\n          <div className=\"w-full lg:w-1/2 flex flex-col justify-center gap-8\">\n            <div className=\"case-animate bg-[#fffff0]/5 border border-[#D8B36B]/20 p-8 hover:bg-[#fffff0]/10 transition-colors\">\n              <div className=\"flex items-center gap-4 mb-4\">\n                <div className=\"w-10 h-10 rounded-full bg-[#D8B36B]/20 flex items-center justify-center\">\n                  <TrendingUp className=\"w-5 h-5 text-[#D8B36B]\" />\n                </div>\n                <h4 className=\"text-sm font-serif uppercase tracking-widest\">Lucratividade</h4>\n              </div>\n              <div className=\"flex items-end gap-3\">\n                <span className=\"text-5xl font-serif font-light text-[#D8B36B]\">+45%</span>\n                <span className=\"text-xs font-light text-[#fffff0]/60 tracking-wide pb-1\">de margem l\303\255quida</span>\n              </div>\n            </div>\n\n            <div className=\"case-animate bg-[#fffff0]/5 border border-[#D8B36B]/20 p-8 hover:bg-[#fffff0]/10 transition-colors\">\n              <div className=\"flex items-center gap-4 mb-4\">\n                <div className=\"w-10 h-10 rounded-full bg-[#D8B36B]/20 flex items-center justify-center\">\n                  <Clock className=\"w-5 h-5 text-[#D8B36B]\" />\n                </div>\n                <h4 className=\"text-sm font-serif uppercase tracking-widest\">Tempo Livre</h4>\n              </div>\n              <div className=\"flex items-end gap-3\">\n                <span className=\"text-5xl font-serif font-light text-[#D8B36B]\">-30h</span>\n                <span className=\"text-xs font-light text-[#fffff0]/60 tracking-wide pb-1\">operacionais por m\303\252s</span>\n              </div>\n            </div>\n\n            <div className=\"case-animate bg-[#fffff0]/5 border border-[#D8B36B]/20 p-8 hover:bg-[#fffff0]/10 transition-colors\">\n              <div className=\"flex items-center gap-4 mb-4\">\n                <div className=\"w-10 h-10 rounded-full bg-[#D8B36B]/20 flex items-center justify-center\">\n                  <Target className=\"w-5 h-5 text-[#D8B36B]\" />\n                </div>\n                <h4 className=\"text-sm font-serif uppercase tracking-widest\">Clareza</h4>\n              </div>\n              <div className=\"flex items-end gap-3\">\n                <span className=\"text-5xl font-serif font-light text-[#D8B36B]\">100%</span>\n                <span className=\"text-xs font-light text-[#fffff0]/60 tracking-wide pb-1\">de previsibilidade de caixa</span>\n              </div>\n            </div>\n          </div>\n          \n        </div>\n      </div>\n    </section>\n  );\n}\nEOF\n"
    proposed_command_line: "cat << \'EOF\' > src/components/CaseStudy.tsx\nimport { useRef } from \"react\";\nimport gsap from \"gsap\";\nimport { ScrollTrigger } from \"gsap/ScrollTrigger\";\nimport { useGSAP } from \"@gsap/react\";\nimport { ArrowRight, TrendingUp, Clock, Target } from \"lucide-react\";\n\ngsap.registerPlugin(ScrollTrigger);\n\nexport default function CaseStudy() {\n  const containerRef = useRef<HTMLDivElement>(null);\n\n  useGSAP(() => {\n    const elements = gsap.utils.toArray(\'.case-animate\');\n    \n    gsap.from(elements, {\n      scrollTrigger: {\n        trigger: containerRef.current,\n        start: \"top 75%\",\n      },\n      opacity: 0,\n      y: 30,\n      duration: 1.2,\n      stagger: 0.2,\n      ease: \"power3.out\"\n    });\n  }, { scope: containerRef });\n\n  return (\n    <section ref={containerRef} className=\"py-24 bg-[#472f5b] text-[#fffff0] my-20\">\n      <div className=\"max-w-7xl mx-auto px-6\">\n        \n        <div className=\"flex flex-col lg:flex-row gap-16 lg:gap-24\">\n          \n          {/* Narrative / Context */}\n          <div className=\"w-full lg:w-1/2\">\n            <div className=\"case-animate flex items-center gap-4 mb-8\">\n              <span className=\"h-[1px] w-12 bg-[#D8B36B]\"></span>\n              <span className=\"text-[10px] uppercase tracking-[0.3em] font-light text-[#D8B36B]\">Estudo de Caso Real</span>\n            </div>\n            \n            <h2 className=\"case-animate text-4xl md:text-5xl font-serif font-light uppercase tracking-widest mb-8\">\n              Do Caos \303\240 <br/><span className=\"italic lowercase text-[#D8B36B]\">Previsibilidade</span>\n            </h2>\n            \n            <div className=\"case-animate space-y-8\">\n              <div>\n                <h4 className=\"text-xs uppercase tracking-widest text-[#D8B36B] mb-3 font-medium\">O Cen\303\241rio (Antes)</h4>\n                <p className=\"text-sm font-light text-[#fffff0]/70 leading-relaxed tracking-wide\">\n                  Uma ag\303\252ncia de marketing digital que crescia r\303\241pido, mas os s\303\263cios n\303\243o sabiam se a empresa dava lucro. \n                  Mistura de contas pessoais e jur\303\255dicas, precifica\303\247\303\243o baseada no \"feeling\" e muito tempo gasto apagando inc\303\252ndios financeiros.\n                </p>\n              </div>\n              \n              <div>\n                <h4 className=\"text-xs uppercase tracking-widest text-[#D8B36B] mb-3 font-medium\">A Solu\303\247\303\243o Favo (6 Semanas)</h4>\n                <p className=\"text-sm font-light text-[#fffff0]/70 leading-relaxed tracking-wide\">\n                  Implantamos um BPO Financeiro integrado ao Conta Azul. Mapeamos os custos fixos, separamos o pr\303\263-labore \n                  e desenhamos DREs gerenciais semanais. Passamos a atuar como um CFO virtual, guiando as tomadas de decis\303\243o.\n                </p>\n              </div>\n            </div>\n          </div>\n          \n          {/* Metrics */}\n          <div className=\"w-full lg:w-1/2 flex flex-col justify-center gap-8\">\n            <div className=\"case-animate bg-[#fffff0]/5 border border-[#D8B36B]/20 p-8 hover:bg-[#fffff0]/10 transition-colors\">\n              <div className=\"flex items-center gap-4 mb-4\">\n                <div className=\"w-10 h-10 rounded-full bg-[#D8B36B]/20 flex items-center justify-center\">\n                  <TrendingUp className=\"w-5 h-5 text-[#D8B36B]\" />\n                </div>\n                <h4 className=\"text-sm font-serif uppercase tracking-widest\">Lucratividade</h4>\n              </div>\n              <div className=\"flex items-end gap-3\">\n                <span className=\"text-5xl font-serif font-light text-[#D8B36B]\">+45%</span>\n                <span className=\"text-xs font-light text-[#fffff0]/60 tracking-wide pb-1\">de margem l\303\255quida</span>\n              </div>\n            </div>\n\n            <div className=\"case-animate bg-[#fffff0]/5 border border-[#D8B36B]/20 p-8 hover:bg-[#fffff0]/10 transition-colors\">\n              <div className=\"flex items-center gap-4 mb-4\">\n                <div className=\"w-10 h-10 rounded-full bg-[#D8B36B]/20 flex items-center justify-center\">\n                  <Clock className=\"w-5 h-5 text-[#D8B36B]\" />\n                </div>\n                <h4 className=\"text-sm font-serif uppercase tracking-widest\">Tempo Livre</h4>\n              </div>\n              <div className=\"flex items-end gap-3\">\n                <span className=\"text-5xl font-serif font-light text-[#D8B36B]\">-30h</span>\n                <span className=\"text-xs font-light text-[#fffff0]/60 tracking-wide pb-1\">operacionais por m\303\252s</span>\n              </div>\n            </div>\n\n            <div className=\"case-animate bg-[#fffff0]/5 border border-[#D8B36B]/20 p-8 hover:bg-[#fffff0]/10 transition-colors\">\n              <div className=\"flex items-center gap-4 mb-4\">\n                <div className=\"w-10 h-10 rounded-full bg-[#D8B36B]/20 flex items-center justify-center\">\n                  <Target className=\"w-5 h-5 text-[#D8B36B]\" />\n                </div>\n                <h4 className=\"text-sm font-serif uppercase tracking-widest\">Clareza</h4>\n              </div>\n              <div className=\"flex items-end gap-3\">\n                <span className=\"text-5xl font-serif font-light text-[#D8B36B]\">100%</span>\n                <span className=\"text-xs font-light text-[#fffff0]/60 tracking-wide pb-1\">de previsibilidade de caixa</span>\n              </div>\n            </div>\n          </div>\n          \n        </div>\n      </div>\n    </section>\n  );\n}\nEOF\n"
