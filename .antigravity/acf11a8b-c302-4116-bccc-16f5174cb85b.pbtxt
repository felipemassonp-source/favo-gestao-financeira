 isEven = i % 2 === 0;      gsap.fromTo(item,         { opacity: 0, x: isEven ? -40 : 40 },        {          scrollTrigger: {            trigger: item,            start: \"top 85%\",          },          opacity: 1,          x: 0,          duration: 1,          ease: \"power3.out\"        }      );    });  }, { scope: containerRef });  return (    <div ref={containerRef} className=\"relative w-full max-w-4xl mx-auto py-10 mt-10\">      {/* Background Static Line */}      <div className=\"absolute left-[27px] md:left-[50%] top-0 bottom-0 w-[1px] bg-[#472f5b]/10 -translate-x-1/2\"></div>            {/* Animated Fill Line */}      <div className=\"timeline-line-progress absolute left-[27px] md:left-[50%] top-0 w-[1px] bg-[#D8B36B] -translate-x-1/2 h-0\"></div>      <div className=\"space-y-16\">        {timelineSteps.map((step, idx) => {          const isEven = idx % 2 === 0;          return (            <div key={idx} className={`timeline-item relative flex flex-col md:flex-row items-start md:items-center w-full ${isEven ? \'md:flex-row-reverse\' : \'\'}`}>                            {/* Central Node */}              <div className=\"absolute left-[27px] md:left-[50%] w-12 h-12 -translate-x-1/2 rounded-full border border-[#D8B36B] bg-[#fffff0] flex items-center justify-center z-10 shadow-sm transition-transform duration-500 hover:scale-110\">                {step.icon ? (                  <step.icon className={`w-5 h-5 ${step.highlight ? \'text-[#D8B36B]\' : \'text-[#472f5b]\'}`} strokeWidth={1.5} />                ) : (                  <span className=\"text-xs font-serif text-[#D8B36B]\">{idx + 1}</span>                )}              </div>              {/* Content Box */}              <div className={`w-full md:w-1/2 pl-20 md:pl-0 ${isEven ? \'md:pr-20 text-left md:text-right\' : \'md:pl-20 text-left\'}`}>                <div className=\"bg-[#FFFFFF] border border-[#472f5b]/10 p-8 shadow-md hover:border-[#D8B36B]/40 transition-colors group\">                  <span className=\"text-[10px] uppercase tracking-[0.2em] font-light text-[#D8B36B] mb-3 block\">                    {step.time}                  </span>                  <h3 className=\"text-xl md:text-2xl font-serif uppercase tracking-widest font-light text-[#472f5b] mb-4 group-hover:text-[#D8B36B] transition-colors\">                    {step.title}                  </h3>                  <p className=\"text-sm font-light text-[#4e653d] leading-relaxed tracking-wide\">                    {step.description}                  </p>                </div>              </div>            </div>          )        })}      </div>    </div>  );}"
    }
