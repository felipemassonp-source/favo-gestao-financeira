    combined_output {
      full: "import { useRef } from \"react\";import gsap from \"gsap\";import { ScrollTrigger } from \"gsap/ScrollTrigger\";import { useGSAP } from \"@gsap/react\";import SplitType from \"split-type\";import InteractiveJourney from \"../components/InteractiveJourney\";import MagneticButton from \"../components/MagneticButton\";import { Link } from \"react-router-dom\";gsap.registerPlugin(ScrollTrigger);export default function Consultoria() {  const container = useRef<HTMLDivElement>(null);  const titleRef = useRef<HTMLHeadingElement>(null);  const isInitialLoad = !sessionStorage.getItem(\'favo_visited\');  const initialDelay = isInitialLoad ? 2.4 : 0.2;  useGSAP(() => {    // Split Text animation for title    if (titleRef.current) {      const text = new SplitType(titleRef.current, { types: \'lines,words,chars\' });            text.lines?.forEach((line) => {        const wrapper = document.createElement(\'div\');        wrapper.style.overflow = \'hidden\';        line.parentNode?.insertBefore(wrapper, line);        wrapper.appendChild(line);      });      gsap.fromTo(\".subtitle\",         { opacity: 0, y: 30 },        { opacity: 1, y: 0, duration: 1.5, ease: \"power3.out\", delay: initialDelay + 1.0 }      );      gsap.from(text.chars, {        opacity: 0,        y: \"100%\",        rotationZ: 2,        stagger: 0.02,        duration: 1.4,        ease: \"power4.out\",        delay: initialDelay      });    }    // High-end section title animations    const sectionTitles = gsap.utils.toArray(\'.section-title\');    sectionTitles.forEach((title: any) => {      const splitTitle = new SplitType(title, { types: \'lines,words\' });            splitTitle.lines?.forEach((line) => {        const wrapper = document.createElement(\'div\');        wrapper.style.overflow = \'hidden\';        line.parentNode?.insertBefore(wrapper, line);        wrapper.appendChild(line);      });      gsap.from(splitTitle.words, {        scrollTrigger: {          trigger: title,          start: \"top 85%\",        },        y: \"100%\",        opacity: 0,        duration: 1.2,        stagger: 0.05,        ease: \"power4.out\"      });    });  }, { scope: container });  return (    <div ref={container} className=\"w-full min-h-screen pt-40 pb-20 bg-[#F7F6EE]\">      <div className=\"max-w-7xl mx-auto px-6\">                {/* Hero Section */}        <h1 ref={titleRef} className=\"text-6xl md:text-8xl font-serif font-light tracking-widest mb-12 uppercase text-[#232A1B]\">          Consultoria<br/> <span className=\"text-[#D8B36B] italic lowercase\">Descomplicada</span>        </h1>        <p className=\"subtitle text-sm md:text-base font-light text-[#535458] max-w-2xl leading-relaxed mb-32 opacity-0 tracking-wide\">          Estrat\303\251gias simples, ferramentas certas e o b\303\241sico bem feito. Ajudamos voc\303\252 a organizar sua casa financeira e ver o lucro real do seu trabalho, sem jarg\303\265es ou planilhas que d\303\243o dor de cabe\303\247a.        </p>        {/* Gamified Journey Section */}        <div className=\"py-20 border-t border-[#232A1B]/10\">          <div className=\"flex flex-col md:flex-row md:items-end justify-between gap-8 mb-16\">            <div>              <span className=\"text-[#D8B36B] text-[10px] uppercase tracking-[0.3em] mb-6 block\">Como Funciona</span>              <h2 className=\"section-title text-4xl md:text-5xl font-serif font-light uppercase tracking-widest text-[#232A1B]\">                Desbloqueie<br/><span className=\"italic lowercase text-[#D8B36B]\">seu Lucro</span>              </h2>            </div>            <p className=\"text-[#535458] text-sm font-light leading-relaxed tracking-wide max-w-sm\">              Um m\303\251todo robusto disfar\303\247ado de simplicidade. Em 4 passos interativos, veja como transformamos a burocracia do seu dia a dia em uma rotina leve e lucrativa.            </p>          </div>          <InteractiveJourney />        </div>        {/* Benefits / Value Section */}        <div className=\"py-32 border-t border-[#232A1B]/10 mt-16\">          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-16\">            <div>              <span className=\"text-[#D8B36B] text-[10px] uppercase tracking-[0.2em] mb-4 block border-b border-[#D8B36B]/30 pb-4 w-12\"></span>              <h3 className=\"text-xl font-serif uppercase tracking-widest font-light text-[#232A1B] mb-4\">                O B\303\241sico que Funciona              </h3>              <p className=\"text-sm font-light text-[#535458] leading-relaxed tracking-wide\">                N\303\243o reinventamos a roda, n\303\263s fazemos ela girar. Focamos no feij\303\243o com arroz das finan\303\247as que a maioria n\303\243o faz: separar contas, precificar certo e controlar gastos.              </p>            </div>            <div>              <span className=\"text-[#D8B36B] text-[10px] uppercase tracking-[0.2em] mb-4 block border-b border-[#D8B36B]/30 pb-4 w-12\"></span>              <h3 className=\"text-xl font-serif uppercase tracking-widest font-light text-[#232A1B] mb-4\">                Ferramentas Certas              </h3>              <p className=\"text-sm font-light text-[#535458] leading-relaxed tracking-wide\">                Voc\303\252 n\303\243o precisa ser um mestre do Excel. N\303\263s implementamos sistemas simples e intuitivos que automatizam a burocracia, devolvendo horas preciosas para o seu dia.              </p>            </div>            <div>              <span className=\"text-[#D8B36B] text-[10px] uppercase tracking-[0.2em] mb-4 block border-b border-[#D8B36B]/30 pb-4 w-12\"></span>              <h3 className=\"text-xl font-serif uppercase tracking-widest font-light text-[#232A1B] mb-4\">                Retorno Absoluto              </h3>              <p className=\"text-sm font-light text-[#535458] leading-relaxed tracking-wide\">                A consultoria se paga rapidamente quando voc\303\252 descobre onde o dinheiro estava vazando e passa a precificar seus servi\303\247os com base na sua margem de lucro real.              </p>            </div>          </div>        </div>        {/* CTA */}        <div className=\"py-24 border-t border-[#232A1B]/10 flex flex-col items-center justify-center text-center\">          <h2 className=\"section-title text-4xl font-serif font-light uppercase tracking-widest text-[#232A1B] mb-12\">            Vamos arrumar<br/><span className=\"italic lowercase text-[#D8B36B]\">a casa?</span>          </h2>          <MagneticButton>            <Link to=\"/#contato\" className=\"border border-[#232A1B]/20 px-12 py-5 text-xs uppercase tracking-[0.2em] hover:border-[#D8B36B] hover:text-[#D8B36B] transition-colors font-light rounded-full bg-[#FFFFFF] shadow-sm\">              Agendar Diagn\303\263stico Gratuito            </Link>          </MagneticButton>        </div>      </div>    </div>  );}"
