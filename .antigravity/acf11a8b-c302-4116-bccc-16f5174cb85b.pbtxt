    command_line: "cat << \'EOF\' > src/components/BeforeAfterReveal.tsx\nimport React, { useState } from \'react\';\nimport { ChevronsLeftRight } from \'lucide-react\';\n\nexport default function BeforeAfterReveal() {\n  const [sliderPosition, setSliderPosition] = useState(50);\n\n  return (\n    <section className=\"py-24 bg-[#fffff0] relative border-b border-[#472f5b]/10\">\n      <div className=\"max-w-7xl mx-auto px-6\">\n        <div className=\"text-center max-w-3xl mx-auto mb-16\">\n          <span className=\"text-[#866428] text-[10px] uppercase tracking-[0.3em] mb-6 block font-medium\">A Transforma\303\247\303\243o Favo</span>\n          <h2 className=\"text-3xl md:text-5xl font-serif font-light text-[#472f5b] mb-6 tracking-wide\">\n            Do Caos \303\240 <span className=\"italic text-[#866428]\">Previsibilidade.</span>\n          </h2>\n          <p className=\"text-sm font-normal text-[#2a3a1e] tracking-wide leading-relaxed\">\n            Arraste para o lado e veja a diferen\303\247a entre tentar controlar tudo em planilhas manuais e ter a Favo organizando o seu neg\303\263cio com dashboards visuais e limpos.\n          </p>\n        </div>\n\n        <div className=\"relative w-full max-w-5xl mx-auto aspect-[4/3] md:aspect-[21/9] bg-gray-200 shadow-2xl rounded-sm overflow-hidden group\">\n          \n          {/* BEFORE: Messy / Chaotic (Background) */}\n          <div className=\"absolute inset-0\">\n            {/* Dark overlay to make it look \"stressful\" */}\n            <div className=\"absolute inset-0 bg-[#472f5b]/20 mix-blend-multiply z-10 pointer-events-none\"></div>\n            <img \n              src=\"https://images.unsplash.com/photo-1554224155-8d04cb21cd6c?auto=format&fit=crop&q=80&w=1600\" \n              alt=\"Caos financeiro e planilhas\"\n              className=\"w-full h-full object-cover filter grayscale sepia-[0.3]\"\n              draggable=\"false\"\n            />\n            <div className=\"absolute top-6 right-6 z-20 bg-[#472f5b] text-[#fffff0] px-4 py-2 text-[10px] uppercase tracking-widest font-medium\">\n              Antes: O Caos\n            </div>\n          </div>\n\n          {/* AFTER: Clean Dashboard (Foreground, clipped) */}\n          <div \n            className=\"absolute inset-0 z-20 pointer-events-none bg-white\"\n            style={{ clipPath: `inset(0 ${100 - sliderPosition}% 0 0)` }}\n          >\n            <img \n              src=\"https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&q=80&w=1600\" \n              alt=\"Dashboard financeiro limpo\"\n              className=\"w-full h-full object-cover\"\n              draggable=\"false\"\n            />\n            <div className=\"absolute top-6 left-6 z-20 bg-[#866428] text-[#fffff0] px-4 py-2 text-[10px] uppercase tracking-widest font-medium shadow-lg\">\n              Depois: A Clareza\n            </div>\n          </div>\n\n          {/* Hidden Range Input for Interaction */}\n          <input \n            type=\"range\" \n            min=\"0\" \n            max=\"100\" \n            value={sliderPosition} \n            onChange={(e) => setSliderPosition(Number(e.target.value))}\n            className=\"absolute inset-0 w-full h-full opacity-0 cursor-ew-resize z-30\"\n            aria-label=\"Controle de antes e depois\"\n          />\n          \n          {/* Visible Slider Handle */}\n          <div \n            className=\"absolute top-0 bottom-0 w-0.5 bg-[#866428] z-20 pointer-events-none transition-transform duration-75\"\n            style={{ left: `${sliderPosition}%`, transform: \'translateX(-50%)\' }}\n          >\n            <div className=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-10 h-10 bg-[#fffff0] border-2 border-[#866428] rounded-full flex items-center justify-center shadow-[0_0_20px_rgba(0,0,0,0.3)]\">\n               <ChevronsLeftRight className=\"w-5 h-5 text-[#866428]\" />\n            </div>\n          </div>\n        </div>\n\n        <div className=\"text-center mt-12 flex items-center justify-center gap-2 text-xs font-light text-[#472f5b]/60 uppercase tracking-widest\">\n          <ChevronsLeftRight className=\"w-4 h-4\" /> Interaja com a imagem\n        </div>\n      </div>\n    </section>\n  );\n}\nEOF\n"
    proposed_command_line: "cat << \'EOF\' > src/components/BeforeAfterReveal.tsx\nimport React, { useState } from \'react\';\nimport { ChevronsLeftRight } from \'lucide-react\';\n\nexport default function BeforeAfterReveal() {\n  const [sliderPosition, setSliderPosition] = useState(50);\n\n  return (\n    <section className=\"py-24 bg-[#fffff0] relative border-b border-[#472f5b]/10\">\n      <div className=\"max-w-7xl mx-auto px-6\">\n        <div className=\"text-center max-w-3xl mx-auto mb-16\">\n          <span className=\"text-[#866428] text-[10px] uppercase tracking-[0.3em] mb-6 block font-medium\">A Transforma\303\247\303\243o Favo</span>\n          <h2 className=\"text-3xl md:text-5xl font-serif font-light text-[#472f5b] mb-6 tracking-wide\">\n            Do Caos \303\240 <span className=\"italic text-[#866428]\">Previsibilidade.</span>\n          </h2>\n          <p className=\"text-sm font-normal text-[#2a3a1e] tracking-wide leading-relaxed\">\n            Arraste para o lado e veja a diferen\303\247a entre tentar controlar tudo em planilhas manuais e ter a Favo organizando o seu neg\303\263cio com dashboards visuais e limpos.\n          </p>\n        </div>\n\n        <div className=\"relative w-full max-w-5xl mx-auto aspect-[4/3] md:aspect-[21/9] bg-gray-200 shadow-2xl rounded-sm overflow-hidden group\">\n          \n          {/* BEFORE: Messy / Chaotic (Background) */}\n          <div className=\"absolute inset-0\">\n            {/* Dark overlay to make it look \"stressful\" */}\n            <div className=\"absolute inset-0 bg-[#472f5b]/20 mix-blend-multiply z-10 pointer-events-none\"></div>\n            <img \n              src=\"https://images.unsplash.com/photo-1554224155-8d04cb21cd6c?auto=format&fit=crop&q=80&w=1600\" \n              alt=\"Caos financeiro e planilhas\"\n              className=\"w-full h-full object-cover filter grayscale sepia-[0.3]\"\n              draggable=\"false\"\n            />\n            <div className=\"absolute top-6 right-6 z-20 bg-[#472f5b] text-[#fffff0] px-4 py-2 text-[10px] uppercase tracking-widest font-medium\">\n              Antes: O Caos\n            </div>\n          </div>\n\n          {/* AFTER: Clean Dashboard (Foreground, clipped) */}\n          <div \n            className=\"absolute inset-0 z-20 pointer-events-none bg-white\"\n            style={{ clipPath: `inset(0 ${100 - sliderPosition}% 0 0)` }}\n          >\n            <img \n              src=\"https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&q=80&w=1600\" \n              alt=\"Dashboard financeiro limpo\"\n              className=\"w-full h-full object-cover\"\n              draggable=\"false\"\n            />\n            <div className=\"absolute top-6 left-6 z-20 bg-[#866428] text-[#fffff0] px-4 py-2 text-[10px] uppercase tracking-widest font-medium shadow-lg\">\n              Depois: A Clareza\n            </div>\n          </div>\n\n          {/* Hidden Range Input for Interaction */}\n          <input \n            type=\"range\" \n            min=\"0\" \n            max=\"100\" \n            value={sliderPosition} \n            onChange={(e) => setSliderPosition(Number(e.target.value))}\n            className=\"absolute inset-0 w-full h-full opacity-0 cursor-ew-resize z-30\"\n            aria-label=\"Controle de antes e depois\"\n          />\n          \n          {/* Visible Slider Handle */}\n          <div \n            className=\"absolute top-0 bottom-0 w-0.5 bg-[#866428] z-20 pointer-events-none transition-transform duration-75\"\n            style={{ left: `${sliderPosition}%`, transform: \'translateX(-50%)\' }}\n          >\n            <div className=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-10 h-10 bg-[#fffff0] border-2 border-[#866428] rounded-full flex items-center justify-center shadow-[0_0_20px_rgba(0,0,0,0.3)]\">\n               <ChevronsLeftRight className=\"w-5 h-5 text-[#866428]\" />\n            </div>\n          </div>\n        </div>\n\n        <div className=\"text-center mt-12 flex items-center justify-center gap-2 text-xs font-light text-[#472f5b]/60 uppercase tracking-widest\">\n          <ChevronsLeftRight className=\"w-4 h-4\" /> Interaja com a imagem\n        </div>\n      </div>\n    </section>\n  );\n}\nEOF\n"
