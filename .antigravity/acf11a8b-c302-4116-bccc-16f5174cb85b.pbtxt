gestao\" \n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            className=\"border border-[#472f5b]/20 px-8 py-3 text-[10px] uppercase tracking-[0.2em] font-light text-[#472f5b] hover:border-[#D8B36B] hover:text-[#D8B36B] transition-colors rounded-full\"\n          >\n            Seguir no Instagram\n          </a>\n        </div>\n\n        {/* Feed Grid */}\n        <div className=\"grid grid-cols-2 md:grid-cols-5 gap-4\">\n          {posts.map((post) => (\n            <a \n              key={post.id}\n              href=\"https://instagram.com/favogestao\"\n              target=\"_blank\"\n              rel=\"noopener noreferrer\"\n              className=\"group relative aspect-square bg-[#fffff0] overflow-hidden block\"\n            >\n              <img \n                src={post.img} \n                alt=\"Favo Instagram Post\" \n                className=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-105\"\n              />\n              {/* Overlay */}\n              <div className=\"absolute inset-0 bg-[#472f5b]/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center gap-6 backdrop-blur-[2px]\">\n                <div className=\"flex items-center gap-2 text-[#fffff0]\">\n                  <Heart className=\"w-5 h-5 fill-current\" />\n                  <span className=\"text-sm font-light\">{post.likes}</span>\n                </div>\n                <div className=\"flex items-center gap-2 text-[#fffff0]\">\n                  <MessageCircle className=\"w-5 h-5 fill-current\" />\n                  <span className=\"text-sm font-light\">{post.comments}</span>\n                </div>\n              </div>\n            </a>\n          ))}\n        </div>\n\n      </div>\n    </section>\n  );\n}\n"
    }
