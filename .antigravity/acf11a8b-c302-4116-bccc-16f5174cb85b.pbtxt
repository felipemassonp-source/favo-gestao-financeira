    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useRef } from \"react\";\nimport gsap from \"gsap\";\nimport { ScrollTrigger } from \"gsap/ScrollTrigger\";\nimport { useGSAP } from \"@gsap/react\";\nimport { MessageCircle, Check } from \"lucide-react\";\n\ngsap.registerPlugin(ScrollTrigger);\n\nconst timelineSteps = [\n  {\n    title: \"1\302\272 Encontro\",\n    time: \"Semana 1\",\n    description: \"Identifica\303\247\303\243o de gargalos e melhorias a serem aplicadas. Vamos entender a fundo o seu cen\303\241rio atual.\"\n  },\n  {\n    title: \"2\302\272 Encontro\",\n    time: \"Semana 2\",\n    description: \"Apontamento de estrat\303\251gias e mapeamento de processos. Estruturamos o plano de a\303\247\303\243o ideal para voc\303\252.\"\n  },\n  {\n    title: \"3\302\272 Encontro\",\n    time: \"Semana 4\",\n    description: \"Aplica\303\247\303\243o das estrat\303\251gias e ferramentas que podem auxiliar na sua rotina para ganhar produtividade.\"\n  },\n  {\n    title: \"4\302\272 Encontro\",\n    time: \"Semana 6\",\n    description: \"Revis\303\243o do que j\303\241 foi aplicado e aux\303\255lio direto nos pontos que ainda s\303\243o travas no seu dia a dia.\"\n  },\n  {\n    title: \"Acompanhamento\",\n    time: \"90 Dias Seguintes\",\n    description: \"Suporte direto durante 90 dias via WhatsApp para tirar d\303\272vidas e destravar processos sempre que precisar.\",\n    icon: MessageCircle,\n    highlight: true\n  }\n];\n\nexport default function ConsultingTimeline() {\n  const containerRef = useRef<HTMLDivElement>(null);\n\n  useGSAP(() => {\n    const items = gsap.utils.toArray(\'.timeline-item\');\n    const line = document.querySelector(\'.timeline-line-progress\');\n\n    // Animate line drawing down as you scroll\n    if (line) {\n      gsap.to(line, {\n        scrollTrigger: {\n          trigger: containerRef.current,\n          start: \"top center\",\n          end: \"bottom center\",\n          scrub: 1,\n        },\n        height: \"100%\",\n        ease: \"none\"\n      });\n    }\n\n    // Animate items fading in and sliding from sides\n    items.forEach((item: any, i) => {\n      const isEven = i % 2 === 0;\n      gsap.fromTo(item, \n        { opacity: 0, x: isEven ? -40 : 40 },\n        {\n          scrollTrigger: {\n            trigger: item,\n            start: \"top 85%\",\n          },\n          opacity: 1,\n          x: 0,\n          duration: 1,\n          ease: \"power3.out\"\n        }\n      );\n    });\n  }, { scope: containerRef });\n\n  return (\n    <div ref={containerRef} className=\"relative w-full max-w-4xl mx-auto py-10 mt-10\">\n      {/* Background Static Line */}\n      <div className=\"absolute left-[27px] md:left-[50%] top-0 bottom-0 w-[1px] bg-[#232A1B]/10 -translate-x-1/2\"></div>\n      \n      {/* Animated Fill Line */}\n      <div className=\"timeline-line-progress absolute left-[27px] md:left-[50%] top-0 w-[1px] bg-[#D8B36B] -translate-x-1/2 h-0\"></div>\n\n      <div className=\"space-y-16\">\n        {timelineSteps.map((step, idx) => {\n          const isEven = idx % 2 === 0;\n          return (\n            <div key={idx} className={`timeline-item relative flex flex-col md:flex-row items-start md:items-center w-full ${isEven ? \'md:flex-row-reverse\' : \'\'}`}>\n              \n              {/* Central Node */}\n              <div className=\"absolute left-[27px] md:left-[50%] w-12 h-12 -translate-x-1/2 rounded-full border border-[#D8B36B] bg-[#F7F6EE] flex items-center justify-center z-10 shadow-sm transition-transform duration-500 hover:scale-110\">\n                {step.icon ? (\n                  <step.icon className={`w-5 h-5 ${step.highlight ? \'text-[#D8B36B]\' : \'text-[#232A1B]\'}`} strokeWidth={1.5} />\n                ) : (\n                  <span className=\"text-xs font-serif text-[#D8B36B]\">{idx + 1}</span>\n                )}\n              </div>\n\n              {/* Content Box */}\n              <div className={`w-full md:w-1/2 pl-20 md:pl-0 ${isEven ? \'md:pr-20 text-left md:text-right\' : \'md:pl-20 text-left\'}`}>\n                <div className=\"bg-[#FFFFFF] border border-[#232A1B]/10 p-8 shadow-md hover:border-[#D8B36B]/40 transition-colors group\">\n                  <span className=\"text-[10px] uppercase tracking-[0.2em] font-light text-[#D8B36B] mb-3 block\">\n                    {step.time}\n                  </span>\n                  <h3 className=\"text-xl md:text-2xl font-serif uppercase tracking-widest font-light text-[#232A1B] mb-4 group-hover:text-[#D8B36B] transition-colors\">\n                    {step.title}\n                  </h3>\n                  <p className=\"text-sm font-light text-[#535458] leading-relaxed tracking-wide\">\n                    {step.description}\n                  </p>\n                </div>\n              </div>\n\n            </div>\n          )\n        })}\n      </div>\n    </div>\n  );\n}"
    }
