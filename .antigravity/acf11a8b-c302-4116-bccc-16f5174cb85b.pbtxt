  file_change {
    absolute_path_uri: "file:///src/components/InteractiveJourney.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useState, useRef, useEffect } from \"react\";\nimport gsap from \"gsap\";\nimport { useGSAP } from \"@gsap/react\";\nimport { Check, ArrowRight } from \"lucide-react\";\nimport { cn } from \"../lib/utils\";\n\nconst steps = [\n  {\n    title: \"O Raio-X Simples\",\n    description: \"Em uma conversa amig\303\241vel e sem jarg\303\265es, entendemos de onde o dinheiro da sua empresa vem e para onde vai. Nada de planilhas chatas, n\303\263s fazemos o levantamento inicial.\"\n  },\n  {\n    title: \"A Regra de Ouro\",\n    description: \"Organizamos a casa separando o que \303\251 seu e o que \303\251 da empresa. Definimos o seu pr\303\263-labore (seu sal\303\241rio) de forma segura, com base no que o neg\303\263cio realmente pode pagar.\"\n  },\n  {\n    title: \"Ferramentas & Automa\303\247\303\243o\",\n    description: \"Implementamos sistemas visuais e f\303\241ceis de usar. O b\303\241sico bem feito com a tecnologia certa. Aquela burocracia que levava horas, agora toma apenas alguns minutos.\"\n  },\n  {\n    title: \"Lucro Claro e Estrat\303\251gia\",\n    description: \"Pronto! Voc\303\252 ganha tempo para focar em atender seus clientes, enquanto mostramos o seu lucro crescendo atrav\303\251s de an\303\241lises did\303\241ticas e super f\303\241ceis de entender.\"\n  }\n];\n\nexport default function InteractiveJourney() {\n  const [activeStep, setActiveStep] = useState(0);\n  const progressCircleRef = useRef<SVGCircleElement>(null);\n  const contentRef = useRef<HTMLDivElement>(null);\n\n  const progress = ((activeStep + 1) / steps.length) * 100;\n  const circumference = 2 * Math.PI * 45; // radius = 45\n\n  useGSAP(() => {\n    if (progressCircleRef.current) {\n      const offset = circumference - (progress / 100) * circumference;\n      gsap.to(progressCircleRef.current, {\n        strokeDashoffset: offset,\n        duration: 1,\n        ease: \"power3.out\"\n      });\n    }\n  }, [progress, circumference]);\n\n  useGSAP(() => {\n    if (contentRef.current) {\n      gsap.fromTo(\n        contentRef.current,\n        { opacity: 0, y: 20 },\n        { opacity: 1, y: 0, duration: 0.6, ease: \"power2.out\" }\n      );\n    }\n  }, [activeStep]);\n\n  return (\n    <div className=\"bg-[#FFFFFF] border border-[#232A1B]/10 p-10 md:p-16 shadow-xl flex flex-col md:flex-row gap-12 items-center\">\n      \n      {/* Gamified Progress Side */}\n      <div className=\"flex-shrink-0 flex flex-col items-center gap-6\">\n        <div className=\"relative w-40 h-40 flex items-center justify-center\">\n          {/* Background Circle */}\n          <svg className=\"w-full h-full transform -rotate-90\" viewBox=\"0 0 100 100\">\n            <circle\n              cx=\"50\"\n              cy=\"50\"\n              r=\"45\"\n              fill=\"transparent\"\n              stroke=\"#232A1B\"\n              strokeWidth=\"1\"\n              strokeOpacity=\"0.1\"\n            />\n            {/* Animated Progress Circle */}\n            <circle\n              ref={progressCircleRef}\n              cx=\"50\"\n              cy=\"50\"\n              r=\"45\"\n              fill=\"transparent\"\n              stroke=\"#D8B36B\"\n              strokeWidth=\"2\"\n              strokeDasharray={circumference}\n              strokeDashoffset={circumference}\n              strokeLinecap=\"round\"\n            />\n          </svg>\n          <div className=\"absolute inset-0 flex flex-col items-center justify-center text-[#232A1B]\">\n            <span className=\"text-4xl font-serif font-light\">{Math.round(progress)}%</span>\n            <span className=\"text-[8px] uppercase tracking-[0.2em] text-[#535458] mt-1\">Organizado</span>\n          </div>\n        </div>\n        \n        <div className=\"flex gap-2\">\n          {steps.map((_, idx) => (\n            <button\n              key={idx}\n              onClick={() => setActiveStep(idx)}\n              className={cn(\n                \"w-2.5 h-2.5 rounded-full transition-all duration-300\",\n                idx === activeStep \n                  ? \"bg-[#D8B36B] scale-125\" \n                  : idx < activeStep \n                    ? \"bg-[#D8B36B]/40 cursor-pointer\" \n                    : \"bg-[#232A1B]/10 cursor-pointer hover:bg-[#232A1B]/20\"\n              )}\n              aria-label={`Ir para passo ${idx + 1}`}\n            />\n          ))}\n        </div>\n      </div>\n\n      {/* Content Side */}\n      <div className=\"flex-1 w-full border-t md:border-t-0 md:border-l border-[#232A1B]/10 pt-10 md:pt-0 md:pl-12 min-h-[220px] flex flex-col justify-center\">\n        <div ref={contentRef}>\n          <div className=\"flex items-center gap-3 mb-4\">\n            <span className=\"flex items-center justify-center w-6 h-6 rounded-full bg-[#F7F6EE] border border-[#232A1B]/10 text-[10px] font-serif text-[#D8B36B]\">\n              {activeStep + 1}\n            </span>\n            <span className=\"text-[10px] uppercase tracking-[0.2em] font-light text-[#D8B36B]\">\n              Passo a Passo\n            </span>\n          </div>\n          <h3 className=\"text-2xl md:text-3xl font-serif uppercase tracking-widest font-light text-[#232A1B] mb-6\">\n            {steps[activeStep].title}\n          </h3>\n          <p className=\"text-sm font-light text-[#535458] leading-relaxed tracking-wide\">\n            {steps[activeStep].description}\n          </p>\n          \n          <button \n            onClick={() => setActiveStep(prev => Math.min(prev + 1, steps.length - 1))}\n            disabled={activeStep === steps.length - 1}\n            className={cn(\n              \"mt-8 flex items-center gap-2 text-xs uppercase tracking-[0.1em] transition-all duration-300\",\n              activeStep === steps.length - 1 \n                ? \"text-[#D8B36B] opacity-100 cursor-default\" \n                : \"text-[#232A1B] hover:text-[#D8B36B] hover:gap-4\"\n            )}\n          >\n            {activeStep === steps.length - 1 ? (\n              <>\n                <Check className=\"w-4 h-4\" /> Jornada Conclu\303\255da\n              </>\n            ) : (\n              <>\n                Avan\303\247ar Passo <ArrowRight className=\"w-4 h-4\" />\n              </>\n            )}\n          </button>\n        </div>\n      </div>\n\n    </div>\n  );\n}\n"
    }
