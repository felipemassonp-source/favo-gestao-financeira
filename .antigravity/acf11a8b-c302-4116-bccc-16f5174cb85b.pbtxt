    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "  return (\n    <div ref={container} className=\"w-full\">\n      {/* Hero Section */}\n      <section className=\"relative h-screen flex flex-col justify-center px-6 max-w-7xl mx-auto overflow-hidden\">\n        <div className=\"absolute top-[-100px] right-[-100px] w-[400px] h-[400px] bg-[#14362D] opacity-[0.03] rounded-full blur-3xl pointer-events-none\"></div>\n        <div className=\"absolute bottom-[-50px] left-[-50px] w-[300px] h-[300px] bg-[#D4AF37] opacity-[0.05] rounded-full blur-3xl pointer-events-none\"></div>\n        <h1 \n          ref={heroTextRef} \n          className=\"text-5xl md:text-7xl lg:text-8xl font-light tracking-tighter leading-[0.9] max-w-4xl font-serif italic relative z-10\"\n          style={{ perspective: \"1000px\" }}\n        >\n          <span className=\"block opacity-100\">Intelig\303\252ncia</span>\n          <span className=\"block text-[#D4AF37] font-bold not-italic font-sans\">Financeira</span>\n          <span className=\"block\">Sob Medida.</span>\n        </h1>\n        <p className=\"hero-sub mt-8 text-lg text-[#14362D]/70 max-w-2xl leading-relaxed relative z-10\">\n          Transformamos dados complexos em decis\303\265es estrat\303\251gicas para impulsionar a sa\303\272de financeira do seu neg\303\263cio com precis\303\243o e transpar\303\252ncia.\n        </p>\n        <div className=\"hero-cta mt-12 flex gap-4 relative z-10\">\n          <Link to=\"/consultoria\" className=\"px-6 py-3 rounded-full bg-[#14362D] text-white font-bold text-xs uppercase tracking-widest hover:bg-[#1B4332] transition-colors shadow-lg\">\n            Consultoria\n          </Link>\n        </div>\n      </section>\n\n      {/* Interactive Observer Data Section */}\n      <section className=\"h-screen w-full relative overflow-hidden flex items-center justify-center\">\n        <div className=\"absolute top-12 text-center w-full z-10 text-[#14362D]/70 uppercase tracking-widest text-xs font-bold\">\n          Deslize para Analisar\n        </div>\n        \n        <div ref={observerSectionRef} className=\"relative w-full max-w-5xl h-[60vh] mx-auto cursor-ns-resize\">\n          {/* Panel 1 */}\n          <div className=\"data-panel absolute inset-0 bg-white rounded-3xl p-12 border border-[#14362D1A] shadow-2xl flex flex-col justify-center opacity-100\">\n            <TrendingUp className=\"w-16 h-16 text-[#D4AF37] mb-6\" />\n            <h2 className=\"text-4xl font-bold mb-4\">An\303\241lise de Performance</h2>\n            <p className=\"text-lg text-[#14362D]/70\">Identificamos gargalos e oportunidades invis\303\255veis nos seus relat\303\263rios financeiros para maximizar a sua margem de lucro.</p>\n          </div>\n          {/* Panel 2 */}\n          <div className=\"data-panel absolute inset-0 bg-white rounded-3xl p-12 border border-[#14362D1A] shadow-2xl flex flex-col justify-center opacity-0\">\n            <ShieldCheck className=\"w-16 h-16 text-[#14362D] mb-6\" />\n            <h2 className=\"text-4xl font-bold mb-4\">Gest\303\243o de Riscos</h2>\n            <p className=\"text-lg text-[#14362D]/70\">Proteja o caixa da sua empresa com estrat\303\251gias preditivas e modelagem financeira de alta precis\303\243o contra oscila\303\247\303\265es do mercado.</p>\n          </div>\n          {/* Panel 3 */}\n          <div className=\"data-panel absolute inset-0 bg-white rounded-3xl p-12 border border-[#14362D1A] shadow-2xl flex flex-col justify-center opacity-0\">\n            <Target className=\"w-16 h-16 text-[#D4AF37] mb-6\" />\n            <h2 className=\"text-4xl font-bold mb-4\">Planejamento Estrat\303\251gico</h2>\n            <p className=\"text-lg text-[#14362D]/70\">Tra\303\247amos metas financeiras claras e vi\303\241veis, com acompanhamento de KPIs em tempo real para garantir o alcance dos seus objetivos.</p>\n          </div>\n        </div>\n      </section>\n\n      {/* Services Section with ScrollTrigger */}\n      <section className=\"py-32 px-6 max-w-7xl mx-auto border-t border-[#14362D1A]\">\n        <div className=\"mb-20\">\n          <div className=\"flex items-center gap-3 mb-4\">\n            <span className=\"h-[1px] w-12 bg-[#D4AF37]\"></span>\n            <span className=\"text-[10px] uppercase tracking-[0.3em] font-bold text-[#D4AF37]\">Nossa Expertise</span>\n          </div>\n          <h3 className=\"text-4xl md:text-5xl font-light tracking-tighter font-serif italic\">Solu\303\247\303\265es Corporativas</h3>\n        </div>\n        \n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n          <div className=\"service-card p-10 bg-white rounded-2xl border border-[#14362D1A] hover:border-[#D4AF37] transition-colors shadow-sm\">\n            <h4 className=\"text-xl font-bold mb-4\">BPO Financeiro</h4>\n            <p className=\"text-sm text-[#14362D]/70 leading-relaxed\">\n              Terceiriza\303\247\303\243o completa da gest\303\243o financeira. Foque no core business enquanto cuidamos do contas a pagar, receber, fluxo de caixa e concilia\303\247\303\243o banc\303\241ria.\n            </p>\n          </div>\n          <div className=\"service-card p-10 bg-white rounded-2xl border border-[#14362D1A] hover:border-[#D4AF37] transition-colors shadow-sm\">\n            <h4 className=\"text-xl font-bold mb-4\">Valuation</h4>\n            <p className=\"text-sm text-[#14362D]/70 leading-relaxed\">\n              Avalia\303\247\303\243o precisa do valor de mercado da sua empresa para fus\303\265es, aquisi\303\247\303\265es, capta\303\247\303\243o de recursos ou planejamento sucess\303\263rio.\n            </p>\n          </div>\n          <div className=\"service-card p-10 bg-white rounded-2xl border border-[#14362D1A] hover:border-[#D4AF37] transition-colors shadow-sm\">\n            <h4 className=\"text-xl font-bold mb-4\">Reestrutura\303\247\303\243o</h4>\n            <p className=\"text-sm text-[#14362D]/70 leading-relaxed\">\n              Planos de recupera\303\247\303\243o financeira e renegocia\303\247\303\243o de passivos. Trazemos f\303\264lego para empresas em momentos de transi\303\247\303\243o ou crise.\n            </p>\n          </div>\n          <div className=\"service-card p-10 bg-white rounded-2xl border border-[#14362D1A] hover:border-[#D4AF37] transition-colors shadow-sm\">\n            <h4 className=\"text-xl font-bold mb-4\">M&A (Fus\303\265es e Aquisi\303\247\303\265es)</h4>\n            <p className=\"text-sm text-[#14362D]/70 leading-relaxed\">\n              Assessoria ponta a ponta na compra e venda de empresas. Do mapeamento de mercado ao fechamento estrat\303\251gico da opera\303\247\303\243o.\n            </p>\n          </div>\n        </div>\n      </section>\n    </div>\n  );"
      replacement_content: "  return (\n    <div ref={container} className=\"w-full\">\n      {/* Hero Section */}\n      <section className=\"relative h-screen flex flex-col justify-center px-6 max-w-7xl mx-auto overflow-hidden\">\n        <div className=\"absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-zinc-900/40 via-[#050505] to-[#050505] -z-10\"></div>\n        \n        <div className=\"flex items-center gap-4 mb-8 relative z-10\">\n          <span className=\"h-[1px] w-12 bg-[#B89C72]\"></span>\n          <span className=\"text-[10px] uppercase tracking-[0.3em] font-light text-[#B89C72]\">Vis\303\243o & Patrim\303\264nio</span>\n        </div>\n\n        <h1 \n          ref={heroTextRef} \n          className=\"text-6xl md:text-8xl lg:text-9xl font-light tracking-tight leading-[0.85] max-w-5xl font-serif relative z-10 uppercase\"\n          style={{ perspective: \"1000px\" }}\n        >\n          <span className=\"block opacity-100\">Intelig\303\252ncia</span>\n          <span className=\"block text-[#B89C72] italic lowercase font-serif mt-2 mb-2\">financeira</span>\n          <span className=\"block\">Sob Medida.</span>\n        </h1>\n        <p className=\"hero-sub mt-12 text-sm md:text-base text-[#E5E5E5]/50 max-w-xl leading-relaxed relative z-10 font-light tracking-wide\">\n          Transformamos dados complexos em decis\303\265es estrat\303\251gicas para impulsionar a sa\303\272de financeira do seu neg\303\263cio com precis\303\243o e transpar\303\252ncia absoluta.\n        </p>\n        <div className=\"hero-cta mt-16 flex gap-4 relative z-10\">\n          <Link to=\"/consultoria\" className=\"border border-white/20 px-10 py-4 text-[10px] uppercase tracking-[0.2em] hover:border-[#B89C72] hover:text-[#B89C72] transition-colors font-light rounded-full backdrop-blur-sm\">\n            Descubra a Consultoria\n          </Link>\n        </div>\n      </section>\n\n      {/* Interactive Observer Data Section */}\n      <section className=\"h-screen w-full relative overflow-hidden flex items-center justify-center bg-[#050505] border-t border-white/5\">\n        <div className=\"absolute top-12 text-center w-full z-10 text-[#E5E5E5]/30 uppercase tracking-[0.3em] text-[10px] font-light\">\n          Deslize para Analisar\n        </div>\n        \n        <div ref={observerSectionRef} className=\"relative w-full max-w-5xl h-[60vh] mx-auto cursor-ns-resize\">\n          {/* Panel 1 */}\n          <div className=\"data-panel absolute inset-0 bg-[#0A0A0A] p-16 border border-white/5 flex flex-col justify-center opacity-100 shadow-2xl\">\n            <span className=\"text-[#B89C72] text-[10px] uppercase tracking-[0.3em] mb-4\">01. Avalia\303\247\303\243o</span>\n            <h2 className=\"text-4xl md:text-5xl font-serif font-light mb-6 uppercase tracking-widest\">Performance</h2>\n            <p className=\"text-sm text-[#E5E5E5]/50 font-light leading-relaxed max-w-lg tracking-wide\">Identificamos gargalos e oportunidades invis\303\255veis nos seus relat\303\263rios financeiros para maximizar a sua margem de lucro com exatid\303\243o.</p>\n          </div>\n          {/* Panel 2 */}\n          <div className=\"data-panel absolute inset-0 bg-[#0A0A0A] p-16 border border-white/5 flex flex-col justify-center opacity-0 shadow-2xl\">\n            <span className=\"text-[#B89C72] text-[10px] uppercase tracking-[0.3em] mb-4\">02. Prote\303\247\303\243o</span>\n            <h2 className=\"text-4xl md:text-5xl font-serif font-light mb-6 uppercase tracking-widest\">Riscos</h2>\n            <p className=\"text-sm text-[#E5E5E5]/50 font-light leading-relaxed max-w-lg tracking-wide\">Proteja o caixa da sua empresa com estrat\303\251gias preditivas e modelagem financeira de alta precis\303\243o contra oscila\303\247\303\265es de mercado.</p>\n          </div>\n          {/* Panel 3 */}\n          <div className=\"data-panel absolute inset-0 bg-[#0A0A0A] p-16 border border-white/5 flex flex-col justify-center opacity-0 shadow-2xl\">\n            <span className=\"text-[#B89C72] text-[10px] uppercase tracking-[0.3em] mb-4\">03. Expans\303\243o</span>\n            <h2 className=\"text-4xl md:text-5xl font-serif font-light mb-6 uppercase tracking-widest\">Estrat\303\251gia</h2>\n            <p className=\"text-sm text-[#E5E5E5]/50 font-light leading-relaxed max-w-lg tracking-wide\">Tra\303\247amos metas financeiras claras e vi\303\241veis, com acompanhamento de KPIs em tempo real para garantir o alcance do seu legado.</p>\n          </div>\n        </div>\n      </section>\n\n      {/* Services Section with ScrollTrigger */}\n      <section className=\"py-40 px-6 max-w-7xl mx-auto border-t border-white/5\">\n        <div className=\"mb-24 flex flex-col md:flex-row md:items-end justify-between gap-8\">\n          <div>\n            <div className=\"flex items-center gap-4 mb-6\">\n              <span className=\"h-[1px] w-12 bg-[#B89C72]\"></span>\n              <span className=\"text-[10px] uppercase tracking-[0.3em] font-light text-[#B89C72]\">Nossa Expertise</span>\n            </div>\n            <h3 className=\"text-5xl md:text-7xl font-serif font-light tracking-widest uppercase\">Solu\303\247\303\265es<br/><span className=\"italic lowercase text-[#B89C72]\">Corporativas</span></h3>\n          </div>\n          <p className=\"text-[#E5E5E5]/50 font-light text-sm max-w-xs tracking-wide leading-relaxed\">\n            Metodologias de alto padr\303\243o desenhadas para preservar e multiplicar capital institucional.\n          </p>\n        </div>\n        \n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-px bg-white/5 border border-white/5\">\n          <div className=\"service-card p-16 bg-[#050505] hover:bg-[#0A0A0A] transition-colors group\">\n            <span className=\"text-[#B89C72] text-[10px] uppercase tracking-[0.2em] mb-8 block\">/ BPO</span>\n            <h4 className=\"text-2xl font-serif uppercase tracking-widest font-light mb-6 group-hover:text-[#B89C72] transition-colors\">BPO Financeiro</h4>\n            <p className=\"text-xs text-[#E5E5E5]/50 leading-relaxed font-light tracking-wide\">\n              Terceiriza\303\247\303\243o completa da gest\303\243o financeira. Foque no core business enquanto cuidamos do contas a pagar, receber, fluxo de caixa e concilia\303\247\303\243o banc\303\241ria.\n            </p>\n          </div>\n          <div className=\"service-card p-16 bg-[#050505] hover:bg-[#0A0A0A] transition-colors group\">\n            <span className=\"text-[#B89C72] text-[10px] uppercase tracking-[0.2em] mb-8 block\">/ Value</span>\n            <h4 className=\"text-2xl font-serif uppercase tracking-widest font-light mb-6 group-hover:text-[#B89C72] transition-colors\">Valuation</h4>\n            <p className=\"text-xs text-[#E5E5E5]/50 leading-relaxed font-light tracking-wide\">\n              Avalia\303\247\303\243o precisa do valor de mercado da sua empresa para fus\303\265es, aquisi\303\247\303\265es, capta\303\247\303\243o de recursos ou planejamento sucess\303\263rio.\n            </p>\n          </div>\n          <div className=\"service-card p-16 bg-[#050505] hover:bg-[#0A0A0A] transition-colors group\">\n            <span className=\"text-[#B89C72] text-[10px] uppercase tracking-[0.2em] mb-8 block\">/ Restructure</span>\n            <h4 className=\"text-2xl font-serif uppercase tracking-widest font-light mb-6 group-hover:text-[#B89C72] transition-colors\">Reestrutura\303\247\303\243o</h4>\n            <p className=\"text-xs text-[#E5E5E5]/50 leading-relaxed font-light tracking-wide\">\n              Planos de recupera\303\247\303\243o financeira e renegocia\303\247\303\243o de passivos. Trazemos f\303\264lego para empresas em momentos de transi\303\247\303\243o ou crise.\n            </p>\n          </div>\n          <div className=\"service-card p-16 bg-[#050505] hover:bg-[#0A0A0A] transition-colors group\">\n            <span className=\"text-[#B89C72] text-[10px] uppercase tracking-[0.2em] mb-8 block\">/ M&A</span>\n            <h4 className=\"text-2xl font-serif uppercase tracking-widest font-light mb-6 group-hover:text-[#B89C72] transition-colors\">M&A (Fus\303\265es)</h4>\n            <p className=\"text-xs text-[#E5E5E5]/50 leading-relaxed font-light tracking-wide\">\n              Assessoria ponta a ponta na compra e venda de empresas. Do mapeamento de mercado ao fechamento estrat\303\251gico da opera\303\247\303\243o.\n            </p>\n          </div>\n        </div>\n      </section>\n    </div>\n  );"
    }
