  file_change {
    absolute_path_uri: "file:///src/components/Testimonials.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useState, useRef } from \"react\";\nimport { ChevronLeft, ChevronRight, Quote } from \"lucide-react\";\nimport gsap from \"gsap\";\nimport { useGSAP } from \"@gsap/react\";\n\nconst testimonials = [\n  {\n    quote: \"Eu sempre misturava o dinheiro da cl\303\255nica com o da minha casa. A Andryelle me mostrou de forma t\303\243o simples como separar tudo. Hoje eu finalmente sei qual \303\251 o meu verdadeiro sal\303\241rio.\",\n    author: \"Dra. Mariana Costa\",\n    role: \"Cirurgi\303\243 Dentista\",\n    objection: \"Mistura de Contas\"\n  },\n  {\n    quote: \"Financeiro sempre foi grego pra mim. Tinha pavor de abrir o extrato. A did\303\241tica da Favo mudou minha vis\303\243o, hoje tomo decis\303\265es baseadas em n\303\272meros reais, sem nenhum medo.\",\n    author: \"Roberto Almeida\",\n    role: \"Escrit\303\263rio de Arquitetura\",\n    objection: \"Medo dos N\303\272meros\"\n  },\n  {\n    quote: \"Trabalhava 12 horas por dia, mas n\303\243o via a cor do dinheiro. O BPO financeiro tirou um peso enorme das minhas costas. Voltei a focar nos meus projetos com tranquilidade.\",\n    author: \"Camila Freitas\",\n    role: \"Designer de Interiores\",\n    objection: \"Falta de Tempo\"\n  }\n];\n\nexport default function Testimonials() {\n  const [currentIndex, setCurrentIndex] = useState(0);\n  const trackRef = useRef<HTMLDivElement>(null);\n\n  const next = () => {\n    setCurrentIndex((prev) => (prev + 1) % testimonials.length);\n  };\n\n  const prev = () => {\n    setCurrentIndex((prev) => (prev - 1 + testimonials.length) % testimonials.length);\n  };\n\n  useGSAP(() => {\n    gsap.to(trackRef.current, {\n      xPercent: -100 * currentIndex,\n      duration: 1.2,\n      ease: \"power4.inOut\",\n    });\n  }, [currentIndex]);\n\n  return (\n    <section className=\"py-40 px-6 max-w-7xl mx-auto border-t border-[#232A1B]/10 overflow-hidden\">\n      <div className=\"flex flex-col md:flex-row md:items-end justify-between gap-8 mb-24\">\n        <div>\n          <div className=\"flex items-center gap-4 mb-6\">\n            <span className=\"h-[1px] w-12 bg-[#D8B36B]\"></span>\n            <span className=\"text-[10px] uppercase tracking-[0.3em] font-light text-[#D8B36B]\">Casos de Sucesso</span>\n          </div>\n          <h3 className=\"section-title text-5xl md:text-7xl font-serif font-light tracking-widest uppercase\">\n            Hist\303\263rias<br /><span className=\"italic lowercase text-[#D8B36B]\">Reais</span>\n          </h3>\n        </div>\n        <p className=\"text-[#535458] font-light text-sm max-w-xs tracking-wide leading-relaxed\">\n          Resultados pr\303\241ticos de quem decidiu descomplicar a gest\303\243o e focar no que realmente importa.\n        </p>\n      </div>\n\n      <div className=\"bg-[#FFFFFF] border border-[#232A1B]/10 p-12 md:p-20 shadow-xl relative\">\n        <Quote strokeWidth={0.5} className=\"w-32 h-32 text-[#F7F6EE] absolute top-12 left-12 z-0\" />\n        \n        <div className=\"overflow-hidden w-full relative z-10\">\n          <div ref={trackRef} className=\"flex w-full items-center\">\n            {testimonials.map((t, i) => (\n              <div key={i} className=\"min-w-full flex-shrink-0 flex flex-col md:flex-row gap-12 md:gap-24 items-center\">\n                <div className=\"flex-1\">\n                  <p className=\"text-2xl md:text-4xl font-serif font-light leading-relaxed text-[#232A1B]\">\n                    \"{t.quote}\"\n                  </p>\n                </div>\n                <div className=\"w-full md:w-1/3 flex flex-col gap-6 border-l border-[#232A1B]/10 pl-8\">\n                  <div>\n                    <span className=\"text-[10px] uppercase tracking-[0.2em] font-light text-[#D8B36B] block mb-2\">\n                      Problema Resolvido\n                    </span>\n                    <span className=\"inline-block px-4 py-2 bg-[#F7F6EE] border border-[#232A1B]/5 text-xs text-[#535458] font-light tracking-wider rounded-full\">\n                      {t.objection}\n                    </span>\n                  </div>\n                  <div className=\"mt-4\">\n                    <h4 className=\"text-lg font-serif uppercase tracking-widest text-[#232A1B]\">{t.author}</h4>\n                    <span className=\"text-xs font-light tracking-wide text-[#535458]\">{t.role}</span>\n                  </div>\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n\n        <div className=\"flex items-center gap-4 mt-16 md:mt-24 justify-end relative z-10\">\n          <button \n            onClick={prev} \n            className=\"w-14 h-14 rounded-full border border-[#232A1B]/20 flex items-center justify-center hover:border-[#D8B36B] hover:text-[#D8B36B] transition-colors text-[#232A1B]\"\n            aria-label=\"Depoimento Anterior\"\n          >\n            <ChevronLeft strokeWidth={1} className=\"w-6 h-6\" />\n          </button>\n          <button \n            onClick={next} \n            className=\"w-14 h-14 rounded-full border border-[#232A1B]/20 flex items-center justify-center hover:border-[#D8B36B] hover:text-[#D8B36B] transition-colors text-[#232A1B]\"\n            aria-label=\"Pr\303\263ximo Depoimento\"\n          >\n            <ChevronRight strokeWidth={1} className=\"w-6 h-6\" />\n          </button>\n        </div>\n      </div>\n    </section>\n  );\n}\n"
    }
