      replacement_content: "  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    \n    // Formata a mensagem para o WhatsApp com os dados coletados\n    const phone = \"5551999999999\"; // Substitua pelo n\303\272mero real da Favo / Andryelle\n    \n    let text = `Ol\303\241! Vim pelo site e tenho interesse na *${type === \'bpo\' ? \'Gest\303\243o Financeira (BPO)\' : \'Consultoria Financeira\'}*.\\n\\n`;\n    text += `*Meus Dados:*\\n`;\n    text += `- Nome: ${formData.nome}\\n`;\n    text += `- Empresa: ${formData.empresa}\\n`;\n    text += `- E-mail: ${formData.email}\\n\\n`;\n    \n    if (type === \'bpo\') {\n      text += `*Meu Cen\303\241rio:*\\n`;\n      text += `- Dificuldade: ${formData.dorPrincipal}\\n`;\n      text += `- Volume mensal: ${formData.volumeOuControle}\\n`;\n    } else {\n      text += `*Meu Cen\303\241rio:*\\n`;\n      text += `- Objetivo: ${formData.dorPrincipal}\\n`;\n      text += `- Faturamento: ${formData.volumeOuControle}\\n`;\n    }\n    \n    const encodedText = encodeURIComponent(text);\n    const whatsappUrl = `https://wa.me/${phone}?text=${encodedText}`;\n    \n    // Abre o WhatsApp em uma nova aba\n    window.open(whatsappUrl, \'_blank\');\n    \n    // Avan\303\247a para a tela de sucesso\n    setStep(3);\n  };"
    }
    instruction: "Implementar redirecionamento para o WhatsApp ao enviar o formul\303\241rio, com uma mensagem formatada contendo todas as respostas do lead."
  }
}
