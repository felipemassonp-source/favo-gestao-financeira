  file_change {
    absolute_path_uri: "file:///src/components/FinancialBenefits.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useRef } from \"react\";\nimport gsap from \"gsap\";\nimport { ScrollTrigger } from \"gsap/ScrollTrigger\";\nimport { useGSAP } from \"@gsap/react\";\nimport { Layers, Clock, ShieldCheck, Target, Users, Coffee } from \"lucide-react\";\n\ngsap.registerPlugin(ScrollTrigger);\n\nconst benefits = [\n  {\n    title: \"Organiza\303\247\303\243o Eficiente\",\n    desc: \"Mantenha seu neg\303\263cio organizado, sem se preocupar com a burocracia e os detalhes financeiros complicados.\",\n    icon: Layers\n  },\n  {\n    title: \"Economia de Tempo e Recursos\",\n    desc: \"Evite custos desnecess\303\241rios com funcion\303\241rios, treinamento e despesas administrativas, economize tempo e recursos valiosos.\",\n    icon: Clock\n  },\n  {\n    title: \"Redu\303\247\303\243o de Inadimpl\303\252ncia\",\n    desc: \"Minimize os riscos de inadimpl\303\252ncia e perda de receita, garantindo que todos os compromissos financeiros sejam honrados pontualmente.\",\n    icon: ShieldCheck\n  },\n  {\n    title: \"Vis\303\243o Estrat\303\251gica\",\n    desc: \"Tenha uma vis\303\243o clara das melhores oportunidades de crescimento para o seu neg\303\263cio, tomando decis\303\265es mais assertivas.\",\n    icon: Target\n  },\n  {\n    title: \"Apoio Especializado\",\n    desc: \"Conte com a expertise de uma equipe dedicada e experiente para orienta\303\247\303\243o personalizada e suporte cont\303\255nuo em todas as suas necessidades rotineiras.\",\n    icon: Users\n  },\n  {\n    title: \"Liberdade Financeira\",\n    desc: \"Ganhe mais liberdade para focar no que realmente importa para o seu neg\303\263cio, enquanto n\303\263s cuidamos do dia a dia do seu financeiro.\",\n    icon: Coffee\n  }\n];\n\nexport default function FinancialBenefits() {\n  const containerRef = useRef<HTMLDivElement>(null);\n\n  useGSAP(() => {\n    const cards = gsap.utils.toArray(\'.benefit-card\');\n    gsap.from(cards, {\n      scrollTrigger: {\n        trigger: containerRef.current,\n        start: \"top 85%\",\n      },\n      opacity: 0,\n      y: 40,\n      duration: 1,\n      stagger: 0.15,\n      ease: \"power3.out\"\n    });\n  }, { scope: containerRef });\n\n  return (\n    <section ref={containerRef} className=\"py-24 border-t border-[#232A1B]/10\">\n      <div className=\"flex items-center gap-4 mb-6\">\n        <span className=\"h-[1px] w-12 bg-[#D8B36B]\"></span>\n        <span className=\"text-[10px] uppercase tracking-[0.3em] font-light text-[#D8B36B]\">Os Benef\303\255cios reais</span>\n      </div>\n      \n      <h2 className=\"text-4xl md:text-5xl font-serif font-light uppercase tracking-widest text-[#232A1B] mb-16\">\n        Muito al\303\251m de <br/><span className=\"italic lowercase text-[#D8B36B]\">pagar contas</span>\n      </h2>\n\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-12 gap-y-16\">\n        {benefits.map((item, idx) => (\n          <div key={idx} className=\"benefit-card flex flex-col group\">\n            <div className=\"w-14 h-14 mb-6 rounded-full bg-[#FFFFFF] border border-[#232A1B]/10 flex items-center justify-center group-hover:border-[#D8B36B] transition-colors shadow-sm\">\n              <item.icon strokeWidth={1.5} className=\"w-6 h-6 text-[#D8B36B] group-hover:scale-110 transition-transform\" />\n            </div>\n            <h3 className=\"text-lg font-serif uppercase tracking-widest text-[#232A1B] mb-3\">{item.title}</h3>\n            <p className=\"text-sm text-[#535458] font-light leading-relaxed tracking-wide\">{item.desc}</p>\n          </div>\n        ))}\n      </div>\n    </section>\n  );\n}\n"
    }
