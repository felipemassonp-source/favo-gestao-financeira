    <div className={`w-12 h-12 rounded-full flex items-center justify-center mb-6 shadow-md ${isPain ? \'bg-[#fffff0] border border-[#472f5b]/10 text-[#472f5b]/60\' : \'bg-[#472f5b] text-[#D8B36B]\'}`}>                        <step.icon className=\"w-5 h-5\" />                      </div>                                            <h3 className=\"text-xl md:text-2xl font-serif text-[#472f5b] mb-4 leading-tight\">{step.title}</h3>                      <p className=\"text-sm font-light text-[#2a3a1e] leading-relaxed tracking-wide\">                        {step.desc}                      </p>                    </div>                    {/* Connecting Dot (Mobile positioned left/right, Desktop centered) */}                    <div className={`absolute top-1/2 -translate-y-1/2 w-10 h-10 flex items-center justify-center ${isLeft ? \'-right-5 md:-right-16 md:translate-x-1/2\' : \'-left-5 md:-left-16 md:-translate-x-1/2\'}`}>                      <div className={`journey-dot relative z-20 w-4 h-4 rounded-full shadow-[0_0_20px_rgba(216,179,107,0.9)] ${isPain ? \'bg-[#472f5b]/50\' : \'bg-[#D8B36B]\'}`}></div>                      {/* Pulse Ring */}                      <div className={`absolute z-10 w-10 h-10 rounded-full border border-dashed animate-[spin_5s_linear_infinite] ${isPain ? \'border-[#472f5b]/20\' : \'border-[#D8B36B]/60\'}`}></div>                    </div>                  </div>                </div>              );            })}          </div>        </div>      </div>    </section>  );}"
