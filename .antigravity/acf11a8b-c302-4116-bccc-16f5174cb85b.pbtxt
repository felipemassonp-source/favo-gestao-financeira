      <Header />      <main className=\"flex-1 w-full overflow-hidden\">        {/* AnimatePresence for Barba.js style page transitions */}        <AnimatePresence mode=\"wait\" onExitComplete={() => {          if (!window.location.hash) {            window.scrollTo(0, 0);          }        }}>          <motion.div            key={location.pathname}            initial={{ opacity: 0, y: 20 }}            animate={{ opacity: 1, y: 0 }}            exit={{ opacity: 0, y: -20 }}            transition={{ duration: 0.6, ease: [0.22, 1, 0.36, 1] }}          >            {children}          </motion.div>        </AnimatePresence>      </main>      <InstagramFeed />      <Footer />    </div>  );}"
    }
