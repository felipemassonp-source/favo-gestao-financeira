    exit_code: 0
    wait_ms_before_async: 500
    combined_output {
      full: "import React, { useRef } from \'react\';import { useGSAP } from \'@gsap/react\';import gsap from \'gsap\';import { ScrollTrigger } from \'gsap/ScrollTrigger\';import { FileSpreadsheet, AlertTriangle, Lightbulb, TrendingUp } from \'lucide-react\';gsap.registerPlugin(ScrollTrigger);export default function OrganicJourney() {  const containerRef = useRef<HTMLDivElement>(null);  const pathRef = useRef<SVGPathElement>(null);  useGSAP(() => {    if (!pathRef.current || !containerRef.current) return;    const path = pathRef.current;    const length = path.getTotalLength();    // Set initial state for drawing the line    gsap.set(path, { strokeDasharray: length, strokeDashoffset: length });    // Animate the line drawing based on scroll    gsap.to(path, {      strokeDashoffset: 0,      ease: \"none\",      scrollTrigger: {        trigger: containerRef.current,        start: \"top 60%\", // Starts drawing when section is 60% down the viewport        end: \"bottom 80%\", // Finishes drawing near the bottom        scrub: 1.5, // Buttery smooth scrubbing      }    });    // Reveal the cards organically    gsap.utils.toArray(\'.journey-card\').forEach((card: any, i) => {      gsap.from(card, {        y: 60,        opacity: 0,        rotation: i % 2 === 0 ? -2 : 2,        duration: 1.2,        ease: \"power3.out\",        scrollTrigger: {          trigger: card,          start: \"top 85%\",          toggleActions: \"play none none reverse\"        }      });    });    // Animate glowing nodes on the path    gsap.utils.toArray(\'.journey-dot\').forEach((dot: any) => {      gsap.from(dot, {        scale: 0,        opacity: 0,        duration: 0.8,        ease: \"back.out(2)\",        scrollTrigger: {          trigger: dot,          start: \"top 70%\",          toggleActions: \"play none none reverse\"        }      });    });  }, { scope: containerRef });  const steps = [    {      id: 1,      type: \"pain\",      title: \"O Caos Di\303\241rio\",      desc: \"Contas f\303\255sicas misturadas com as da empresa, planilhas quebradas e o sentimento constante de que o dinheiro \'sumiu\' no fim do m\303\252s.\",      icon: FileSpreadsheet,      align: \"left\"    },    {      id: 2,      type: \"pain\",      title: \"A Sobrecarga\",      desc: \"Voc\303\252 passa o fim de semana lan\303\247ando notas, apagando inc\303\252ndios com bancos e perdendo dinheiro por esquecer prazos de boletos.\",      icon: AlertTriangle,      align: \"right\"    },    {      id: 3,      type: \"solution\",      title: \"A Interven\303\247\303\243o Favo\",      desc: \"N\303\263s assumimos a trincheira. Mapeamos seu financeiro, limpamos os processos manuais e assumimos 100% da burocracia banc\303\241ria.\",      icon: Lightbulb,      align: \"left\"    },    {      id: 4,      type: \"solution\",      title: \"Paz e Lucratividade\",      desc: \"Dashboard visual e preciso na sua m\303\243o. Voc\303\252 volta a dormir em paz e recupera o seu tempo para focar naquilo que traz dinheiro: vendas.\",      icon: TrendingUp,      align: \"right\"    }  ];  return (    <section ref={containerRef} className=\"py-32 bg-[#fffff0] relative overflow-hidden border-t border-[#472f5b]/10\">      <div className=\"max-w-7xl mx-auto px-6 relative z-10\">        <div className=\"text-center max-w-3xl mx-auto mb-20 md:mb-32\">          <span className=\"text-[#866428] text-[10px] uppercase tracking-[0.3em] mb-6 block font-medium\">A Jornada</span>          <h2 className=\"text-3xl md:text-5xl font-serif font-light text-[#472f5b] mb-6 tracking-wide\">            Como conectamos o seu caos <br className=\"hidden md:block\"/>            \303\240 <span className=\"italic text-[#866428]\">nossa clareza.</span>          </h2>        </div>        <div className=\"relative max-w-5xl mx-auto\">                    {/* Central Organic SVG Line */}          <div className=\"absolute inset-0 flex justify-center pointer-events-none\">            <svg              viewBox=\"0 0 100 100\"              preserveAspectRatio=\"none\"              className=\"w-full md:w-[200px] h-full overflow-visible\"            >              {/* Faded Background Trace */}              <path                d=\"M 50 0 Q 75 12.5, 50 25 T 50 50 T 50 75 T 50 100\"                stroke=\"#866428\"                strokeOpacity=\"0.1\"                strokeWidth=\"1\"                fill=\"none\"                vectorEffect=\"non-scaling-stroke\"                strokeLinecap=\"round\"              />              {/* Animated Golden Thread */}              <path                ref={pathRef}                d=\"M 50 0 Q 75 12.5, 50 25 T 50 50 T 50 75 T 50 100\"                stroke=\"#D8B36B\"                strokeWidth=\"3\"                fill=\"none\"                vectorEffect=\"non-scaling-stroke\"                strokeLinecap=\"round\"                className=\"drop-shadow-[0_0_12px_rgba(216,179,107,0.7)]\"              />            </svg>          </div>          {/* Steps Layout */}          <div className=\"flex flex-col justify-between relative z-10\" style={{ minHeight: \'800px\' }}>            {steps.map((step, index) => {              const isLeft = step.align === \'left\';              const isPain = step.type === \'pain\';              return (                <div                  key={step.id}                  className={`flex items-center w-full my-12 md:my-0 ${                    isLeft ? \'justify-start\' : \'justify-end\'                  }`}                >                  <div className={`w-full md:w-5/12 relative ${isLeft ? \'pr-8 md:pr-16\' : \'pl-8 md:pl-16\'}`}>                                        {/* The Card */}                    <div className={`journey-card relative bg-[#FFFFFF] p-8 md:p-10 shadow-[0_10px_40px_-15px_rgba(0,0,0,0.1)] border-l-4 ${isPain ? \'border-[#472f5b]/40\' : \'border-[#866428]\'}`}>                                            <div className={`w-12 h-12 rounded-full flex items-center justify-center mb-6 shadow-md ${isPain ? \'bg-[#fffff0] border border-[#472f5b]/10 text-[#472f5b]/60\' : \'bg-[#472f5b] text-[#D8B36B]\'}`}>                        <step.icon className=\"w-5 h-5\" />                      </div>                                            <h3 className=\"text-xl md:text-2xl font-serif text-[#472f5b] mb-4 leading-tight\">{step.title}</h3>                      <p className=\"text-sm font-light text-[#2a3a1e] leading-relaxed tracking-wide\">                        {step.desc}                      </p>                    </div>                    {/* Connecting Dot (Mobile positioned left/right, Desktop centered) */}                    <div className={`absolute top-1/2 -translate-y-1/2 w-10 h-10 flex items-center justify-center ${isLeft ? \'-right-5 md:-right-16 md:translate-x-1/2\' : \'-left-5 md:-left-16 md:-translate-x-1/2\'}`}>                      <div className={`journey-dot relative z-20 w-4 h-4 rounded-full shadow-[0_0_20px_rgba(216,179,107,0.9)] ${isPain ? \'bg-[#472f5b]/50\' : \'bg-[#D8B36B]\'}`}></div>                      {/* Pulse Ring */}                      <div className={`absolute z-10 w-10 h-10 rounded-full border border-dashed animate-[spin_5s_linear_infinite] ${isPain ? \'border-[#472f5b]/20\' : \'border-[#D8B36B]/60\'}`}></div>                    </div>                  </div>                </div>              );            })}          </div>        </div>      </div>    </section>  );}"
    }
