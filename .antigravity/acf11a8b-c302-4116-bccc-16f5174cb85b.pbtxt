    replacement_chunks {
      target_content: "    // 2. ScrollTrigger for services section cards\n    const serviceCards = gsap.utils.toArray(\'.service-card\');\n    serviceCards.forEach((card: any, i) => {\n      gsap.from(card, {\n        scrollTrigger: {\n          trigger: card,\n          start: \"top 85%\",\n          toggleActions: \"play none none reverse\",\n        },\n        opacity: 0,\n        y: 40,\n        duration: 1.2,\n        ease: \"power3.out\",\n        delay: i * 0.15,\n      });\n    });"
      replacement_content: "    // 2. ScrollTrigger for services section cards\n    const serviceCards = gsap.utils.toArray(\'.service-card\');\n    serviceCards.forEach((card: any, i) => {\n      const title = card.querySelector(\'.service-title\');\n      let splitChars: HTMLElement[] = [];\n      \n      if (title) {\n        const splitTitle = new SplitType(title, { types: \'chars\' });\n        splitChars = splitTitle.chars || [];\n      }\n\n      const tl = gsap.timeline({\n        scrollTrigger: {\n          trigger: card,\n          start: \"top 85%\",\n          toggleActions: \"play none none reverse\",\n        },\n        delay: i * 0.1\n      });\n\n      tl.from(card, {\n        opacity: 0,\n        y: 40,\n        duration: 1.2,\n        ease: \"power3.out\",\n      });\n\n      if (splitChars.length > 0) {\n        tl.from(splitChars, {\n          opacity: 0,\n          y: 20,\n          stagger: 0.04,\n          duration: 0.8,\n          ease: \"power4.out\"\n        }, \"-=0.8\");\n      }\n    });"
    }
    replacement_chunks {
      target_content: "        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-px bg-[#232A1B]/10 border border-[#232A1B]/10\">\n          <div className=\"service-card p-16 bg-[#FFFFFF] hover:bg-[#FDFCFB] transition-colors group\">\n            <span className=\"text-[#D8B36B] text-[10px] uppercase tracking-[0.2em] mb-8 block\">/ BPO</span>\n            <h4 className=\"text-2xl font-serif uppercase tracking-widest font-light mb-6 group-hover:text-[#D8B36B] transition-colors text-[#232A1B]\">BPO Financeiro</h4>\n            <p className=\"text-xs text-[#535458] leading-relaxed font-light tracking-wide\">\n              Terceiriza\303\247\303\243o completa da gest\303\243o financeira. Foque no core business enquanto cuidamos do contas a pagar, receber, fluxo de caixa e concilia\303\247\303\243o banc\303\241ria.\n            </p>\n          </div>\n          <div className=\"service-card p-16 bg-[#FFFFFF] hover:bg-[#FDFCFB] transition-colors group\">\n            <span className=\"text-[#D8B36B] text-[10px] uppercase tracking-[0.2em] mb-8 block\">/ Value</span>\n            <h4 className=\"text-2xl font-serif uppercase tracking-widest font-light mb-6 group-hover:text-[#D8B36B] transition-colors text-[#232A1B]\">Valuation</h4>\n            <p className=\"text-xs text-[#535458] leading-relaxed font-light tracking-wide\">\n              Avalia\303\247\303\243o precisa do valor de mercado da sua empresa para fus\303\265es, aquisi\303\247\303\265es, capta\303\247\303\243o de recursos ou planejamento sucess\303\263rio.\n            </p>\n          </div>\n          <div className=\"service-card p-16 bg-[#FFFFFF] hover:bg-[#FDFCFB] transition-colors group\">\n            <span className=\"text-[#D8B36B] text-[10px] uppercase tracking-[0.2em] mb-8 block\">/ Restructure</span>\n            <h4 className=\"text-2xl font-serif uppercase tracking-widest font-light mb-6 group-hover:text-[#D8B36B] transition-colors text-[#232A1B]\">Reestrutura\303\247\303\243o</h4>\n            <p className=\"text-xs text-[#535458] leading-relaxed font-light tracking-wide\">\n              Planos de recupera\303\247\303\243o financeira e renegocia\303\247\303\243o de passivos. Trazemos f\303\264lego para empresas em momentos de transi\303\247\303\243o ou crise.\n            </p>\n          </div>\n          <div className=\"service-card p-16 bg-[#FFFFFF] hover:bg-[#FDFCFB] transition-colors group\">\n            <span className=\"text-[#D8B36B] text-[10px] uppercase tracking-[0.2em] mb-8 block\">/ M&A</span>\n            <h4 className=\"text-2xl font-serif uppercase tracking-widest font-light mb-6 group-hover:text-[#D8B36B] transition-colors text-[#232A1B]\">M&A (Fus\303\265es)</h4>\n            <p className=\"text-xs text-[#535458] leading-relaxed font-light tracking-wide\">"
