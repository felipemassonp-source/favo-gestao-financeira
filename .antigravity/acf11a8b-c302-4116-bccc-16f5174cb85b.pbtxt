    blocking: true
    wait_ms_before_async: 2000
    command_line: "cat << \'EOF\' > update_testimonials.cjs\nconst fs = require(\'fs\');\n\nlet content = `import { useRef } from \"react\";\nimport gsap from \"gsap\";\nimport { ScrollTrigger } from \"gsap/ScrollTrigger\";\nimport { useGSAP } from \"@gsap/react\";\nimport { Star, Quote, TrendingUp } from \"lucide-react\";\n\ngsap.registerPlugin(ScrollTrigger);\n\nconst testimonials = [\n  {\n    author: \"Juliana Librelon\",\n    role: \"Propriet\303\241ria\",\n    company: \"Cl\303\255nica de Est\303\251tica\",\n    text: \"Andry, eu quero te abra\303\247ar! Eu n\303\243o t\303\264 acreditando que t\303\264 tirando essas f\303\251rias. J\303\241 t\303\264 at\303\251 programando a pr\303\263xima com as crian\303\247as. A tranquilidade de saber que o neg\303\263cio roda financeiramente sem mim n\303\243o tem pre\303\247o.\",\n    highlight: \"Ganhou tempo e liberdade\",\n    stars: 5\n  },\n  {\n    author: \"Brunella Freitas\",\n    role: \"CEO\",\n    company: \"Ag\303\252ncia de Marketing\",\n    text: \"A Andry \303\251 muito mais do que uma terceirizada. Cada solu\303\247\303\243o reflete o cuidado que ela dedica. Ela n\303\243o apenas entende nossas necessidades, mas nos ajuda a superar desafios de caixa. Pessoa de extrema confian\303\247a e compet\303\252ncia!\",\n    highlight: \"Previsibilidade de Caixa\",\n    stars: 5\n  },\n  {\n    author: \"Graziele Cardoso\",\n    role: \"S\303\263cia-Fundadora\",\n    company: \"Escrit\303\263rio de Advocacia\",\n    text: \"Eu s\303\263 sei as respostas exatas de quanto o escrit\303\263rio fatura e lucra porque tenho a melhor equipe cuidando disso para mim. Misturar conta de casa com a do escrit\303\263rio \303\251 coisa do passado.\",\n    highlight: \"Controle e Clareza (PF/PJ)\",\n    stars: 5\n  },\n  {\n    author: \"Luiza Martini\",\n    role: \"Diretora Criativa\",\n    company: \"Est\303\272dio de Design\",\n    text: \"Muito obrigada Andry, t\303\264 muito feliz que tu t\303\241 aqui com a gente. Ter previsibilidade pra saber quando podemos contratar e investir em equipamentos novos mudou completamente a nossa opera\303\247\303\243o.\",\n    highlight: \"Crescimento Estruturado\",\n    stars: 5\n  },\n  {\n    author: \"B. Dias\",\n    role: \"Fundadora\",\n    company: \"E-commerce\",\n    text: \"O suporte de voc\303\252s tem sido fundamental, voc\303\252s n\303\243o fazem ideia! O BPO tirou um peso enorme das minhas costas. Chega de pagar juros por esquecer vencimentos no meio da loucura das vendas.\",\n    highlight: \"Zero Atrasos e Multas\",\n    stars: 5\n  },\n  {\n    author: \"Gabriel Soares\",\n    role: \"Fundador\",\n    company: \"Startup de Tecnologia\",\n    text: \"Acho o m\303\241ximo que a Favo consegue nos dar essa visibilidade real dos n\303\272meros. N\303\243o sei o que seria da sa\303\272de financeira dessa empresa sem voc\303\252s. Obrigado por olharem estrategicamente pro nosso todo.\",\n    highlight: \"Vis\303\243o Estrat\303\251gica\",\n    stars: 5\n  }\n];\n\nexport default function Testimonials({ showPricing = false }: { showPricing?: boolean }) {\n  const containerRef = useRef<HTMLDivElement>(null);\n\n  useGSAP(() => {\n    const cards = gsap.utils.toArray(\'.testimonial-card\');\n    \n    gsap.from(cards, {\n      scrollTrigger: {\n        trigger: containerRef.current,\n        start: \"top 80%\",\n      },\n      opacity: 0,\n      y: 40,\n      duration: 1,\n      stagger: 0.1,\n      ease: \"power3.out\"\n    });\n  }, { scope: containerRef });\n\n  return (\n    <section ref={containerRef} className=\"py-32 border-t border-[#472f5b]/10 overflow-hidden bg-[#fffff0]\">\n      <div className=\"max-w-7xl mx-auto px-6\">\n        <div className=\"flex flex-col items-center text-center mb-20\">\n          <span className=\"text-[#866428] text-[10px] uppercase tracking-[0.3em] mb-6 block font-medium\">Casos Reais</span>\n          <h2 className=\"text-3xl md:text-5xl font-serif font-light tracking-wide text-[#472f5b]\">\n            Empres\303\241rios que voltaram a <br/><span className=\"italic text-[#866428]\">dormir tranquilos.</span>\n          </h2>\n        </div>\n\n        {/* Masonry Grid */}\n        <div className=\"columns-1 md:columns-2 lg:columns-3 gap-8 space-y-8\">\n          {testimonials.map((item, idx) => (\n            <div key={idx} className=\"testimonial-card break-inside-avoid bg-[#FFFFFF] border border-[#472f5b]/10 p-8 shadow-[0_4px_20px_-10px_rgba(0,0,0,0.05)] relative group hover:border-[#866428]/30 transition-colors duration-500\">\n              \n              {/* Highlight Badge */}\n              <div className=\"inline-flex items-center gap-2 bg-[#866428]/10 text-[#866428] px-3 py-1.5 rounded-full mb-6\">\n                <TrendingUp className=\"w-3.5 h-3.5\" />\n                <span className=\"text-[9px] uppercase tracking-widest font-semibold\">{item.highlight}</span>\n              </div>\n\n              <Quote className=\"w-8 h-8 text-[#866428]/20 absolute top-8 right-8\" />\n\n              <p className=\"text-[13px] text-[#2a3a1e] font-light leading-[1.8] tracking-wide mb-8\">\n                \"{item.text}\"\n              </p>\n              \n              <div className=\"flex flex-col gap-1 pt-6 border-t border-[#472f5b]/5\">\n                <div className=\"flex items-center justify-between mb-1\">\n                  <span className=\"text-sm font-serif text-[#472f5b]\">{item.author}</span>\n                  <div className=\"flex gap-1 shrink-0\">\n                    {[...Array(item.stars)].map((_, i) => (\n                      <Star key={i} className=\"w-3 h-3 text-[#D8B36B] fill-[#D8B36B]\" />\n                    ))}\n                  </div>\n                </div>\n                <span className=\"text-[10px] uppercase tracking-widest text-[#866428]\">{item.role}</span>\n                <span className=\"text-xs font-light text-[#2a3a1e]\">{item.company}</span>\n              </div>\n            </div>\n          ))}\n        </div>\n\n        {showPricing && (\n          <div className=\"mt-20 flex justify-center\">\n            <div className=\"inline-block bg-[#866428] text-[#fffff0] px-10 py-5 shadow-xl\">\n              <span className=\"text-sm tracking-widest uppercase font-light\">\n                Planos a partir de <strong className=\"font-semibold\">R$ 990,00</strong> / m\303\252s\n              </span>\n            </div>\n          </div>\n        )}\n      </div>\n    </section>\n  );\n}\n`\n\nfs.writeFileSync(\'./src/components/Testimonials.tsx\', content, \'utf8\');\nEOF\nnode update_testimonials.cjs\n"
    proposed_command_line: "cat << \'EOF\' > update_testimonials.cjs\nconst fs = require(\'fs\');\n\nlet content = `import { useRef } from \"react\";\nimport gsap from \"gsap\";\nimport { ScrollTrigger } from \"gsap/ScrollTrigger\";\nimport { useGSAP } from \"@gsap/react\";\nimport { Star, Quote, TrendingUp } from \"lucide-react\";\n\ngsap.registerPlugin(ScrollTrigger);\n\nconst testimonials = [\n  {\n    author: \"Juliana Librelon\",\n    role: \"Propriet\303\241ria\",\n    company: \"Cl\303\255nica de Est\303\251tica\",\n    text: \"Andry, eu quero te abra\303\247ar! Eu n\303\243o t\303\264 acreditando que t\303\264 tirando essas f\303\251rias. J\303\241 t\303\264 at\303\251 programando a pr\303\263xima com as crian\303\247as. A tranquilidade de saber que o neg\303\263cio roda financeiramente sem mim n\303\243o tem pre\303\247o.\",\n    highlight: \"Ganhou tempo e liberdade\",\n    stars: 5\n  },\n  {\n    author: \"Brunella Freitas\",\n    role: \"CEO\",\n    company: \"Ag\303\252ncia de Marketing\",\n    text: \"A Andry \303\251 muito mais do que uma terceirizada. Cada solu\303\247\303\243o reflete o cuidado que ela dedica. Ela n\303\243o apenas entende nossas necessidades, mas nos ajuda a superar desafios de caixa. Pessoa de extrema confian\303\247a e compet\303\252ncia!\",\n    highlight: \"Previsibilidade de Caixa\",\n    stars: 5\n  },\n  {\n    author: \"Graziele Cardoso\",\n    role: \"S\303\263cia-Fundadora\",\n    company: \"Escrit\303\263rio de Advocacia\",\n    text: \"Eu s\303\263 sei as respostas exatas de quanto o escrit\303\263rio fatura e lucra porque tenho a melhor equipe cuidando disso para mim. Misturar conta de casa com a do escrit\303\263rio \303\251 coisa do passado.\",\n    highlight: \"Controle e Clareza (PF/PJ)\",\n    stars: 5\n  },\n  {\n    author: \"Luiza Martini\",\n    role: \"Diretora Criativa\",\n    company: \"Est\303\272dio de Design\",\n    text: \"Muito obrigada Andry, t\303\264 muito feliz que tu t\303\241 aqui com a gente. Ter previsibilidade pra saber quando podemos contratar e investir em equipamentos novos mudou completamente a nossa opera\303\247\303\243o.\",\n    highlight: \"Crescimento Estruturado\",\n    stars: 5\n  },\n  {\n    author: \"B. Dias\",\n    role: \"Fundadora\",\n    company: \"E-commerce\",\n    text: \"O suporte de voc\303\252s tem sido fundamental, voc\303\252s n\303\243o fazem ideia! O BPO tirou um peso enorme das minhas costas. Chega de pagar juros por esquecer vencimentos no meio da loucura das vendas.\",\n    highlight: \"Zero Atrasos e Multas\",\n    stars: 5\n  },\n  {\n    author: \"Gabriel Soares\",\n    role: \"Fundador\",\n    company: \"Startup de Tecnologia\",\n    text: \"Acho o m\303\241ximo que a Favo consegue nos dar essa visibilidade real dos n\303\272meros. N\303\243o sei o que seria da sa\303\272de financeira dessa empresa sem voc\303\252s. Obrigado por olharem estrategicamente pro nosso todo.\",\n    highlight: \"Vis\303\243o Estrat\303\251gica\",\n    stars: 5\n  }\n];\n\nexport default function Testimonials({ showPricing = false }: { showPricing?: boolean }) {\n  const containerRef = useRef<HTMLDivElement>(null);\n\n  useGSAP(() => {\n    const cards = gsap.utils.toArray(\'.testimonial-card\');\n    \n    gsap.from(cards, {\n      scrollTrigger: {\n        trigger: containerRef.current,\n        start: \"top 80%\",\n      },\n      opacity: 0,\n      y: 40,\n      duration: 1,\n      stagger: 0.1,\n      ease: \"power3.out\"\n    });\n  }, { scope: containerRef });\n\n  return (\n    <section ref={containerRef} className=\"py-32 border-t border-[#472f5b]/10 overflow-hidden bg-[#fffff0]\">\n      <div className=\"max-w-7xl mx-auto px-6\">\n        <div className=\"flex flex-col items-center text-center mb-20\">\n          <span className=\"text-[#866428] text-[10px] uppercase tracking-[0.3em] mb-6 block font-medium\">Casos Reais</span>\n          <h2 className=\"text-3xl md:text-5xl font-serif font-light tracking-wide text-[#472f5b]\">\n            Empres\303\241rios que voltaram a <br/><span className=\"italic text-[#866428]\">dormir tranquilos.</span>\n          </h2>\n        </div>\n\n        {/* Masonry Grid */}\n        <div className=\"columns-1 md:columns-2 lg:columns-3 gap-8 space-y-8\">\n          {testimonials.map((item, idx) => (\n            <div key={idx} className=\"testimonial-card break-inside-avoid bg-[#FFFFFF] border border-[#472f5b]/10 p-8 shadow-[0_4px_20px_-10px_rgba(0,0,0,0.05)] relative group hover:border-[#866428]/30 transition-colors duration-500\">\n              \n              {/* Highlight Badge */}\n              <div className=\"inline-flex items-center gap-2 bg-[#866428]/10 text-[#866428] px-3 py-1.5 rounded-full mb-6\">\n                <TrendingUp className=\"w-3.5 h-3.5\" />\n                <span className=\"text-[9px] uppercase tracking-widest font-semibold\">{item.highlight}</span>\n              </div>\n\n              <Quote className=\"w-8 h-8 text-[#866428]/20 absolute top-8 right-8\" />\n\n              <p className=\"text-[13px] text-[#2a3a1e] font-light leading-[1.8] tracking-wide mb-8\">\n                \"{item.text}\"\n              </p>\n              \n              <div className=\"flex flex-col gap-1 pt-6 border-t border-[#472f5b]/5\">\n                <div className=\"flex items-center justify-between mb-1\">\n                  <span className=\"text-sm font-serif text-[#472f5b]\">{item.author}</span>\n                  <div className=\"flex gap-1 shrink-0\">\n                    {[...Array(item.stars)].map((_, i) => (\n                      <Star key={i} className=\"w-3 h-3 text-[#D8B36B] fill-[#D8B36B]\" />\n                    ))}\n                  </div>\n                </div>\n                <span className=\"text-[10px] uppercase tracking-widest text-[#866428]\">{item.role}</span>\n                <span className=\"text-xs font-light text-[#2a3a1e]\">{item.company}</span>\n              </div>\n            </div>\n          ))}\n        </div>\n\n        {showPricing && (\n          <div className=\"mt-20 flex justify-center\">\n            <div className=\"inline-block bg-[#866428] text-[#fffff0] px-10 py-5 shadow-xl\">\n              <span className=\"text-sm tracking-widest uppercase font-light\">\n                Planos a partir de <strong className=\"font-semibold\">R$ 990,00</strong> / m\303\252s\n              </span>\n            </div>\n          </div>\n        )}\n      </div>\n    </section>\n  );\n}\n`\n\nfs.writeFileSync(\'./src/components/Testimonials.tsx\', content, \'utf8\');\nEOF\nnode update_testimonials.cjs\n"
    shell_name: "bash"
  }
}
