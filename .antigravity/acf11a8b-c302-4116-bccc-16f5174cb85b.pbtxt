    combined_output {
      full: "import { useRef } from \"react\";import gsap from \"gsap\";import { ScrollTrigger } from \"gsap/ScrollTrigger\";import { useGSAP } from \"@gsap/react\";import { Star } from \"lucide-react\";gsap.registerPlugin(ScrollTrigger);const testimonials = [  {    author: \"B. Dias\",    text: \"O suporte de voc\303\252s tem sido fundamental pra mim meninas, voc\303\252s n\303\243o fazem ideia \360\237\244\215\",    stars: 5  },  {    author: \"alicebrabello\",    text: \"Recomendo, ela \303\251 muito top. Voc\303\252s n\303\243o v\303\243o se arrepender \360\237\231\214\",    stars: 5  },  {    author: \"Brunella Freitas da Rosa\",    text: \"A Andry \303\251 muito mais do que uma interface de comunica\303\247\303\243o. Cada palavra, cada resposta cuidadosa e cada solu\303\247\303\243o oferecida reflete o cuidado e a aten\303\247\303\243o que ela dedica. Ela n\303\243o apenas entende nossas necessidades, mas tamb\303\251m encontra maneira de nos ajudar e incentivar a superar os desafios. Ela \303\251 um verdadeiro presente encontrado em uma live, onde indicaram ela ! Pessoa de confian\303\247a, compet\303\252ncia e cora\303\247\303\243o!\",    stars: 5  },  {    author: \"B. Dias\",    text: \"Bom dia meninas! \342\234\250 Sou muito grata pelo apoio e trabalho que fizemos juntas ! Foi uma alegria esse tempo que tive o apoio de voc\303\252s e espero t\303\243o logo, conseguir voltar! Beijo grande no cora\303\247\303\243o de voc\303\252s \342\235\244\357\270\217\",    stars: 5  },  {    author: \"L. Martini\",    text: \"Muito obrigada Andry, n\303\243o sei se j\303\241 falei isso mas eu to muito feliz que tu t\303\241 aqui com a gente\",    stars: 5  },  {    author: \"G. Soares\",    text: \"N\303\243o sei o que seria dessa empresa sem voc\303\252 \342\235\244\357\270\217\",    stars: 5  },  {    author: \"Cliente Favo\",    text: \"Gente que demais!!! Acho o m\303\241ximo tbm que tu consegue nos dar essa visibilidade \360\237\245\263\360\237\245\263\360\237\245\263\360\237\231\217\360\237\231\217\360\237\231\217\360\237\231\217\360\237\231\217\360\237\231\217 obrigada por comunicar e olhar pro todo\",    stars: 5  },  {    author: \"J. Librelon\",    text: \"Andry, eu quero te abra\303\247ar / Obrigada por existir / Eu n\303\243o t\303\264 acreditando que t\303\264 tirando essas f\303\251rias / J\303\241 t\303\264 at\303\251 programando f\303\251rias com as crian\303\247as \342\235\244\357\270\217\",    stars: 5  },  {    author: \"graziele.cardosoadv\",    text: \"Eu s\303\263 sei as respostas porque tenho a melhor Assistente Financeiro cuidando disso para mim \342\235\244\357\270\217\",    stars: 5  }];export default function Testimonials({ showPricing = false }: { showPricing?: boolean }) {  const containerRef = useRef<HTMLDivElement>(null);  useGSAP(() => {    const cards = gsap.utils.toArray(\'.testimonial-card\');        gsap.from(cards, {      scrollTrigger: {        trigger: containerRef.current,        start: \"top 80%\",      },      opacity: 0,      y: 40,      duration: 1,      stagger: 0.1,      ease: \"power3.out\"    });  }, { scope: containerRef });  return (    <section ref={containerRef} className=\"py-32 border-t border-[#472f5b]/10 overflow-hidden bg-[#fffff0]\">      <div className=\"max-w-7xl mx-auto px-6\">        <div className=\"flex flex-col items-center text-center mb-16\">          <span className=\"text-[#b2893d] text-[10px] uppercase tracking-[0.3em] mb-6 block\">Depoimentos</span>          <h2 className=\"text-4xl md:text-5xl font-serif font-light uppercase tracking-widest text-[#472f5b]\">            O que os <span className=\"italic lowercase text-[#b2893d]\">clientes</span><br/> dizem sobre a Favo?          </h2>        </div>        {/* Masonry Grid */}        <div className=\"columns-1 md:columns-2 lg:columns-3 gap-6\">          {testimonials.map((item, idx) => (            <div key={idx} className=\"testimonial-card break-inside-avoid mb-6 bg-[#FFFFFF] border border-[#472f5b]/10 p-8 shadow-md transition-shadow\">              <p className=\"text-sm text-[#2a3a1e] font-light leading-relaxed tracking-wide mb-6\">                \"{item.text}\"              </p>                            <div className=\"flex flex-col gap-2 mt-auto pt-4 border-t border-[#472f5b]/5\">                <div className=\"flex items-center justify-between\">                  <span className=\"text-xs uppercase tracking-widest font-serif text-[#472f5b] truncate pr-4\">{item.author}</span>                  <div className=\"flex gap-1 shrink-0\">                    {[...Array(item.stars)].map((_, i) => (                      <Star key={i} className=\"w-3.5 h-3.5 text-[#b2893d] fill-[#D8B36B]\" />                    ))}                  </div>                </div>              </div>            </div>          ))}        </div>        {showPricing && (          <div className=\"mt-20 flex justify-center\">            <div className=\"inline-block bg-[#D8B36B]/20 border border-[#D8B36B]/50 px-10 py-5 rounded-sm shadow-sm\">              <span className=\"font-serif text-[#472f5b] text-lg md:text-xl tracking-wider uppercase font-light\">                Planos a partir de <strong className=\"font-medium\">R$990,00</strong> por m\303\252s              </span>            </div>          </div>        )}      </div>    </section>  );}"
    }
