      full: "import React, { useState } from \'react\';import { ChevronsLeftRight } from \'lucide-react\';export default function BeforeAfterReveal() {  const [sliderPosition, setSliderPosition] = useState(50);  return (    <section className=\"py-24 bg-[#fffff0] relative border-b border-[#472f5b]/10\">      <div className=\"max-w-7xl mx-auto px-6\">        <div className=\"text-center max-w-3xl mx-auto mb-16\">          <span className=\"text-[#866428] text-[10px] uppercase tracking-[0.3em] mb-6 block font-medium\">A Transforma\303\247\303\243o Favo</span>          <h2 className=\"text-3xl md:text-5xl font-serif font-light text-[#472f5b] mb-6 tracking-wide\">            Do Caos \303\240 <span className=\"italic text-[#866428]\">Previsibilidade.</span>          </h2>          <p className=\"text-sm font-normal text-[#2a3a1e] tracking-wide leading-relaxed\">            Arraste para o lado e veja a diferen\303\247a entre tentar controlar tudo em planilhas manuais e ter a Favo organizando o seu neg\303\263cio com dashboards visuais e limpos.          </p>        </div>        <div className=\"relative w-full max-w-5xl mx-auto aspect-[4/3] md:aspect-[21/9] bg-gray-200 shadow-2xl rounded-sm overflow-hidden group\">                    {/* BEFORE: Messy / Chaotic (Background) */}          <div className=\"absolute inset-0\">            {/* Dark overlay to make it look \"stressful\" */}            <div className=\"absolute inset-0 bg-[#472f5b]/20 mix-blend-multiply z-10 pointer-events-none\"></div>            <img               src=\"https://images.unsplash.com/photo-1554224155-8d04cb21cd6c?auto=format&fit=crop&q=80&w=1600\"               alt=\"Caos financeiro e planilhas\"              className=\"w-full h-full object-cover filter grayscale sepia-[0.3]\"              draggable=\"false\"            />            <div className=\"absolute top-6 right-6 z-20 bg-[#472f5b] text-[#fffff0] px-4 py-2 text-[10px] uppercase tracking-widest font-medium\">              Antes: O Caos            </div>          </div>          {/* AFTER: Clean Dashboard (Foreground, clipped) */}          <div             className=\"absolute inset-0 z-20 pointer-events-none bg-white\"            style={{ clipPath: `inset(0 ${100 - sliderPosition}% 0 0)` }}          >            <img               src=\"https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&q=80&w=1600\"               alt=\"Dashboard financeiro limpo\"              className=\"w-full h-full object-cover\"              draggable=\"false\"            />            <div className=\"absolute top-6 left-6 z-20 bg-[#866428] text-[#fffff0] px-4 py-2 text-[10px] uppercase tracking-widest font-medium shadow-lg\">              Depois: A Clareza            </div>          </div>          {/* Hidden Range Input for Interaction */}          <input             type=\"range\"             min=\"0\"             max=\"100\"             value={sliderPosition}             onChange={(e) => setSliderPosition(Number(e.target.value))}            className=\"absolute inset-0 w-full h-full opacity-0 cursor-ew-resize z-30\"            aria-label=\"Controle de antes e depois\"          />                    {/* Visible Slider Handle */}          <div             className=\"absolute top-0 bottom-0 w-0.5 bg-[#866428] z-20 pointer-events-none transition-transform duration-75\"            style={{ left: `${sliderPosition}%`, transform: \'translateX(-50%)\' }}          >            <div className=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-10 h-10 bg-[#fffff0] border-2 border-[#866428] rounded-full flex items-center justify-center shadow-[0_0_20px_rgba(0,0,0,0.3)]\">               <ChevronsLeftRight className=\"w-5 h-5 text-[#866428]\" />            </div>          </div>        </div>        <div className=\"text-center mt-12 flex items-center justify-center gap-2 text-xs font-light text-[#472f5b]/60 uppercase tracking-widest\">          <ChevronsLeftRight className=\"w-4 h-4\" /> Interaja com a imagem        </div>      </div>    </section>  );}"
