    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useRef } from \"react\";\nimport { X, Check } from \"lucide-react\";\nimport gsap from \"gsap\";\nimport { useGSAP } from \"@gsap/react\";\nimport { ScrollTrigger } from \"gsap/ScrollTrigger\";\n\ngsap.registerPlugin(ScrollTrigger);\n\nconst comparisons = [\n  {\n    pain: \"Pagamento de contas da empresa e de casa no mesmo cart\303\243o, gerando confus\303\243o total.\",\n    solution: \"Contas 100% separadas. Voc\303\252 passa a ter um \'sal\303\241rio\' (pr\303\263-labore) claro e previs\303\255vel.\"\n  },\n  {\n    pain: \"Falta de tempo para emitir notas, conciliar extratos e agendar o pagamento de boletos.\",\n    solution: \"Toda a burocracia terceirizada conosco. Sua \303\272nica tarefa financeira ser\303\241 aprovar os pagamentos.\"\n  },\n  {\n    pain: \"Dificuldade de entender planilhas complexas, relat\303\263rios frios e jarg\303\265es dif\303\255ceis.\",\n    solution: \"Reuni\303\265es amig\303\241veis com an\303\241lises visuais f\303\241ceis de ler. N\303\263s traduzimos os n\303\272meros para voc\303\252.\"\n  },\n  {\n    pain: \"Precifica\303\247\303\243o baseada na concorr\303\252ncia ou no \'achismo\', sem saber se h\303\241 lucro real.\",\n    solution: \"C\303\241lculo exato da sua margem de lucro. Voc\303\252 passa a cobrar o pre\303\247o justo com total seguran\303\247a.\"\n  }\n];\n\nexport default function ComparisonGrid() {\n  const containerRef = useRef<HTMLDivElement>(null);\n\n  useGSAP(() => {\n    const rows = gsap.utils.toArray(\'.comparison-row\');\n    \n    gsap.from(rows, {\n      scrollTrigger: {\n        trigger: containerRef.current,\n        start: \"top 80%\",\n      },\n      opacity: 0,\n      y: 30,\n      duration: 1,\n      stagger: 0.15,\n      ease: \"power3.out\"\n    });\n  }, { scope: containerRef });\n\n  return (\n    <section ref={containerRef} className=\"py-32 px-6 max-w-5xl mx-auto\">\n      <div className=\"text-center mb-20\">\n        <div className=\"flex items-center justify-center gap-4 mb-6\">\n          <span className=\"h-[1px] w-8 bg-[#D8B36B]\"></span>\n          <span className=\"text-[10px] uppercase tracking-[0.3em] font-light text-[#D8B36B]\">Antes & Depois</span>\n          <span className=\"h-[1px] w-8 bg-[#D8B36B]\"></span>\n        </div>\n        <h3 className=\"section-title text-4xl md:text-5xl font-serif font-light tracking-widest uppercase text-[#232A1B]\">\n          A Transforma\303\247\303\243o do seu <span className=\"italic lowercase text-[#D8B36B]\">Dia a Dia</span>\n        </h3>\n      </div>\n\n      <div className=\"flex flex-col border-t border-[#232A1B]/10\">\n        <div className=\"hidden md:grid grid-cols-2 gap-12 py-6 border-b border-[#232A1B]/10\">\n          <div className=\"text-[10px] uppercase tracking-[0.2em] font-light text-[#535458] pl-12\">Problema Comum</div>\n          <div className=\"text-[10px] uppercase tracking-[0.2em] font-light text-[#D8B36B] pl-12\">A Solu\303\247\303\243o Favo</div>\n        </div>\n\n        {comparisons.map((item, index) => (\n          <div \n            key={index} \n            className=\"comparison-row grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 py-10 border-b border-[#232A1B]/10 group hover:bg-[#FDFCFB] transition-colors -mx-6 px-6\"\n          >\n            {/* Pain Point */}\n            <div className=\"flex items-start gap-6 opacity-70 group-hover:opacity-100 transition-opacity\">\n              <div className=\"mt-1 flex-shrink-0 w-6 h-6 rounded-full border border-[#535458]/30 flex items-center justify-center bg-[#F7F6EE]\">\n                <X strokeWidth={1.5} className=\"w-3 h-3 text-[#535458]\" />\n              </div>\n              <p className=\"text-sm font-light text-[#535458] leading-relaxed tracking-wide\">\n                <span className=\"md:hidden text-[10px] uppercase tracking-[0.2em] font-light text-[#535458] block mb-2\">Problema</span>\n                {item.pain}\n              </p>\n            </div>\n\n            {/* Solution */}\n            <div className=\"flex items-start gap-6\">\n              <div className=\"mt-1 flex-shrink-0 w-6 h-6 rounded-full border border-[#D8B36B] flex items-center justify-center bg-[#D8B36B]/10\">\n                <Check strokeWidth={2} className=\"w-3 h-3 text-[#D8B36B]\" />\n              </div>\n              <p className=\"text-sm font-light text-[#232A1B] leading-relaxed tracking-wide\">\n                <span className=\"md:hidden text-[10px] uppercase tracking-[0.2em] font-light text-[#D8B36B] block mb-2\">Solu\303\247\303\243o Favo</span>\n                {item.solution}\n              </p>\n            </div>\n          </div>\n        ))}\n      </div>\n    </section>\n  );\n}\n"
    }
