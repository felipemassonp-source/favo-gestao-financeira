  file_change {
    absolute_path_uri: "file:///src/components/ImpactMetrics.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useRef, useState } from \"react\";\nimport gsap from \"gsap\";\nimport { ScrollTrigger } from \"gsap/ScrollTrigger\";\nimport { useGSAP } from \"@gsap/react\";\n\ngsap.registerPlugin(ScrollTrigger);\n\nconst metrics = [\n  { endValue: 50, prefix: \"+\", suffix: \"\", label: \"Empresas Atendidas\", desc: \"Neg\303\263cios rodando no piloto autom\303\241tico.\" },\n  { endValue: 2500, prefix: \"+\", suffix: \"h\", label: \"Horas Economizadas\", desc: \"Devolvidas aos nossos clientes por m\303\252s.\" },\n  { endValue: 100, prefix: \"\", suffix: \"%\", label: \"Processos Otimizados\", desc: \"Burocracia transformada em efici\303\252ncia pura.\" }\n];\n\nconst AnimatedNumber = ({ endValue, prefix, suffix }: { endValue: number, prefix: string, suffix: string }) => {\n  const [value, setValue] = useState(0);\n  const numberRef = useRef<HTMLSpanElement>(null);\n\n  useGSAP(() => {\n    const proxy = { val: 0 };\n    gsap.to(proxy, {\n      val: endValue,\n      duration: 2.5,\n      ease: \"power3.out\",\n      scrollTrigger: {\n        trigger: numberRef.current,\n        start: \"top 85%\",\n      },\n      onUpdate: () => setValue(Math.round(proxy.val))\n    });\n  }, { scope: numberRef });\n\n  return (\n    <span ref={numberRef} className=\"text-6xl md:text-7xl font-serif text-[#D8B36B] mb-6 block font-light\">\n      {prefix}{new Intl.NumberFormat(\'pt-BR\').format(value)}{suffix}\n    </span>\n  );\n};\n\nexport default function ImpactMetrics() {\n  const containerRef = useRef<HTMLDivElement>(null);\n\n  useGSAP(() => {\n    const items = gsap.utils.toArray(\'.metric-item\');\n    gsap.from(items, {\n      scrollTrigger: {\n        trigger: containerRef.current,\n        start: \"top 85%\",\n      },\n      opacity: 0,\n      y: 30,\n      duration: 1,\n      stagger: 0.2,\n      ease: \"power3.out\"\n    });\n  }, { scope: containerRef });\n\n  return (\n    <section ref={containerRef} className=\"py-24 border-t border-[#232A1B]/10\">\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-16 md:gap-8\">\n        {metrics.map((metric, i) => (\n          <div key={i} className=\"metric-item flex flex-col items-center text-center px-4\">\n            <AnimatedNumber endValue={metric.endValue} prefix={metric.prefix} suffix={metric.suffix} />\n            <span className=\"text-[10px] uppercase tracking-[0.2em] font-light text-[#232A1B] mb-4 block border-b border-[#D8B36B]/30 pb-4 w-12\">\n            </span>\n            <span className=\"text-sm font-serif uppercase tracking-widest text-[#232A1B] mb-3 block\">\n              {metric.label}\n            </span>\n            <p className=\"text-xs text-[#535458] font-light tracking-wide leading-relaxed max-w-[220px]\">\n              {metric.desc}\n            </p>\n          </div>\n        ))}\n      </div>\n    </section>\n  );\n}"
    }
