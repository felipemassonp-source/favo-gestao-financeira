      replacement_content: "import { useState, useEffect } from \"react\";\nimport { Link, useLocation } from \"react-router-dom\";\nimport { cn } from \"../lib/utils\";\nimport MagneticButton from \"./MagneticButton\";\nimport Logo from \"./Logo\";\nimport { Menu, X } from \"lucide-react\";\nimport { AnimatePresence, motion } from \"motion/react\";\n\nexport default function Header() {\n  const location = useLocation();\n  const [isMobileMenuOpen, setIsMobileMenuOpen] = useState(false);\n\n  // Close menu when route changes\n  useEffect(() => {\n    setIsMobileMenuOpen(false);\n  }, [location.pathname]);"
    }
    replacement_chunks {
      target_content: "        </nav>\n      </div>\n    </header>"
      replacement_content: "        </nav>\n\n        {/* Mobile Menu Toggle */}\n        <button \n          className=\"md:hidden text-[#472f5b] hover:text-[#D8B36B] transition-colors focus:outline-none p-2\"\n          onClick={() => setIsMobileMenuOpen(!isMobileMenuOpen)}\n        >\n          {isMobileMenuOpen ? <X className=\"w-6 h-6\" /> : <Menu className=\"w-6 h-6\" />}\n        </button>\n      </div>\n\n      {/* Mobile Navigation Panel */}\n      <AnimatePresence>\n        {isMobileMenuOpen && (\n          <motion.div\n            initial={{ opacity: 0, height: 0 }}\n            animate={{ opacity: 1, height: \"calc(100vh - 6rem)\" }}\n            exit={{ opacity: 0, height: 0 }}\n            transition={{ duration: 0.4, ease: [0.22, 1, 0.36, 1] }}\n            className=\"md:hidden absolute top-24 left-0 w-full bg-[#fffff0]/95 backdrop-blur-md border-t border-[#472f5b]/10 overflow-hidden flex flex-col items-center pt-12 gap-8 z-40\"\n          >\n            {links.map((link) => (\n              <Link\n                key={link.path}\n                to={link.path}\n                className={cn(\n                  \"text-xs uppercase tracking-[0.2em] transition-colors duration-300 font-light\",\n                  location.pathname === link.path ? \"text-[#D8B36B]\" : \"text-[#472f5b]\"\n                )}\n              >\n                {link.name}\n              </Link>\n            ))}\n            <a\n              href=\"#contato\"\n              onClick={() => setIsMobileMenuOpen(false)}\n              className=\"mt-8 border border-[#472f5b]/20 text-[#472f5b] bg-[#fffff0] px-10 py-4 text-[10px] font-light uppercase tracking-[0.2em] rounded-full hover:border-[#D8B36B] hover:text-[#D8B36B] transition-colors shadow-sm\"\n            >\n              Fale Conosco\n            </a>\n          </motion.div>\n        )}\n      </AnimatePresence>\n    </header>"
